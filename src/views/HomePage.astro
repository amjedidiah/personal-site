---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import '../styles/motion.css';
import CurrentWork from '../components/CurrentWork.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';
import { getCurrent } from '../data/current';
import { getProfile } from '../data/profile';
import { getExternalPosts, getPosts } from '../lib/blog';
import { imagePlaceholders } from '../data/image-placeholders';
import { pickHomeFeaturedArticles } from '../lib/home-featured-articles';
import { coverThumbnail } from '../lib/cover-paths';
import { experienceClients, experienceWork } from '../data/experience-clients';
import { getProjects } from '../lib/projects';
import { intlLocale, localePath, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { serviceNode } from '../lib/structured-data';
import Testimonials from '../components/Testimonials.astro';
import { clientTestimonials } from '../data/testimonials';
import { ArrowRight, ArrowUpRight, CreditCard, MonitorSmartphone, Smartphone, Sparkles } from '@lucide/astro';
import { capabilities } from '../data/capabilities';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = t.home;
const current = getCurrent(locale);
const profile = getProfile(locale);
const href = (path: string) => localePath(locale, path);

const projects = (await getProjects(locale))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const caseStudyIds = ['cocktail-book-club', 'gwela'];
const caseStudies = caseStudyIds
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is (typeof projects)[number] => p !== undefined);
const otherFeatured = projects.filter((p) => !caseStudyIds.includes(p.id));

const featuredArticles = pickHomeFeaturedArticles(await getPosts(locale), await getExternalPosts(locale), 2)
  .map((article) => (article.external ? article : { ...article, href: href(article.href) }));

const caseFocus = home.caseFocus;
const capabilityIcons = { 'monitor-smartphone': MonitorSmartphone, smartphone: Smartphone, 'credit-card': CreditCard, sparkles: Sparkles };

const projectInquirySubject = home.inquirySubject;
const projectInquiryMessage = home.inquiryMessage;
const projectInquiryEmail = `mailto:imunacode@gmail.com?subject=${encodeURIComponent(projectInquirySubject)}&body=${encodeURIComponent(projectInquiryMessage)}`;
const projectInquiryWhatsApp = `https://wa.me/2348165972229?text=${encodeURIComponent(projectInquiryMessage)}`;

---

<Base
  title={profile.homeTitle}
  description={profile.description}
  fullBleed
  structuredData={Astro.site ? [serviceNode(Astro.site, locale)] : []}
>
  <!-- The availability status is fetched from GitHub as the page loads. -->
  <link slot="head" rel="preconnect" href="https://api.github.com" crossorigin="anonymous" />
  <!-- HERO -->
  <section class="hero hero-frame" aria-labelledby="hero-title">
    <div class="hero-frame-inner">
      <p class="hero-name">Jedidiah Amaraegbu</p>
      <p class="hero-tag">{profile.roles}</p>
      <h1 id="hero-title"><span>{home.heroTitle[0]}</span>{' '}<span>{home.heroTitle[1]}</span>{' '}<span class="hero-title-emphasis">{home.heroTitle[2]}</span></h1>
    </div>
    <HeroScene />
    <div class="hero-copy">
      <p class="hero-lede">{profile.delivery} {current.appReview}</p>
      <div class="hero-actions">
        <a
          class="btn-primary hero-contact"
          href={projectInquiryEmail}
          data-contact-primary
          data-email-href={projectInquiryEmail}
          data-whatsapp-href={projectInquiryWhatsApp}
        >
          {home.discuss}
        </a>
        <a class="btn-ghost" href={href('/projects/gwela')}>{home.exploreGwela}</a>
      </div>
    </div>
  </section>

  <!-- WHERE I'VE WORKED: a quick credibility read before the detail below. -->
  <section class="logo-strip" aria-labelledby="logo-strip-title">
    <div class="constrained logo-strip-inner">
      <h2 id="logo-strip-title" class="logo-strip-label">{home.logoStrip}</h2>
      <ul class="logo-strip-list">
        {experienceClients.map((c) => (
          <li>
            <img
              class:list={[
                'experience-logo',
                c.logoShape === 'wordmark' && 'experience-logo--wordmark',
                c.logoShape === 'mark' && 'experience-logo--mark',
                c.logoShape === 'gdg' && 'experience-logo--gdg',
              ]}
              src={c.logo}
              alt={c.name ? '' : c.logoAlt}
              width="112"
              height="28"
              decoding="async"
            />
            <span>{c.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WHAT I BUILD: what someone can hire for, in plain words, with proof. -->
  <section class="build-section home-band" aria-labelledby="build-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="build-title">{home.sections.build}</h2>
      </div>
      <ul class="build-grid">
        {capabilities.map((capability) => {
          const Icon = capabilityIcons[capability.icon];
          return (
            <li class="build-card">
              <Icon class="build-icon" size={22} strokeWidth={1.7} aria-hidden="true" />
              <h3>{capability.title[locale]}</h3>
              <p>{capability.summary[locale]}</p>
              <p class="build-proof">
                <span>{home.seenIn}</span>{' '}
                {capability.proof.map((item, index) => (
                  <>{index > 0 && <span aria-hidden="true"> · </span>}<a href={href(item.path)}>{item.label[locale]}</a></>
                ))}
              </p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 01 — NOW -->
  <section class="now-section" data-nav-surface="surface" aria-labelledby="now-title" data-home-current>
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="now-title">{home.sections.now}</h2>
      </div>
      <div class="now-panel">
        <div class="now-primary">
          <CurrentWork class="now-lede" />
        </div>
        <div class="current-signals" data-current-signals>
          <article class="current-signal" id="current-availability" aria-busy="false">
            <span class="signal-label">{home.availability}</span>
            <strong class="availability" data-current-availability data-available="true"><span class="availability-dot" aria-hidden="true"></span><span data-current-availability-label>{current.availability}</span></strong>
            <span class="signal-detail" data-current-availability-detail>{current.availabilityDetail}</span>
          </article>
        </div>
      </div>
      <div class="current-toolbar">
        <p class="current-reviewed" data-current-status role="status" aria-atomic="true">{home.statusReviewed} <time datetime={current.reviewedAt}>{new Date(`${current.reviewedAt}T00:00:00Z`).toLocaleDateString(intlLocale[locale], { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time></p>
        <button class="current-refresh" type="button" data-current-refresh aria-controls="current-availability" hidden>{home.refreshStatus}</button>
      </div>
    </div>
  </section>

  <!-- 02 — FEATURED WORK -->
  <section class="work-section home-band" aria-labelledby="work-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="work-title">{home.sections.work}</h2>
      </div>
      <div class="featured-work">
        {caseStudies.map((p) => (
          <article class="featured-card">
            {/* A real screenshot when there is one; the concept diagram otherwise. */}
            {p.data.image ? (
              <a href={href(`/projects/${p.id}`)} class="featured-card-media" aria-label={home.readCaseStudy(p.data.title)}>
                <div class="case-image">
                  <ProgressiveImage src={p.data.image} alt={p.data.imageAlt ?? p.data.title} placeholder={imagePlaceholders[p.id]} sizes="(max-width: 900px) calc(100vw - 2rem), 50vw" />
                </div>
              </a>
            ) : <ProjectDiagram projectId={p.id} />}
            <div class="featured-card-body">
              <h3 class="featured-title"><a href={href(`/projects/${p.id}`)}>{p.data.title}</a></h3>
              {caseFocus[p.id] && <p class="featured-focus">{caseFocus[p.id]}</p>}
              <p class="featured-description">{p.data.description}</p>
              <dl class="featured-facts">
                {p.data.role && <div><dt>{home.role}</dt><dd>{p.data.role}</dd></div>}
                {p.data.evidence && <div><dt>{home.proof}</dt><dd>{p.data.evidence}</dd></div>}
              </dl>
              <div class="featured-actions">
                <a href={href(`/projects/${p.id}`)}>{home.caseStudy}<span class="visually-hidden">: {p.data.title}</span> <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" /></a>
                {p.data.url && (
                  <a href={p.data.url} target="_blank" rel="noopener noreferrer">
                    {p.data.urlLabel ?? home.viewProject}<span class="visually-hidden">: {p.data.title}{t.meta.newTab}</span> <ArrowUpRight size={14} strokeWidth={1.8} aria-hidden="true" />
                  </a>
                )}
                {p.data.urlSecondary && (
                  <a href={p.data.urlSecondary} target="_blank" rel="noopener noreferrer">
                    {p.data.urlSecondaryLabel ?? home.viewProject}<span class="visually-hidden">: {p.data.title}{t.meta.newTab}</span> <ArrowUpRight size={14} strokeWidth={1.8} aria-hidden="true" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      {caseStudies.length === 0 && <p class="home-empty">{home.noCaseStudies}</p>}
      {otherFeatured.length > 0 && <p class="other-work">{home.alsoBuilt} {otherFeatured.map((p, index) => <span>{index > 0 && ', '}<a href={href(`/projects/${p.id}`)}>{p.data.title}</a></span>)}</p>}
      <a href={href('/projects')} class="see-all">{home.allProjects} <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
  </section>

  <!-- FEATURED ARTICLES (after featured work) -->
  <section class="writing-section home-band" aria-labelledby="writing-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="writing-title">{home.sections.writing}</h2>
      </div>
      <!-- Described, not named, so "opens in a new tab" stays out of the headings. -->
      <span id="writing-new-tab" hidden>{t.meta.newTab.trim().replace(/^\((.*)\)$/, '$1')}</span>
      <div class="featured-writing">
        {featuredArticles.map((article) => (
          <article class="writing-card">
            <div class="writing-card-media" aria-hidden="true">
              <img {...coverThumbnail(locale, article.slug)} sizes="(max-width: 900px) calc(100vw - 2rem), 36rem" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="writing-card-body">
              <header class="writing-card-head">
                <time datetime={article.date.toISOString().slice(0, 10)} class="writing-date">
                  {article.date.toLocaleDateString(intlLocale[locale], { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
                </time>
                <p class="writing-focus">
                  {article.external ? t.blog.externalSource : (article.focus ?? home.onSite)}
                </p>
              </header>
              <h3 class="writing-title" lang={article.lang}>
                <a
                  href={article.href}
                  {...(article.external ? { target: '_blank', rel: 'noopener noreferrer', 'aria-describedby': 'writing-new-tab' } : {})}
                >
                  {article.title}
                </a>
              </h3>
              {article.description && <p class="writing-description" lang={article.lang}>{article.description}</p>}
              <div class="writing-actions">
                <a
                  href={article.href}
                  {...(article.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {home.readArticle}
                  <span class="visually-hidden">: <span lang={article.lang}>{article.title}</span>{article.external ? t.meta.newTab : ''}</span>
                  {article.external ? <ArrowUpRight size={14} strokeWidth={1.8} aria-hidden="true" /> : <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" />}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {featuredArticles.length === 0 && <p class="home-empty">{home.noArticles}</p>}
      <a href={href('/blog')} class="see-all">{home.allPosts} <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
  </section>

  <!-- 03 — EXPERIENCE -->
  <section class="clients-section home-band" data-nav-surface="surface" aria-labelledby="experience-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="experience-title">{home.sections.experience}</h2>
      </div>
      <p class="experience-summary">{home.experienceSummary(profile.yearsExperience, profile.developersMentored)}</p>
      <ul class="experience-grid">
        {experienceWork.map((c, index) => (
          <li>
            <a
              class="experience-card"
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              style={`--experience-entry: ${index * 15}%`}
            >
              <svg class="experience-connection" viewBox="0 0 160 24" fill="none" aria-hidden="true">
                <path class="experience-track" d="M0 12H160" />
                <path class="experience-ink" d="M0 12H160" pathLength="100" />
                <circle class="experience-node" cx="80" cy="12" r="4" />
              </svg>
              <img
                class:list={[
                  'experience-logo',
                  c.logoShape === 'wordmark' && 'experience-logo--wordmark',
                  c.logoShape === 'mark' && 'experience-logo--mark',
                  c.logoShape === 'gdg' && 'experience-logo--gdg',
                ]}
                src={c.logo}
                alt={c.name ? '' : c.logoAlt}
                width="112"
                height="28"
                loading="lazy"
                decoding="async"
              />
              <strong>{c.name}</strong>
              <span>{c.note[locale]}</span>
              <span class="visually-hidden">{t.meta.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RECOMMENDATIONS -->
  <section class="testimonials-section home-band" aria-labelledby="testimonials-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="testimonials-title">{t.testimonials.homeTitle}</h2>
      </div>
      <Testimonials items={clientTestimonials} />
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section home-band" data-nav-surface="surface" aria-labelledby="contact-title">
    <div class="constrained">
      <div class="section-label section-label--plain">
        <h2 id="contact-title">{home.sections.contact}</h2>
      </div>
      <div class="cta-band">
        <div class="cta-copy">
          <h3 class="cta-headline">{home.ctaHeadline}</h3>
          <p class="cta-proof">
            <span>{home.ctaProof[0]}</span>
            <span class="cta-proof-sep" aria-hidden="true">·</span>
            <span>{home.ctaProof[1]}</span>
            <span class="cta-proof-sep" aria-hidden="true">·</span>
            <span>{home.ctaProof[2]}</span>
          </p>
          <p class="cta-lede">{home.ctaLede}</p>
        </div>
        <div class="cta-actions">
          <svg class="contact-route" viewBox="0 0 248 64" fill="none" aria-hidden="true">
            <path class="contact-track" d="M12 8H100Q124 8 124 32V54M115 45L124 54L133 45" />
            <path class="contact-ink" d="M12 8H100Q124 8 124 32V54M115 45L124 54L133 45" pathLength="100" />
          </svg>
          <a
            class="btn-primary cta-contact"
            href={projectInquiryEmail}
            data-contact-primary
            data-email-href={projectInquiryEmail}
            data-whatsapp-href={projectInquiryWhatsApp}
            data-email-label={home.emailMe}
            data-whatsapp-label={home.whatsApp}
          >
            {home.emailMe}
          </a>
          <a class="cta-light" href={href('/feedback')}>{home.siteFeedback}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero, .now-section, .home-band {
    --home-muted: color-mix(in srgb, var(--dim) 80%, var(--fg));
  }
  .hero ::selection, .now-section ::selection, .home-band ::selection {
    background: var(--accent);
    color: var(--bg);
  }
  .hero-lede, .featured-description, .writing-description, .cta-lede { text-wrap: pretty; }
  .now-section, .home-band { overflow-wrap: anywhere; }
  .hero a, .home-band a, .now-section a, .current-refresh { touch-action: manipulation; }
  .hero a:hover, .home-band a:hover, .now-section a:hover { opacity: 1; }
  .hero a:focus-visible, .home-band a:focus-visible, .now-section a:focus-visible,
  .current-refresh:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .home-empty { color: var(--home-muted); font: 1rem/1.65 var(--font-sans); }
  /* hero */
  .hero {
    --hero-muted: color-mix(in srgb, var(--home-muted) 65%, var(--fg));
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 0;
    align-content: center;
    overflow: clip;
    min-height: min(76svh, 700px);
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .hero-frame-inner {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    min-width: 0;
    max-width: none;
    margin: 0;
  }
  .hero-copy { grid-column: 1; grid-row: 2; align-self: start; min-width: 0; }
  .hero-tag {
    color: var(--hero-muted); font: .78rem/1.6 var(--font-sans);
    max-width: 42ch;
    margin-bottom: 1.2rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .hero-name {
    color: var(--fg); font-family: var(--font-sans);
    font-size: .95rem; font-weight: 600;
    margin-bottom: .35rem;
  }
  .hero h1 {
    overflow-wrap: anywhere;
    font-size: clamp(2rem, 4.65vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -.035em;
    margin-bottom: 1.5rem;
    max-width: none;
  }
  .hero h1 > span { display: block; }
  .hero-title-emphasis { color: var(--accent); }
  .hero-lede {
    font-family: var(--font-sans);
    color: var(--hero-muted); font-size: 1rem;
    line-height: 1.7; max-width: 40ch;
    margin-bottom: 1.5rem; font-weight: 400;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  /* buttons */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--bg); background: var(--accent);
    padding: .65em 1.3em; border-radius: 2px;
    font-size: .8rem; font-weight: 600;
    transition: background-color 150ms ease, transform 100ms ease;
  }
  .btn-primary:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--accent) 85%, var(--fg)); color: var(--bg); opacity: 1; }
  .btn-primary:active, .btn-ghost:active { transform: translateY(1px); }
  .btn-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--fg); font-size: .8rem;
    padding: .65em 1.3em;
    border: 1px solid var(--home-muted); border-radius: 2px;
    transition: border-color 150ms ease, color 150ms ease, transform 100ms ease;
  }
  .btn-ghost:is(:hover, :focus-visible) { border-color: var(--accent); color: var(--accent); opacity: 1; }

  /* constrained */
  .constrained {
    max-width: var(--max-w); margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* now */
  .now-section {
    margin-bottom: 0;
    padding: clamp(2rem, 4.5vw, 2.85rem) 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .now-section .section-label--plain {
    margin-bottom: 1rem;
  }
  .now-section .section-label--plain::after {
    display: none;
  }
  .now-section .section-label--plain h2 {
    flex: none;
  }
  .section-label h2 {
    min-width: 0;
    max-width: 100%;
    color: var(--home-muted);
    font: 500 clamp(0.92rem, 1.55vw, 1.05rem)/1.35 var(--font-sans);
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .now-panel {
    view-timeline: --now-panel block;
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: stretch;
    padding-block: .35rem;
  }
  .now-primary {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .55rem;
    min-width: 0;
  }
  .now-primary :global(.now-lede) {
    margin: 0;
    max-width: 36ch;
    color: var(--fg);
    font: 500 clamp(1.08rem, 1.9vw, 1.32rem)/1.5 var(--font-sans);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .now-primary :global(.now-lede a) {
    color: inherit;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / var(--flow-position) .12em no-repeat;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--fg) 28%, transparent);
    text-underline-offset: .18em;
    transition: text-decoration-color .15s ease;
  }
  .now-primary :global(.now-lede a:hover) {
    text-decoration-color: color-mix(in srgb, var(--fg) 55%, transparent);
  }
  .current-signals {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .65rem;
    align-content: center;
    padding-left: clamp(1rem, 2.5vw, 1.75rem);
    border-left: 1px solid var(--border);
  }
  .current-signals::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 1px;
    background: var(--accent);
    pointer-events: none;
  }
  .current-signal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .45rem;
    min-width: 0;
  }
  .signal-label {
    font-size: .72rem;
    color: var(--home-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .current-signal strong {
    font: 600 clamp(.88rem, 1.4vw, .95rem)/1.4 var(--font-sans);
    color: var(--fg);
  }
  .availability { display: inline-flex; align-items: center; gap: .55rem; }
  .availability-dot {
    width: .48rem;
    height: .48rem;
    flex: none;
    border-radius: 50%;
    background: #2f9f69;
  }
  .availability[data-available="false"] .availability-dot {
    background: var(--home-muted);
  }
  .signal-detail {
    color: var(--home-muted);
    font-size: .78rem;
    line-height: 1.55;
  }
  .current-signal time,
  .current-reviewed {
    flex: 1 1 14rem;
    color: var(--home-muted);
    font-size: .75rem;
  }
  .current-reviewed {
    min-height: 1rem;
    max-width: 75ch;
    line-height: 1.6;
  }
  .current-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .25rem 1rem;
    margin-top: 1rem;
    min-height: 44px;
  }
  .current-refresh {
    flex-shrink: 0;
    min-height: 44px;
    padding: .5rem .25rem;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: 500 .8rem/1.4 var(--font-sans);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: .22em;
    text-decoration-color: transparent;
    transition: text-decoration-color 150ms ease, color 150ms ease;
  }
  .current-refresh[hidden] { display: none; }
  .current-refresh:is(:hover, :focus-visible) { text-decoration-color: currentColor; }
  .current-refresh[aria-disabled="true"] { color: var(--home-muted); cursor: wait; }
  .current-signals[data-state="loading"] .availability-dot { background: var(--home-muted); }
  .current-reviewed[data-state="error"], .current-reviewed[data-state="offline"] {
    color: var(--fg);
  }

  /* where I've worked */
  .logo-strip {
    padding: clamp(1rem, 2vw, 1.35rem) 0;
    border-block: 1px solid var(--border);
  }
  .logo-strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .85rem 2rem;
  }
  .logo-strip-label {
    flex: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--home-muted);
    font: 500 .68rem/1.4 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .logo-strip-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .logo-strip-list li {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--fg);
    font: 600 .82rem/1.2 var(--font-sans);
    white-space: nowrap;
  }
  .logo-strip .experience-logo { --experience-logo-height: 1.1rem; }
  @media (max-width: 639px) {
    .logo-strip {
      padding-top: .85rem;
      padding-bottom: .95rem;
    }
    .logo-strip-inner {
      flex-direction: column;
      align-items: stretch;
      gap: .6rem;
    }
    .logo-strip-label {
      width: 100%;
      line-height: 1.35;
    }
    .logo-strip-list {
      gap: .7rem 1.25rem;
    }
    .logo-strip-list li span:not(:empty) {
      font-size: .78rem;
    }
  }

  /* what I build */
  .build-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.875rem, 1.5vw, 1.25rem);
    margin: .25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .build-card {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: clamp(1.1rem, 2vw, 1.4rem);
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 30%, var(--bg));
  }
  .build-card :global(.build-icon) { color: var(--accent); }
  .build-card h3 {
    margin: .2rem 0 0;
    color: var(--fg);
    font: 600 1.02rem/1.3 var(--font-sans);
    letter-spacing: -.01em;
  }
  .build-card p {
    margin: 0;
    color: var(--home-muted);
    font-size: .88rem;
    line-height: 1.6;
  }
  .build-card .build-proof {
    margin-top: auto;
    padding-top: .35rem;
    font: .72rem/1.7 var(--font-mono);
  }
  .build-proof a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: .2em;
  }
  .build-proof a:is(:hover, :focus-visible) { text-decoration-color: currentColor; }
  @media (max-width: 1000px) {
    .build-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .build-grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* homepage bands — shared vertical rhythm (work had 6rem/4rem + section margin; trimmed) */
  .home-band {
    margin-bottom: 0;
    padding: clamp(2.75rem, 5vw, 3.75rem) 0;
  }
  .home-band .section-label--plain {
    margin-bottom: 1.25rem;
  }
  .home-band .section-label--plain::after {
    display: none;
  }
  .home-band .section-label--plain h2 {
    flex: none;
  }

  /* work */
  .featured-work, .featured-writing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(.875rem, 1.5vw, 1.25rem);
    margin-top: .25rem;
  }
  .featured-card, .writing-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 30%, var(--bg));
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .featured-card:is(:hover, :focus-within), .writing-card:is(:hover, :focus-within) {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--surface) 45%, var(--bg));
  }
  .featured-card-media {
    display: block;
    min-width: 0;
    border-bottom: 1px solid var(--border);
  }
  .featured-card-media .case-image {
    border: 0;
    border-radius: 6px 6px 0 0;
  }
  .featured-card-media .case-caption {
    padding: 0 1.1rem .75rem;
  }
  .writing-card-media {
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    border-bottom: 1px solid var(--border);
    border-radius: 6px 6px 0 0;
    background: var(--surface);
  }
  .writing-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .45s cubic-bezier(.2, .7, .2, 1);
  }
  .writing-card:is(:hover, :focus-within) .writing-card-media img { transform: scale(1.03); }
  .featured-card-body, .writing-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }
  .featured-focus {
    margin: 0 0 .85rem;
    color: var(--accent);
    font: 600 .68rem/1.35 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .case-image {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }
  .case-image :global(.progressive-image) {
    height: 100%;
    aspect-ratio: auto;
    background-size: cover;
    transform: scale(1);
    transition: transform .45s cubic-bezier(.2, .7, .2, 1);
  }
  .case-image :global(.progressive-image img) { object-fit: cover; }
  .featured-card-media:is(:hover, :focus-visible) .case-image :global(.progressive-image) {
    transform: scale(1.025);
  }
  .case-caption {
    display: block;
    margin-top: .5rem;
    color: var(--home-muted);
    font-size: .75rem;
    line-height: 1.45;
    font-family: var(--font-mono);
  }
  .featured-title {
    margin: 0 0 .65rem;
    font: 600 clamp(1.25rem, 2.2vw, 1.65rem)/1.15 var(--font-sans);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .featured-title a { color: inherit; }
  .featured-title a:is(:hover, :focus-visible) { color: var(--accent); }
  .featured-description {
    margin: 0;
    flex: 1;
    color: var(--home-muted);
    font: 400 .95rem/1.65 var(--font-sans);
  }
  .featured-facts {
    display: grid;
    gap: .65rem;
    margin: 1.15rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .featured-facts div {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: .5rem;
  }
  .featured-facts dt {
    color: var(--home-muted);
    font: 600 .68rem/1.4 var(--font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .featured-facts dd {
    margin: 0;
    color: var(--fg);
    font-size: .8rem;
    line-height: 1.5;
  }
  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem 1.25rem;
    margin-top: 1.1rem;
  }
  .featured-actions a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 44px;
    color: var(--accent);
    font: .8rem/1.4 var(--font-mono);
  }
  .featured-actions a:is(:hover, :focus-visible) { text-decoration: underline; text-underline-offset: .22em; }
  .featured-actions :global(svg), .writing-actions :global(svg), .see-all :global(svg) { flex-shrink: 0; }
  .other-work {
    margin-top: 1.4rem;
    color: var(--home-muted); font-size: .75rem;
  }
  .other-work a { color: var(--fg); }
  .other-work a:hover { color: var(--accent); }
  .see-all {
    display: inline-flex; align-items: center; gap: .35rem; min-height: 44px; margin-top: .75rem;
    font-size: .8rem; color: var(--accent);
  }
  .see-all:is(:hover, :focus-visible) { color: var(--accent); text-decoration: underline; text-underline-offset: .22em; }

  /* writing */
  .writing-section {
    border-top: 1px solid var(--border);
  }
  .writing-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: .85rem;
  }
  .writing-date {
    font: 600 .68rem/1.35 var(--font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--home-muted);
  }
  .writing-focus {
    margin: 0;
    text-align: right;
    color: var(--accent);
    font: 600 .68rem/1.35 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .writing-title {
    margin: 0 0 .55rem;
    font: 600 clamp(1.1rem, 2vw, 1.4rem)/1.2 var(--font-sans);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .writing-title a { color: inherit; }
  .writing-title a:is(:hover, :focus-visible) { color: var(--accent); }
  .writing-description {
    margin: 0;
    flex: 1;
    color: var(--home-muted);
    font: 400 .95rem/1.65 var(--font-sans);
  }
  .writing-actions {
    margin-top: 1rem;
  }
  .writing-actions a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 44px;
    color: var(--accent);
    font: .8rem/1.4 var(--font-mono);
  }
  .writing-actions a:is(:hover, :focus-visible) { text-decoration: underline; text-underline-offset: .22em; }

  @media (prefers-reduced-motion: reduce) {
    .case-image :global(.progressive-image) { transition: none; }
    .experience-card,
    .featured-card,
    .writing-card { transition: none; }
    .writing-card-media img { transition: none; }
  }

  /* recommendations */
  .testimonials-section {
    border-top: 1px solid var(--border);
  }

  /* experience */
  .clients-section {
    background: transparent;
    border-top: 1px solid var(--border);
    border-bottom: none;
  }
  .experience-summary {
    max-width: 50ch;
    margin: -0.35rem 0 1.5rem;
    color: var(--home-muted);
    font-family: var(--font-sans);
    font-size: .98rem;
    line-height: 1.65;
  }
  .experience-grid {
    view-timeline: --experience-grid block;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .6rem;
    align-items: stretch;
  }
  @media (min-width: 22rem) {
    .experience-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 48rem) {
    .experience-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 75rem) {
    .experience-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  .experience-grid > li {
    display: flex;
    min-width: 0;
  }
  .experience-card {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    flex: 1;
    width: 100%;
    min-height: 6.85rem;
    padding: .85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: color-mix(in srgb, var(--surface) 35%, var(--bg));
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .experience-connection { display: block; width: 100%; height: 1.5rem; margin-bottom: .4rem; overflow: visible; }
  .experience-connection path { stroke-width: 1.5; }
  .experience-track { stroke: var(--border); }
  .experience-ink { stroke: var(--accent); }
  .experience-node { stroke: var(--accent); stroke-width: 1.5; fill: var(--bg); transform-box: fill-box; transform-origin: center; }
  .experience-card:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--surface) 55%, var(--bg));
  }
  .experience-logo {
    --experience-logo-height: calc(2rem * 2 / 3);
    display: block;
    width: auto;
    height: var(--experience-logo-height);
    max-width: calc(8rem * 2 / 3);
    object-fit: contain;
    object-position: left center;
    opacity: .9;
    filter: brightness(0);
  }
  .experience-logo--wordmark {
    max-width: calc(9.5rem * 2 / 3);
  }
  .experience-logo--mark {
    max-width: var(--experience-logo-height);
  }
  /* GDG mark is wide; same row height as other logos (128×74 source) */
  .experience-logo--gdg {
    width: auto;
    max-width: calc(var(--experience-logo-height) * 128 / 74);
  }
  :root[data-theme="dark"] .experience-logo,
  :root:not([data-theme]) .experience-logo {
    filter: brightness(0) invert(1);
    opacity: .82;
  }
  :root[data-theme="light"] .experience-logo {
    opacity: .78;
  }
  .experience-card:is(:hover, :focus-visible) .experience-logo {
    opacity: 1;
  }
  .experience-card strong {
    font-family: var(--font-sans);
    font-size: .88rem;
    font-weight: 600;
    line-height: 1.35;
    min-height: calc(1.35em * 2);
    color: var(--fg);
  }
  .experience-card:is(:hover, :focus-visible) strong {
    color: var(--accent);
  }
  .experience-card span {
    margin-top: auto;
    font: .75rem/1.5 var(--font-mono);
    color: var(--home-muted);
  }

  /* cta — extra bottom air before footer; top matches other home bands */
  .cta-section {
    padding-block: clamp(2.75rem, 5vw, 3.75rem) clamp(3.25rem, 6.5vw, 4.5rem);
    border-top: 1px solid var(--border);
    background: radial-gradient(
      ellipse 100% 70% at 50% 100%,
      color-mix(in srgb, var(--surface) 55%, var(--bg)),
      var(--bg) 72%
    );
  }
  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12.5rem, auto);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .cta-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .55rem;
    margin: 0 0 1rem;
    font: 600 .68rem/1.4 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--home-muted);
  }
  .cta-headline {
    margin: 0 0 .85rem;
    max-width: 24ch;
    font: 600 clamp(1.2rem, 2.5vw, 1.75rem)/1.15 var(--font-sans);
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .cta-lede {
    margin: 0;
    max-width: 42ch;
    color: var(--home-muted);
    font: 400 .92rem/1.65 var(--font-sans);
  }
  .cta-actions {
    view-timeline: --contact-route block;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: .65rem;
    width: min(100%, 15.5rem);
  }
  .contact-route { display: block; width: 100%; height: 4rem; overflow: visible; }
  .contact-route path { stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .contact-track { stroke: var(--border); }
  .contact-ink { stroke: var(--accent); }

  /* These sections connect current work, professional contributions and the
     contact action. Nothing
     here is a status, loading bar or measure of professional experience. */
  @keyframes now-underline { from { --flow-position: 0%; } to { --flow-position: 100%; } }
  @keyframes now-divider { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  @keyframes now-divider-horizontal { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes experience-connect { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 100 0; } }
  @keyframes experience-node { from { transform: scale(.4); } to { transform: scale(1); } }
  @keyframes contact-connect { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 100 0; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (view-timeline: --now-panel block) and (animation-range: entry 0% cover 45%) {
      /* The var() fallbacks keep Astro's production optimizer from merging
         animation-timeline into an unsupported animation shorthand. */
      .now-primary {
        animation: var(--now-work-animation, now-underline linear both);
        animation-timeline: --now-panel;
        animation-range: entry 0% cover 35%;
      }
      .current-signals::before {
        animation: var(--now-divider-animation, now-divider linear both);
        animation-timeline: --now-panel;
        animation-range: entry 0% cover 35%;
      }
      .experience-ink, .experience-node {
        animation: var(--experience-animation, experience-connect linear both);
        animation-timeline: --experience-grid;
        animation-range: entry var(--experience-entry, 0%) cover 45%;
      }
      .experience-node { --experience-animation: experience-node linear both; }
      .contact-ink {
        animation: var(--contact-animation, contact-connect linear both);
        animation-timeline: --contact-route;
        /* Finish while fully entering: the footer limits further scrolling. */
        animation-range: entry 0% entry 100%;
      }
    }
  }
  @media (max-width: 900px) {
    .current-signals::before { inset: -1px 0 auto; width: auto; height: 1px; }
    .current-signals { --now-divider-animation: now-divider-horizontal linear both; }
  }
  @media (forced-colors: active) {
    .current-signals::before { background: CanvasText; }
    .experience-connection path, .experience-node, .contact-route path { stroke: CanvasText; }
    .experience-node { fill: Canvas; }
  }
  .cta-actions .btn-primary,
  .cta-actions .btn-ghost {
    width: 100%;
    text-align: center;
  }
  .cta-light {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font: .72rem/1.4 var(--font-mono);
    color: var(--home-muted);
    text-align: center;
  }
  .cta-light:hover {
    color: var(--accent);
    opacity: 1;
  }

  @media (min-width: 960px) {
    .hero-lede { font-size: 1.15rem; }
    .featured-title { font-size: 1.85rem; }
    .cta-headline { max-width: 26ch; }
  }

  @media (min-width: 1400px) {
    .hero-lede { font-size: 1.2rem; }
    .featured-title { font-size: 2rem; }
  }

  @media (max-width: 900px) {
    .now-panel { grid-template-columns: 1fr; }
    .current-signals { padding: 1rem 0 0; border-left: 0; border-top: 1px solid var(--border); }
    .featured-work,
    .featured-writing { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .cta-section .section-label--plain {
      justify-content: center;
      margin-bottom: clamp(1.1rem, 3.5vw, 1.35rem);
    }
    .cta-section .section-label--plain h2 {
      text-align: center;
    }
    .cta-band {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 6vw, 2.5rem);
      align-items: stretch;
      justify-items: center;
      text-align: center;
    }
    .cta-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .cta-proof {
      justify-content: center;
    }
    .cta-headline,
    .cta-lede {
      max-width: 36ch;
    }
    .cta-actions {
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
      align-items: stretch;
    }
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-height: 0;
      padding-block: 2.5rem 2rem;
    }
    .hero-frame-inner { align-self: start; }
    .hero-tag { margin-bottom: 1rem; }
    .hero h1 { font-size: clamp(2rem, 7.6vw, 3.5rem); margin-bottom: .5rem; }
    .hero-copy { grid-column: 1; grid-row: 3; margin-top: 1.75rem; }
    .hero-lede { max-width: 48ch; }
  }

  @media (max-width: 400px) {
    .hero { padding-bottom: 2.5rem; }
    .current-signals { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; align-items: stretch; gap: .65rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-ghost, .current-refresh { transition: none; }
    .btn-primary:active, .btn-ghost:active { transform: none; }
  }

  @media (max-width: 400px) and (max-height: 760px) {
    .hero { padding-top: 2rem; }
    .hero-tag { margin-bottom: .5rem; }
    .hero-lede { margin-bottom: 1rem; }
    .now-section { padding-top: 1.25rem; }
  }

</style>

<script>
  import '../lib/home-current-status';
  import '../lib/home-hero-motion';
  import { clientStrings } from '../i18n/client';

  const contactPrimaryLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-contact-primary]'),
  );
  if (contactPrimaryLinks.length) {
    const mobileBreakpoint = window.matchMedia('(max-width: 639px)');
    const updateContactPrimaryLinks = () => {
      const isMobile = mobileBreakpoint.matches;
      contactPrimaryLinks.forEach((link) => {
        link.href = isMobile
          ? link.dataset.whatsappHref ?? link.href
          : link.dataset.emailHref ?? link.href;
        const channel = isMobile ? 'WhatsApp' : 'email';
        const via = clientStrings().contact.via;
        const emailLabel = link.dataset.emailLabel;
        const whatsappLabel = link.dataset.whatsappLabel;
        if (emailLabel && whatsappLabel) {
          link.textContent = isMobile ? whatsappLabel : emailLabel;
        }
        link.setAttribute('aria-label', via(link.textContent?.trim() ?? '', channel, isMobile));
        if (isMobile) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        } else {
          link.removeAttribute('target');
          link.removeAttribute('rel');
        }
      });
    };
    updateContactPrimaryLinks();
    mobileBreakpoint.addEventListener('change', updateContactPrimaryLinks);
  }

</script>
