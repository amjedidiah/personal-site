---
import ArticleToc from '../components/ArticleToc.astro';
import { coverSocialCard } from '../lib/cover-paths';
import ShareButton from '../components/ShareButton.astro';
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import type { ArchiveLink, LocalizedPost } from '../lib/blog';
import { intlLocale, localePath, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { blogPostingNode, breadcrumbNode } from '../lib/structured-data';
import '../styles/reading.css';
import '../styles/article-motion.css';
import '../styles/motion.css';

interface Props {
  post: LocalizedPost;
  previous: ArchiveLink | null;
  next: ArchiveLink | null;
  related: LocalizedPost[];
}

const { post, previous, next, related } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const copy = t.blogPost;
const href = (path: string) => localePath(locale, path);
const { Content, headings } = await render(post.content);
const wordCount = post.content.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const articleDate = post.data.date.toLocaleDateString(intlLocale[locale], { day: '2-digit', month: 'short', year: 'numeric' });
const tocHeadings = headings.filter((heading) => heading.depth === 2);
// An untranslated post renders its English body; mark it for assistive tech.
const bodyLang = post.translated ? undefined : 'en';
const pagePath = href(`/blog/${post.id}`);
const structuredData = Astro.site ? [
  blogPostingNode(Astro.site, locale, post, pagePath),
  breadcrumbNode(Astro.site, [
    { name: t.nav.tabs.home, path: href('/') },
    { name: t.nav.tabs.blog, path: href('/blog') },
    { name: post.data.title, path: pagePath },
  ]),
] : [];
---

<Base
  title={`${post.data.title}${t.meta.titleSuffix}`}
  description={post.data.description}
  structuredData={structuredData}
  socialImage={{ src: coverSocialCard(locale, post.id), alt: post.data.title, type: 'image/png' }}
>
  <article class="article-shell" data-article-motion>
    <div class:list={['article-layout', 'has-rail', { 'has-toc': tocHeadings.length > 0 }]}>
      <div class="article-chrome">
        <div id="overview" class="article-headline" data-reading-headline>
          <h1>{post.data.title}</h1>
          {post.data.description && <p class="lead">{post.data.description}</p>}
        </div>
        <div class="article-rail">
          <div class="article-side-navigation">
            <a href={href('/blog')} class="back back-rail"><span aria-hidden="true">&larr;</span> {copy.allWriting}</a>
            {tocHeadings.length > 0 && <div class="article-rail-aside">
              <ArticleToc headings={tocHeadings} />
            </div>}
          </div>
        </div>
      </div>
      <div class="prose">
        <header class="article-details" data-reading-meta>
          <div class="article-meta">
            <span>{copy.journal}</span>
            <time datetime={post.data.date.toISOString()}>{articleDate}</time>
            <span>{copy.readingTime(readingMinutes)}</span>
            {post.data.tags?.length > 0 && (
              <span class="article-tags">{post.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}</span>
            )}
            <ShareButton title={post.data.title} />
          </div>
        </header>
        {bodyLang && copy.untranslated && <p class="article-language-note">{copy.untranslated}</p>}
        <div class="article-body" data-reading-body lang={bodyLang}>
        {post.content.body?.trim() ? <Content /> : (
          <div class="article-empty" role="status">
            <p>{copy.notAvailable}</p>
            <a href={href('/blog')}>{copy.browseAll}</a>
          </div>
        )}
        </div>
      </div>
    </div>
    {(previous || next) && (
      <nav class="article-nav" aria-label={copy.navLabel} data-reading-end>
        {previous ? (
          <a
            href={previous.href}
            class="article-nav-link article-nav-link--previous"
            target={previous.external ? '_blank' : undefined}
            rel={previous.external ? 'noopener noreferrer' : undefined}
          >
            <span><span class="article-direction" aria-hidden="true">&larr;</span> {copy.older}</span>
            <strong><span lang={previous.lang}>{previous.title}</span>{previous.external && <span class="visually-hidden">{t.meta.newTab}</span>}</strong>
          </a>
        ) : <span></span>}
        {next && (
          <a
            href={next.href}
            class="article-nav-link article-nav-link--next"
            target={next.external ? '_blank' : undefined}
            rel={next.external ? 'noopener noreferrer' : undefined}
          >
            <span>{copy.newer} <span class="article-direction" aria-hidden="true">&rarr;</span></span>
            <strong><span lang={next.lang}>{next.title}</span>{next.external && <span class="visually-hidden">{t.meta.newTab}</span>}</strong>
          </a>
        )}
      </nav>
    )}
    {related.length > 0 && (
      <section class="related-posts" aria-labelledby="related-heading">
        <h2 id="related-heading">{copy.keepReading}</h2>
        <div class="related-list">
          {related.map((item) => (
            <a href={href(`/blog/${item.id}`)} class="related-link" lang={item.translated ? undefined : 'en'}>
              <span>{item.data.title}</span>
              <small>{item.data.description}</small>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .article-shell { max-width: 980px; --article-scroll-offset: 30rem; --article-muted: color-mix(in srgb, var(--dim) 65%, var(--fg)); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    color: var(--article-muted);
    font: .75rem/1.4 var(--font-mono);
  }
  .back span { display: inline-block; transition: transform .2s ease; }
  .back:hover { color: var(--accent); opacity: 1; }
  .back:hover span { transform: translateX(-3px); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .8rem;
    margin-bottom: 1rem;
    color: var(--article-muted);
    font: .7rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .article-tag {
    color: var(--accent);
    white-space: nowrap;
  }
  .article-tags { display: inline-flex; flex-wrap: wrap; gap: .35rem .8rem; }
  .article-tag::before { content: '#'; }
  .lead {
    max-width: 60ch;
    color: var(--article-muted);
    font: 1.05rem/1.7 var(--font-sans);
  }
  .article-layout.has-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    grid-template-rows: auto 1fr;
    gap: 0 clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .article-headline {
    position: sticky;
    top: 3.5rem;
    padding-top: 1.25rem;
    z-index: 18;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .article-headline h1 {
    margin-bottom: .5rem;
    color: var(--fg);
    font: 700 clamp(1.45rem, 2.8vw, 2.35rem)/1.08 var(--font-sans);
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .article-headline .lead {
    margin: 0;
    max-width: 60ch;
    color: var(--article-muted);
    font: 1rem/1.65 var(--font-sans);
  }
  .prose {
    max-width: 68ch;
    min-width: 0;
    color: var(--fg);
    font: .95rem/1.85 var(--font-sans);
  }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(h2) {
    margin: 2.4em 0 .7em;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 1.25rem/1.3 var(--font-sans);
    letter-spacing: -.02em;
  }
  .prose :global(h3) {
    margin: 1.7em 0 .45em;
    color: var(--fg);
    font: 600 1rem/1.3 var(--font-sans);
  }
  .prose :global(code) {
    padding: .15em .4em;
    border-radius: 3px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: .88em;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    position: relative;
    margin: 1.4rem 0;
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    font: .8rem/1.65 var(--font-mono);
  }
  .prose :global(pre code) { padding: 0; background: none; white-space: pre; overflow-wrap: normal; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  .prose :global(a:hover) { text-decoration-thickness: 2px; opacity: 1; }
  .prose :global(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin-bottom: 1.2em; }
  .prose :global(li) { margin-bottom: .35em; }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: .2rem 0 .2rem 1rem;
    border-inline-start: 1px solid var(--accent);
    color: var(--article-muted);
    font-style: italic;
  }
  .prose :global(img) { max-width: 100%; margin: 1.5rem 0; border-radius: 4px; }
  .prose :global(hr) { margin: 2.5rem 0; border: 0; border-top: 1px solid var(--border); }

  .back-rail {
    justify-self: end;
    align-self: start;
    position: sticky;
    top: 3.5rem;
    z-index: 21;
    margin-bottom: 0;
  }
  .article-rail-aside {
    position: sticky;
    top: 5rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 12rem;
    max-width: 100%;
    padding-top: 2.75rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: right;
  }
  .article-rail-aside :global(.article-toc) { width: 100%; }
  .article-rail-aside :global(.article-toc nav) { justify-items: end; }
  .article-layout.has-rail .prose { min-width: 0; }

  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
  }
  .article-nav-link {
    display: grid;
    gap: .4rem;
    padding: 1rem 0;
    color: var(--fg);
  }
  .article-nav-link:hover, .article-nav-link:focus-visible { opacity: 1; }
  .article-nav-link span {
    color: var(--article-muted);
    font: .68rem/1.3 var(--font-mono);
    text-transform: uppercase;
  }
  .article-nav-link strong { font: 600 .85rem/1.4 var(--font-sans); transition: color .2s ease; }
  .article-nav-link:hover strong, .article-nav-link:focus-visible strong { color: var(--accent); }
  .article-nav-link--next { text-align: right; }

  .related-posts {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .related-posts h2 {
    margin-bottom: 1rem;
    color: var(--article-muted);
    font: 500 .7rem/1.4 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .related-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .related-link {
    display: grid;
    gap: .35rem;
    padding-top: .75rem;
    border-top: 1px solid var(--border);
    color: var(--fg);
  }
  .related-link:hover, .related-link:focus-visible { border-color: var(--accent); color: var(--accent); opacity: 1; }
  .related-link span { font: 600 .85rem/1.4 var(--font-sans); }
  .related-link small { color: var(--article-muted); font: .72rem/1.5 var(--font-sans); }

  @media (max-width: 800px) {
    .article-layout.has-rail { display: flex; flex-direction: column; gap: 0; }
    .article-rail {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .back-rail {
      order: 1;
      position: static;
      grid-column: auto;
      grid-row: auto;
      justify-self: auto;
      margin-bottom: .15rem;
    }
    .article-headline {
      order: 0;
      position: relative;
      top: auto;
      align-self: stretch;
      margin: 0;
      padding: 0 0 .35rem;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 0;
    }
    .article-headline h1 {
      margin: 0;
      font-size: clamp(1.5rem, 6vw, 2rem);
      line-height: 1.2;
    }
    .article-headline .lead { display: none; }
    .article-rail-aside {
      order: 3;
      position: static;
      width: 100%;
      padding-top: 0;
      max-height: none;
      overflow: visible;
      align-items: stretch;
      text-align: start;
    }
    .article-rail-aside :global(.article-toc nav) { justify-items: start; }
  }

  @media (max-width: 560px) {
    .article-meta { gap: .3rem .6rem; }
    .article-nav, .related-list { grid-template-columns: 1fr; }
    .article-nav-link--next { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .back span, .article-nav-link, .article-nav-link strong { transition: none; }
  }
</style>

<script>
  import { decorateExternalProseLinks } from '../lib/decorate-external-prose-links';
  import { enhanceArticleContent } from '../lib/article-content';
  import { initArticleToc } from '../lib/article-toc';
  import { initArticleMotion } from '../lib/article-motion';

  const run = () => {
    decorateExternalProseLinks();
    enhanceArticleContent();
    initArticleToc();
    initArticleMotion();
  };
  document.addEventListener('astro:page-load', run);
  run();
</script>
