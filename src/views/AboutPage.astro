---
import Base from '../layouts/Base.astro';
import CurrentWork from '../components/CurrentWork.astro';
import CountUp from '../components/CountUp.astro';
import '../styles/motion.css';
import { getCurrent } from '../data/current';
import { getProfile } from '../data/profile';
import { localePath, toLocale } from '../i18n/config';
import { fill, useTranslations } from '../i18n/ui';
import { profilePageNode } from '../lib/structured-data';
import Testimonials from '../components/Testimonials.astro';
import { testimonials } from '../data/testimonials';
import { ArrowUpRight } from '@lucide/astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const about = t.about;
const current = getCurrent(locale);
const profile = getProfile(locale);
// Story paragraphs carry inline <strong>; the values come from our own data files.
const storyValues = { years: profile.yearsExperience, mentored: profile.developersMentored, appReview: current.appReview };
const [heroFirst] = about.heroMessages;
const [contactFirst] = about.contactMessages;
const newTab = t.meta.newTab;
---

<Base
  title={t.seo.aboutTitle}
  description={t.seo.aboutDescription(profile.yearsExperience)}
  structuredData={Astro.site ? [profilePageNode(Astro.site, locale, localePath(locale, '/about'))] : []}
>
  <header class="about-hero">
    <div class="about-hero-top">
      <p class="about-path">{about.location}</p>
      <button class="typewriter-control" type="button" data-typewriter-toggle="hero" hidden>{about.pause}</button>
    </div>
    <h1 class="visually-hidden">{about.heading}</h1>
    <p class="about-title"><span class="visually-hidden">{about.heroLabel}</span><span aria-hidden="true"><span class="typewriter-prefix">{about.heroPrefix} <span data-typewriter-article>{heroFirst.article}</span></span>{' '}<span class="typewriter-text" data-typewriter-text>{heroFirst.role}</span></span></p>
    <p class="about-deck">{profile.introduction}</p>
  </header>

  <div class="about-intro">
    <div class="about-story">
      {about.story.map((section) => (
        <section class="story-section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p set:html={fill(paragraph, storyValues)} />)}
        </section>
      ))}
      <section class="story-section">
        <h2>{about.now}</h2>
        <CurrentWork />
      </section>
    </div>

    <aside class="proof-rail" aria-label={about.proofLabel}>
      <div class="proof-item"><CountUp value={profile.yearsExperience} suffix="+" /><span>{about.proof.years}</span></div>
      <div class="proof-item"><CountUp value={2} /><span>{about.proof.credentials}</span></div>
      <div class="proof-item"><CountUp value={profile.developersMentored} suffix="+" /><span>{about.proof.mentored}</span></div>
      <div class="proof-item"><CountUp value={3} /><span>{about.proof.continents}</span></div>
    </aside>
  </div>

  <section class="about-experience" id="experience">
    <h2>{about.experienceTitle}</h2>
    <p class="experience-context">{about.experienceContext}</p>
    <ol class="timeline">
      {about.experience.map((entry) => (
        <li class="exp">
          <div class="exp-head">
            <span class="exp-name">{entry.name}</span>
            <span class="exp-role">{entry.role}</span>
            <span class="exp-date">{entry.dates}</span>
          </div>
          <div class="exp-desc">{entry.description}</div>
        </li>
      ))}
    </ol>
  </section>

  <section class="about-recommendations" id="recommendations">
    <h2>{t.testimonials.aboutTitle}</h2>
    <Testimonials items={testimonials} />
  </section>

  <section class="about-proof">
    <h2>{about.credentialsTitle}</h2>
    <ul class="certs">
      <li><a href="https://stripecertifications.credential.net/50c637da-8253-49e6-9434-48bfe4719917" target="_blank" rel="noopener noreferrer">{about.credentials.architect} <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden">{newTab}</span></a> <span>{about.credentials.architectNote}</span></li>
      <li><a href="https://stripecertifications.credential.net/efcd44b0-6e66-4262-89c2-5a513bdec126" target="_blank" rel="noopener noreferrer">{about.credentials.developer} <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden">{newTab}</span></a> <span>{about.credentials.developerNote}</span></li>
      <li>{about.credentials.degree} <span>{about.credentials.university}</span></li>
      <li><a href="https://docs.google.com/presentation/d/1ubONK6ZQfQ-LADqEJtD7mxPFCkmrCGuisRm6joqcfuE/edit?usp=sharing" target="_blank" rel="noopener noreferrer">{about.credentials.speaker} <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden">{newTab}</span></a> <span>{about.credentials.speakerNote}</span></li>
      <li>{about.credentials.mentored(profile.developersMentored)} <span>{about.credentials.mentoredNote}</span></li>
      <li><a href="https://www.youtube.com/watch?v=SQ2vMppVmcc" target="_blank" rel="noopener noreferrer">{about.credentials.festival} <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden">{newTab}</span></a> <span>{about.credentials.festivalNote}</span></li>
    </ul>
  </section>

  <section class="about-stack">
    <h2>{about.capabilitiesTitle}</h2>
    <div class="stack-groups">
      <div>
        <h3>{about.capabilities.web}</h3>
        <p>TypeScript · React.js · Next.js · Astro · React Native · Styled Components · TailwindCSS · Redux · RTK Query · TanStack · Algolia</p>
      </div>
      <div>
        <h3>{about.capabilities.backend}</h3>
        <p>{about.capabilities.backendList}</p>
      </div>
      <div>
        <h3>{about.capabilities.ai}</h3>
        <p>{about.capabilities.aiDescription}</p>
        <p class="workflow-tools">Python · LangChain · Codex CLI</p>
      </div>
      <div>
        <h3>{about.capabilities.quality}</h3>
        <p>Jest · React Testing Library · Playwright · Git</p>
      </div>
    </div>
  </section>

  <section class="about-interests">
    <h2>{about.interestsTitle}</h2>
    <div class="interest-list">
      <span class="interest-link">
        <img class="interest-logo interest-logo--arsenal" src="/brands/arsenal.svg" alt="" width="18" height="18" loading="lazy" />
        <span>The Arsenal</span>
      </span>
      <span class="interest-link">
        <svg class="interest-logo interest-logo--cod" viewBox="0 0 32 18" aria-hidden="true">
          <text x="1" y="13" font-family="Arial, sans-serif" font-size="11" font-weight="800" letter-spacing=".4">COD</text>
        </svg>
        <span>Call of Duty</span>
      </span>
      <span>{about.interests.tableTennis}</span>
      <span>{about.interests.boardGames}</span>
      <span>Duolingo</span>
    </div>
    <p>{about.interestsNote}</p>
  </section>

  <section class="about-contact" id="contact">
    <div class="contact-heading">
      <h2 aria-label={about.contactLabel}><span class="contact-prefix">{about.contactPrefix}<span data-contact-article aria-hidden="true">{contactFirst.article}</span></span><span class="contact-typewriter" data-contact-typewriter aria-hidden="true">{contactFirst.role}</span></h2>
      <button class="typewriter-control" type="button" data-typewriter-toggle="contact" hidden>{about.pause}</button>
    </div>
    <p>{about.contactCopy}</p>
    <div class="links">
      <a href="https://github.com/amjedidiah" target="_blank" rel="noopener noreferrer">github<span class="visually-hidden">{newTab}</span></a>
      <a href="https://twitter.com/am_jedidiah" target="_blank" rel="noopener noreferrer">x / twitter<span class="visually-hidden">{newTab}</span></a>
      <a href="https://www.linkedin.com/in/am-jedidiah/" target="_blank" rel="noopener noreferrer">linkedin<span class="visually-hidden">{newTab}</span></a>
      <a class="about-email-link" href="mailto:imunacode@gmail.com">{about.contactLinks.email}</a>
      <a class="about-phone-link" href="tel:+2348165972229">{about.contactLinks.call}</a>
      <a href="https://docs.google.com/document/d/1_6ohHcb4bY9K7168NzdT5_nF9qKQSTtr70kRpAQrN6o/edit?usp=sharing" target="_blank" rel="noopener noreferrer">{about.contactLinks.resume}<span class="visually-hidden">{newTab}</span></a>
    </div>
  </section>
  <script type="application/json" data-typewriter-messages set:html={JSON.stringify({ hero: about.heroMessages, contact: about.contactMessages }).replace(/</g, '\\u003c')} />
</Base>

<style>
  :global(#main-content) { --about-muted: color-mix(in srgb, var(--dim) 80%, var(--fg)); }
  .about-hero {
    max-width: 58rem;
    margin-bottom: 5rem;
    margin-top: 0.55rem
  }
  .about-hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 42rem;
    min-height: 44px;
    margin-bottom: .9rem;
  }
  .about-path {
    color: var(--accent);
    font: .7rem/1.4 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .about-title {
    max-width: 13ch;
    overflow-wrap: anywhere;
    min-height: 2.1em;
    color: var(--fg);
    font: 700 clamp(2.8rem, 6vw, 5.8rem)/.96 var(--font-sans);
    letter-spacing: -.035em;
  }
  .typewriter-control {
    flex: none;
    min-height: 44px;
    padding: .35rem .5rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--about-muted);
    font: .7rem/1.3 var(--font-mono);
    cursor: pointer;
    transition: border-color .2s ease, color .2s ease;
  }
  .typewriter-control[hidden] { display: none; }
  .typewriter-control:hover { border-color: var(--accent); color: var(--accent); }
  .typewriter-control:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .typewriter-prefix,
  .typewriter-text { display: block; }
  .contact-prefix,
  .contact-typewriter { display: inline; }
  .about-deck {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--about-muted);
    font: 1.1rem/1.65 var(--font-sans);
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    margin-bottom: 6rem;
  }
  .about-story { max-width: 62ch; }
  .story-section {
    padding: 1.5rem 0 1.8rem;
    border-top: 1px solid var(--border);
  }
  .story-section:first-child { padding-top: 0; border-top: 0; }
  .story-section h2,
  .about-experience > h2,
  .about-recommendations > h2,
  .about-proof > h2,
  .about-stack > h2,
  .about-interests > h2 {
    margin-bottom: .8rem;
    padding: 0;
    border: 0;
    color: var(--about-muted);
    font: 500 .7rem/1.4 var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .story-section p {
    max-width: 60ch;
    color: var(--fg);
    font: 1rem/1.8 var(--font-sans);
  }
  .story-section p + p { margin-top: .8rem; }
  .story-section :global(p a) { text-decoration: underline; text-underline-offset: .2em; }
  .story-section :global(a:focus-visible), .certs a:focus-visible, .links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .proof-rail {
    display: grid;
    gap: 1.25rem;
    padding-top: .2rem;
  }
  .proof-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    overflow-wrap: anywhere;
    gap: .2rem;
    padding-top: .7rem;
    border-top: 1px solid var(--border);
  }
  .proof-item:first-child { border-top: 0; }
  .proof-item :global(.count-up) {
    color: var(--fg);
    font: 700 2rem/1 var(--font-sans);
    letter-spacing: -.04em;
  }
  .proof-item > span {
    color: var(--about-muted);
    font: .7rem/1.4 var(--font-mono);
    text-transform: uppercase;
  }

  .about-experience,
  .about-recommendations,
  .about-proof,
  .about-stack {
    margin-bottom: 5rem;
  }
  .timeline { display: flex; flex-direction: column; list-style: none; padding: 0; }
  .exp {
    position: relative;
    view-timeline: --about-experience block;
    display: grid;
    grid-template-columns: minmax(10rem, .45fr) minmax(0, 1fr);
    gap: 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .exp:first-child { padding-top: 0; border-top: 0; }
  .exp:not(:first-child)::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
    pointer-events: none;
  }
  @keyframes about-experience-rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (view-timeline: --about-experience block) and (animation-range: entry 0% cover 35%) {
      .exp::before {
        animation: var(--about-rule-animation, about-experience-rule linear both);
        animation-timeline: --about-experience;
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @media (forced-colors: active) { .exp::before { background: CanvasText; } }
  .exp-head { display: grid; align-content: start; gap: .3rem; }
  .exp-name { color: var(--fg); font: 600 1rem/1.3 var(--font-sans); }
  .exp-role { color: var(--about-muted); font: .72rem/1.4 var(--font-mono); }
  .exp-date { color: var(--about-muted); font: .7rem/1.4 var(--font-mono); }
  .exp-desc { max-width: 56ch; color: var(--about-muted); font: .85rem/1.65 var(--font-sans); }

  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem 2rem;
    list-style: none;
    padding: 0;
    color: var(--fg);
    font: .85rem/1.5 var(--font-sans);
  }
  .certs li { padding-top: .75rem; border-top: 1px solid var(--border); }
  .certs li:nth-child(-n+2) { border-top: 0; }
  .certs a {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .certs a:hover { color: var(--accent); opacity: 1; }
  .certs li span {
    display: block;
    color: var(--about-muted);
    font: .7rem/1.4 var(--font-mono);
  }

  .stack-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }
  @media (min-width: 40rem) {
    .stack-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .stack-groups { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stack-groups > div {
    min-height: 8rem;
    padding: 1.2rem;
    background: var(--bg);
  }
  .stack-groups h3 {
    margin-bottom: .7rem;
    color: var(--fg);
    font: 600 .9rem/1.3 var(--font-sans);
  }
  .stack-groups p { color: var(--about-muted); font: .82rem/1.65 var(--font-sans); }
  .stack-groups .workflow-tools { margin-top: .8rem; }
  .experience-context { max-width: 62ch; margin-bottom: 1.5rem; color: var(--about-muted); line-height: 1.7; }

  .about-interests { margin-bottom: 5rem; }
  .about-interests > p { max-width: 62ch; margin-top: 1rem; color: var(--about-muted); line-height: 1.7; }
  .interest-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem .8rem;
  }
  .interest-list > span,
  .interest-link {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    color: var(--fg);
    font: .78rem/1.3 var(--font-mono);
  }
  .interest-link { text-decoration: none; }
  .interest-logo { flex: none; inline-size: 1.05rem; block-size: 1.05rem; }
  .interest-logo--arsenal { object-fit: contain; }
  .interest-logo--cod { fill: currentColor; }

  .about-contact {
    padding: 3.5rem 0 1rem;
    border-top: 1px solid var(--border);
  }
  .contact-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; min-height: 44px; }
  .contact-heading h2 {
    min-width: 0;
    overflow-wrap: anywhere;
    margin-bottom: .25rem;
    min-height: 1.1em;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 clamp(1.4rem, 3vw, 2.2rem)/1.1 var(--font-sans);
    letter-spacing: -.03em;
    text-transform: none;
  }
  .about-contact > p { margin-bottom: 1.2rem; color: var(--about-muted); font: 1rem/1.5 var(--font-sans); }
  .links { display: flex; flex-wrap: wrap; gap: .5em; }
  .links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: .55em .85em;
    border: 1px solid var(--border); border-radius: 2px;
    font: .8rem/1.4 var(--font-mono); color: var(--fg);
    transition: border-color .15s, color .15s;
  }
  .links a:hover { border-color: var(--accent); color: var(--accent); opacity: 1; }
  .about-phone-link { display: none !important; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .about-hero { margin-bottom: 3.5rem; }
    .about-intro { grid-template-columns: 1fr; gap: 2rem; margin-bottom: 4rem; }
    .proof-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-item:nth-child(-n+2) { border-top: 0; }
    .exp { grid-template-columns: 1fr; gap: .6rem; }
    .certs { grid-template-columns: 1fr; }
    .stack-groups { grid-template-columns: minmax(0, 1fr); }
    .certs li:nth-child(-n+2) { border-top: 1px solid var(--border); }
    .certs li:first-child { border-top: 0; }
    .about-experience, .about-recommendations, .about-proof, .about-stack, .about-interests { margin-bottom: 4rem; }
  }

  @media (max-width: 639px) {
    .about-email-link { display: none !important; }
    .about-phone-link { display: inline-flex !important; }
  }
</style>

<script>
  import { observeReducedMotion, prefersReducedMotion } from '../lib/motion';
  import { clientStrings } from '../i18n/client';
  type Message = { article: string; role: string };

  const toggleCopy = clientStrings().typewriter;
  // Rendered by the page in its own language (see data-typewriter-messages).
  const typewriterMessages = (() => {
    try {
      return JSON.parse(document.querySelector('[data-typewriter-messages]')?.textContent ?? '') as { hero: Message[]; contact: Message[] };
    } catch {
      return null;
    }
  })();

  const createTypewriter = (
    text: HTMLElement | null,
    article: HTMLElement | null,
    toggle: HTMLButtonElement | null,
    messages: Message[],
  ) => {
    if (!text || !article || !toggle || !messages.length) return;

    let index = 0;
    let phase: 'hold' | 'delete' | 'type' = 'hold';
    let timer = 0;
    let inView = false;
    let userPaused = false;
    let disposed = false;
    let pageActive = true;

    const renderFull = () => {
      article.textContent = messages[index].article;
      text.textContent = messages[index].role;
      phase = 'hold';
    };

    const canRun = () => !disposed && pageActive && !userPaused && !prefersReducedMotion() && !document.hidden && inView;
    const schedule = (delay: number) => {
      timer = window.setTimeout(tick, delay);
    };

    const tick = () => {
      timer = 0;
      if (!canRun()) return;

      if (phase === 'hold') {
        phase = 'delete';
        schedule(24);
      } else if (phase === 'delete') {
        text.textContent = (text.textContent ?? '').slice(0, -1);
        if (text.textContent) {
          schedule(24);
        } else {
          index = (index + 1) % messages.length;
          article.textContent = messages[index].article;
          phase = 'type';
          schedule(42);
        }
      } else {
        const next = messages[index].role;
        text.textContent = next.slice(0, (text.textContent?.length ?? 0) + 1);
        if (text.textContent === next) {
          phase = 'hold';
          schedule(2200);
        } else {
          schedule(42);
        }
      }
    };

    const sync = () => {
      toggle.hidden = prefersReducedMotion() || !observer;
      toggle.textContent = userPaused ? toggleCopy.resume : toggleCopy.pause;
      if (!canRun()) {
        window.clearTimeout(timer);
        timer = 0;
        renderFull();
      } else if (!timer) {
        schedule(2200);
      }
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    const stopObservingMotion = observeReducedMotion(sync);
    document.addEventListener('visibilitychange', sync);

    const observer = typeof IntersectionObserver === 'function'
      ? new IntersectionObserver(([entry]) => {
          inView = entry.isIntersecting;
          sync();
        }, { threshold: .1 })
      : null;
    if (observer) observer.observe(text);
    // Unavailable observation retains complete static text.

    window.addEventListener('pagehide', (event) => {
      pageActive = false;
      sync();
      if (!event.persisted) {
        disposed = true;
        observer?.disconnect();
        stopObservingMotion();
        document.removeEventListener('visibilitychange', sync);
      }
    });
    window.addEventListener('pageshow', () => {
      pageActive = true;
      sync();
    });
    sync();
  };

  createTypewriter(
    document.querySelector<HTMLElement>('[data-typewriter-text]'),
    document.querySelector<HTMLElement>('[data-typewriter-article]'),
    document.querySelector<HTMLButtonElement>('[data-typewriter-toggle="hero"]'),
    typewriterMessages?.hero ?? [],
  );

  createTypewriter(
    document.querySelector<HTMLElement>('[data-contact-typewriter]'),
    document.querySelector<HTMLElement>('[data-contact-article]'),
    document.querySelector<HTMLButtonElement>('[data-typewriter-toggle="contact"]'),
    typewriterMessages?.contact ?? [],
  );
</script>
