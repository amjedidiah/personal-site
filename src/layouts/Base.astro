---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OfflineNotice from '../components/OfflineNotice.astro';
import BackToTop from '../components/BackToTop.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { getProfile } from '../data/profile';
import { supportsMotionPreference } from '../lib/motion';
import { locales, localePath, ogLocale, toLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
  noindex?: boolean;
  /**
   * Where each language's version of this page lives. Defaults to the same path
   * in every locale; pages that exist in one language only point elsewhere.
   */
  alternates?: Record<Locale, string>;
  /** False for pages without a true translation, so search engines aren't told otherwise. */
  hreflang?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const profile = getProfile(locale);
const {
  title,
  description = profile.description,
  fullBleed = false,
  noindex = false,
  alternates = Object.fromEntries(locales.map((code) => [code, localePath(code, Astro.url.pathname)])) as Record<Locale, string>,
  hreflang = true,
} = Astro.props;
// SW_KILL_SWITCH=1 builds ship a self-unregistering sw.js, so pages must stop registering it.
const registerServiceWorker = import.meta.env.PROD && process.env.SW_KILL_SWITCH !== '1';
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const alternateURLs = hreflang && Astro.site
  ? locales.map((code) => ({ hreflang: code, href: new URL(alternates[code], Astro.site) }))
  : [];
const socialImageURL = Astro.site ? new URL('/og.png', Astro.site) : '/og.png';
const socialImageAlt = `${profile.name}, ${profile.roles.replace(' · ', locale === 'fr' ? ' et ' : ' and ')}`;
---

<!doctype html>
<html lang={locale} data-motion-preferences={supportsMotionPreference(Astro.url.pathname) ? '' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" data-theme-color content="#0a0c10" />
  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.classList.add('has-js');
      root.dataset.motion = 'system';
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      let preference = 'system';

      try {
        const stored = window.localStorage.getItem('amjed-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
        if (root.hasAttribute('data-motion-preferences') && window.localStorage.getItem('amjed-motion') === 'reduce') root.dataset.motion = 'reduce';
      } catch {
        // Storage can be unavailable without preventing theme initialization.
      }

      const resolvedTheme = preference === 'system'
        ? (systemPrefersDark ? 'dark' : 'light')
        : preference;

      root.dataset.theme = resolvedTheme;
      root.dataset.themePreference = preference;
      root.style.colorScheme = resolvedTheme;
      document.querySelector('[data-theme-color]')?.setAttribute(
        'content',
        resolvedTheme === 'dark' ? '#0a0c10' : '#ffffff',
      );
    })();
  </script>
  <script is:inline>
    // Chrome can fire this before module scripts run, so hold on to it here.
    // preventDefault stops the automatic mini-infobar; PreferencesMenu offers
    // "Install app" instead.
    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      window.__installPrompt = event;
      window.dispatchEvent(new Event('amjed:install-change'));
    });
    window.addEventListener('appinstalled', () => {
      window.__installPrompt = null;
      window.dispatchEvent(new Event('amjed:install-change'));
    });
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=face" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-face.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="amjed" />
  <Font cssVariable="--font-plex" preload={[{ weight: 400 }]} />
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}
  {alternateURLs.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
  {alternateURLs.length > 0 && <link rel="alternate" hreflang="x-default" href={alternateURLs[0].href} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale[locale]} />
  {hreflang && locales.filter((code) => code !== locale).map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)}
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@am_jedidiah" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
</head>
<body id="page-top">
  <a class="skip-link" href="#main-content">{t.meta.skipLink}</a>
  <div class="page-progress" data-page-progress aria-hidden="true">
    <span></span>
  </div>
  <OfflineNotice />
  <Nav alternates={alternates} />
  {fullBleed ? (
    <main id="main-content">
      <slot />
    </main>
  ) : (
    <main id="main-content" class="wrap">
      <slot />
    </main>
  )}
  <Footer />
  <BackToTop />
  <script>
    import { initPageProgress } from '../lib/page-progress';
    initPageProgress();
  </script>
  <script is:inline>
    const motionIsReduced = () => document.documentElement.dataset.motion === 'reduce'
      || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const respectMotion = (event) => {
      if (document.documentElement.dataset.motion === 'reduce') event.viewTransition?.skipTransition();
    };
    window.addEventListener('pageswap', respectMotion);
    window.addEventListener('pagereveal', respectMotion);
    if ('IntersectionObserver' in window && !motionIsReduced()) {
      const targets = document.querySelectorAll('.sr, .sr-stagger');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('.sr-stagger').forEach((group) => {
        Array.from(group.children).forEach((child, index) => {
          child.style.setProperty('--reveal-delay', `${Math.min(index * 70, 350)}ms`);
        });
      });
      document.documentElement.classList.add('motion-ready');
      targets.forEach((target) => observer.observe(target));

      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
        if (event.matches) {
          observer.disconnect();
          document.documentElement.classList.remove('motion-ready');
        }
      }, { once: true });
    }
  </script>
  {registerServiceWorker ? (
    <script is:inline>
      if ('serviceWorker' in navigator) {
        let registration;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((result) => { registration = result; }, () => {});
        }, { once: true });
        // Pages are network-first, so an update only swaps the offline cache.
        // Apply it between pages rather than under the one being read.
        window.addEventListener('pagehide', () => {
          registration?.waiting?.postMessage({ type: 'SKIP_WAITING' });
        });
      }
    </script>
  ) : (
    <script is:inline>
      // Dev and kill-switch builds: drop any worker left behind (dev shares a port with `astro preview`).
      navigator.serviceWorker?.getRegistrations().then((registrations) => {
        registrations.forEach((registration) => registration.unregister());
      });
      window.caches?.keys().then((keys) => {
        keys.filter((key) => key.startsWith('amjed-')).forEach((key) => window.caches.delete(key));
      });
    </script>
  )}
</body>
</html>
