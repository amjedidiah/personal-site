---
import Base from '../layouts/Base.astro';
import CurrentWork from '../components/CurrentWork.astro';
import CountUp from '../components/CountUp.astro';
import '../styles/motion.css';
import { current } from '../data/current';
import { profile } from '../data/profile';
import { ArrowUpRight } from '@lucide/astro';
---

<Base title="About — Jedidiah Amaraegbu" description={profile.description}>
  <header class="about-hero">
    <div class="about-hero-top">
      <p class="about-path">Based in Lagos, Nigeria</p>
      <button class="typewriter-control" type="button" data-typewriter-toggle="hero" hidden>Pause text</button>
    </div>
    <h1 aria-label="Need a developer, engineer, speaker, consultant, or instructor?"><span class="typewriter-prefix">Need <span data-typewriter-article aria-hidden="true">a</span></span>{' '}<span class="typewriter-text" data-typewriter-text aria-hidden="true">developer?</span></h1>
    <p class="about-deck">I build web and mobile applications, integrate payments, and help teams polish code for launch.</p>
  </header>

  <div class="about-intro">
    <div class="about-story">
      <section class="story-section">
        <h2>the pivot</h2>
        <p>I began in dental surgery, then moved into Electronics Engineering before building my career in software. I was drawn to software’s wider reach: helping people and businesses communicate, earn, automate, and build at scale, with AI expanding that reach even further.<br /> I’ve been shipping production code for <strong>6+ years</strong>, mostly in <strong>TypeScript</strong>, <strong>React</strong>, <strong>Node.js</strong>, and <strong>Python</strong>.</p>
      </section>
      <section class="story-section">
        <h2>the speciality</h2>
        <p>My speciality is <strong>payments</strong>. I’ve built a Stripe Connect platform serving government contractors, automated <strong>cross-border payment flows</strong>, and integrated <strong>mobile money APIs across West Africa</strong>. I earned the Stripe Professional Implementation Architect and Professional Payments Developer credentials in <strong>2022</strong>; their current status is listed below.</p>
        <p>{current.appReview}</p>
      </section>
      <section class="story-section">
        <h2>the multiplier</h2>
        <p>I also teach. I've mentored <strong>200+ developers</strong> across <strong>3 continents</strong> through Google Developer Groups, Andela, GoMyCode, and Remotebase. I ran workshops at <strong>Google DevFest</strong> in 2022 and 2023, and led a bootcamp in the <strong>Benin Republic</strong>.</p>
      </section>
      <section class="story-section">
        <h2>now</h2>
        <CurrentWork />
      </section>
    </div>

    <aside class="proof-rail" aria-label="Selected proof">
      <div class="proof-item"><CountUp value={6} suffix="+" /><span>years shipping</span></div>
      <div class="proof-item"><CountUp value={2} /><span>Stripe credentials earned</span></div>
      <div class="proof-item"><CountUp value={200} suffix="+" /><span>developers mentored</span></div>
      <div class="proof-item"><CountUp value={3} /><span>continents</span></div>
    </aside>
  </div>

  <section class="about-experience" id="experience">
    <h2>selected experience</h2>
    <ol class="timeline">
      <li class="exp">
        <div class="exp-head">
          <span class="exp-name">Fiverr Pro</span>
          <span class="exp-role">Freelance Full Stack & Payments Developer</span>
          <span class="exp-date">2023&ndash;present</span>
        </div>
        <div class="exp-desc">Built a Stripe Connect integration for a platform serving 100+ government contractors. Client work includes payment APIs, integration tests, and documentation for support teams.</div>
      </li>
      <li class="exp">
        <div class="exp-head">
          <span class="exp-name">Remotebase</span>
          <span class="exp-role">Full Stack Software Engineer</span>
          <span class="exp-date">2022&ndash;2023</span>
        </div>
        <div class="exp-desc">Built a custom podcast player, automated cross-border payments for the finance team, and improved page loading with static site generation. Mentored 5 engineers.</div>
      </li>
      <li class="exp">
        <div class="exp-head">
          <span class="exp-name">GoMyCode</span>
          <span class="exp-role">Full Stack JavaScript Instructor</span>
          <span class="exp-date">2021&ndash;2022</span>
        </div>
        <div class="exp-desc">Taught full-stack JavaScript across 4 cohorts through practical workshops and team projects. Volunteered to lead a 1-week frontend and API development bootcamp in Benin Republic.</div>
      </li>
      <li class="exp">
        <div class="exp-head">
          <span class="exp-name">Woozeee</span>
          <span class="exp-role">Full Stack Web Developer</span>
          <span class="exp-date">2021</span>
        </div>
        <div class="exp-desc">Built responsive interfaces for mobile users on limited bandwidth, and improved page loading through code optimisation and reusable components.</div>
      </li>
    </ol>
  </section>

  <section class="about-proof">
    <h2>credentials & proof</h2>
    <ul class="certs">
      <li><a href="https://stripecertifications.credential.net/50c637da-8253-49e6-9434-48bfe4719917" target="_blank" rel="noopener noreferrer">Stripe Professional Implementation Architect <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden"> (opens in a new tab)</span></a> <span>Earned December 2022 · expired 1 October 2026</span></li>
      <li><a href="https://stripecertifications.credential.net/efcd44b0-6e66-4262-89c2-5a513bdec126" target="_blank" rel="noopener noreferrer">Stripe Professional Payments Developer <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden"> (opens in a new tab)</span></a> <span>Earned November 2022 · does not expire</span></li>
      <li>B.E. Electronic Engineering <span>University of Nigeria, Nsukka</span></li>
      <li><a href="https://docs.google.com/presentation/d/1ubONK6ZQfQ-LADqEJtD7mxPFCkmrCGuisRm6joqcfuE/edit?usp=sharing" target="_blank" rel="noopener noreferrer">Google DevFest speaker <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden"> (opens in a new tab)</span></a> <span>Enugu, 2022 & 2023</span></li>
      <li>200+ developers mentored <span>across 3 continents</span></li>
      <li><a href="https://www.youtube.com/watch?v=SQ2vMppVmcc" target="_blank" rel="noopener noreferrer">iCreate Skills Festival <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /><span class="visually-hidden"> (opens in a new tab)</span></a> <span>2019 · National medal for website development</span></li>
    </ul>
  </section>

  <section class="about-stack">
    <h2>capabilities</h2>
    <div class="stack-groups">
      <div>
        <h3>web & mobile</h3>
        <p>TypeScript · React.js · Next.js · Astro · React Native · Styled Components · TailwindCSS · Redux · RTK Query · TanStack · Algolia</p>
      </div>
      <div>
        <h3>backend & payments</h3>
        <p>Node.js · Express.js · REST APIs · GraphQL · Stripe · mobile money · PostgreSQL · MongoDB · Redis · AWS: Lambda, SQS, S3, DynamoDB, Cognito · Vercel · Docker</p>
      </div>
      <div>
        <h3>AI & assisted development</h3>
        <p>Python · LangChain · Claude Code · Cursor AI · Codex CLI</p>
      </div>
      <div>
        <h3>quality & delivery</h3>
        <p>Jest · React Testing Library · Playwright · Git</p>
      </div>
    </div>
  </section>

  <section class="about-interests">
    <h2>outside work</h2>
    <div class="interest-list">
      <span class="interest-link">
        <img class="interest-logo interest-logo--arsenal" src="/brands/arsenal.svg" alt="" width="18" height="18" loading="lazy" />
        <span>The Arsenal</span>
      </span>
      <span class="interest-link">
        <svg class="interest-logo interest-logo--cod" viewBox="0 0 32 18" aria-hidden="true">
          <text x="1" y="13" font-family="Arial, sans-serif" font-size="11" font-weight="800" letter-spacing=".4">COD</text>
        </svg>
        <span>Call of Duty</span>
      </span>
      <span>Table tennis</span>
    </div>
  </section>

  <section class="about-contact" id="contact">
    <div class="contact-heading">
      <h2 aria-label="Have an idea or project?"><span class="contact-prefix">Have <span data-contact-article aria-hidden="true">an </span></span><span class="contact-typewriter" data-contact-typewriter aria-hidden="true">idea?</span></h2>
      <button class="typewriter-control" type="button" data-typewriter-toggle="contact" hidden>Pause text</button>
    </div>
    <p>Let's talk.</p>
    <div class="links">
      <a href="https://github.com/amjedidiah" target="_blank" rel="noopener noreferrer">github<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a href="https://twitter.com/am_jedidiah" target="_blank" rel="noopener noreferrer">x / twitter<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a href="https://www.linkedin.com/in/am-jedidiah/" target="_blank" rel="noopener noreferrer">linkedin<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="about-email-link" href="mailto:imunacode@gmail.com">email</a>
      <a class="about-phone-link" href="tel:+2348165972229">call</a>
      <a href="https://docs.google.com/document/d/1_6ohHcb4bY9K7168NzdT5_nF9qKQSTtr70kRpAQrN6o/edit?usp=sharing" target="_blank" rel="noopener noreferrer">resume<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </section>
</Base>

<style>
  :global(#main-content) { --about-muted: color-mix(in srgb, var(--dim) 80%, var(--fg)); }
  .about-hero {
    max-width: 58rem;
    margin-bottom: 5rem;
    margin-top: 0.55rem
  }
  .about-hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 42rem;
    min-height: 44px;
    margin-bottom: .9rem;
  }
  .about-path {
    color: var(--accent);
    font: .7rem/1.4 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .about-hero h1 {
    max-width: 13ch;
    overflow-wrap: anywhere;
    min-height: 2.1em;
    color: var(--fg);
    font: 700 clamp(2.8rem, 6vw, 5.8rem)/.96 var(--font-sans);
    letter-spacing: -.035em;
  }
  .typewriter-control {
    flex: none;
    min-height: 44px;
    padding: .35rem .5rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--about-muted);
    font: .7rem/1.3 var(--font-mono);
    cursor: pointer;
    transition: border-color .2s ease, color .2s ease;
  }
  .typewriter-control[hidden] { display: none; }
  .typewriter-control:hover { border-color: var(--accent); color: var(--accent); }
  .typewriter-control:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .typewriter-prefix,
  .typewriter-text { display: block; }
  .contact-prefix,
  .contact-typewriter { display: inline; }
  .about-deck {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--about-muted);
    font: 1.1rem/1.65 var(--font-sans);
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    margin-bottom: 6rem;
  }
  .about-story { max-width: 62ch; }
  .story-section {
    padding: 1.5rem 0 1.8rem;
    border-top: 1px solid var(--border);
  }
  .story-section:first-child { padding-top: 0; border-top: 0; }
  .story-section h2,
  .about-experience > h2,
  .about-proof > h2,
  .about-stack > h2,
  .about-interests > h2 {
    margin-bottom: .8rem;
    padding: 0;
    border: 0;
    color: var(--about-muted);
    font: 500 .7rem/1.4 var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .story-section p {
    max-width: 60ch;
    color: var(--fg);
    font: 1rem/1.8 var(--font-sans);
  }
  .story-section p + p { margin-top: .8rem; }
  .story-section :global(p a) { text-decoration: underline; text-underline-offset: .2em; }
  .story-section :global(a:focus-visible), .certs a:focus-visible, .links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .proof-rail {
    display: grid;
    gap: 1.25rem;
    padding-top: .2rem;
  }
  .proof-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    overflow-wrap: anywhere;
    gap: .2rem;
    padding-top: .7rem;
    border-top: 1px solid var(--border);
  }
  .proof-item:first-child { border-top: 0; }
  .proof-item :global(.count-up) {
    color: var(--fg);
    font: 700 2rem/1 var(--font-sans);
    letter-spacing: -.04em;
  }
  .proof-item > span {
    color: var(--about-muted);
    font: .7rem/1.4 var(--font-mono);
    text-transform: uppercase;
  }

  .about-experience,
  .about-proof,
  .about-stack {
    margin-bottom: 5rem;
  }
  .timeline { display: flex; flex-direction: column; list-style: none; padding: 0; }
  .exp {
    position: relative;
    view-timeline: --about-experience block;
    display: grid;
    grid-template-columns: minmax(10rem, .45fr) minmax(0, 1fr);
    gap: 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .exp:first-child { padding-top: 0; border-top: 0; }
  .exp:not(:first-child)::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
    pointer-events: none;
  }
  @keyframes about-experience-rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (view-timeline: --about-experience block) and (animation-range: entry 0% cover 35%) {
      .exp::before {
        animation: var(--about-rule-animation, about-experience-rule linear both);
        animation-timeline: --about-experience;
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @media (forced-colors: active) { .exp::before { background: CanvasText; } }
  .exp-head { display: grid; align-content: start; gap: .3rem; }
  .exp-name { color: var(--fg); font: 600 1rem/1.3 var(--font-sans); }
  .exp-role { color: var(--about-muted); font: .72rem/1.4 var(--font-mono); }
  .exp-date { color: var(--about-muted); font: .7rem/1.4 var(--font-mono); }
  .exp-desc { max-width: 56ch; color: var(--about-muted); font: .85rem/1.65 var(--font-sans); }

  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem 2rem;
    list-style: none;
    padding: 0;
    color: var(--fg);
    font: .85rem/1.5 var(--font-sans);
  }
  .certs li { padding-top: .75rem; border-top: 1px solid var(--border); }
  .certs li:nth-child(-n+2) { border-top: 0; }
  .certs a {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .certs a:hover { color: var(--accent); opacity: 1; }
  .certs li span {
    display: block;
    color: var(--about-muted);
    font: .7rem/1.4 var(--font-mono);
  }

  .stack-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }
  @media (min-width: 40rem) {
    .stack-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 68rem) {
    .stack-groups { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stack-groups > div {
    min-height: 8rem;
    padding: 1.2rem;
    background: var(--bg);
  }
  .stack-groups h3 {
    margin-bottom: .7rem;
    color: var(--fg);
    font: 600 .9rem/1.3 var(--font-sans);
  }
  .stack-groups p { color: var(--about-muted); font: .82rem/1.65 var(--font-sans); }

  .about-interests { margin-bottom: 5rem; }
  .interest-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem .8rem;
  }
  .interest-list > span,
  .interest-link {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    color: var(--fg);
    font: .78rem/1.3 var(--font-mono);
  }
  .interest-link { text-decoration: none; }
  .interest-logo { flex: none; inline-size: 1.05rem; block-size: 1.05rem; }
  .interest-logo--arsenal { object-fit: contain; }
  .interest-logo--cod { fill: currentColor; }

  .about-contact {
    padding: 3.5rem 0 1rem;
    border-top: 1px solid var(--border);
  }
  .contact-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; min-height: 44px; }
  .contact-heading h2 {
    min-width: 0;
    overflow-wrap: anywhere;
    margin-bottom: .25rem;
    min-height: 1.1em;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 clamp(1.4rem, 3vw, 2.2rem)/1.1 var(--font-sans);
    letter-spacing: -.03em;
    text-transform: none;
  }
  .about-contact > p { margin-bottom: 1.2rem; color: var(--about-muted); font: 1rem/1.5 var(--font-sans); }
  .links { display: flex; flex-wrap: wrap; gap: .5em; }
  .links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: .55em .85em;
    border: 1px solid var(--border); border-radius: 2px;
    font: .8rem/1.4 var(--font-mono); color: var(--fg);
    transition: border-color .15s, color .15s;
  }
  .links a:hover { border-color: var(--accent); color: var(--accent); opacity: 1; }
  .about-phone-link { display: none !important; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .about-hero { margin-bottom: 3.5rem; }
    .about-intro { grid-template-columns: 1fr; gap: 2rem; margin-bottom: 4rem; }
    .proof-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-item:nth-child(-n+2) { border-top: 0; }
    .exp { grid-template-columns: 1fr; gap: .6rem; }
    .certs { grid-template-columns: 1fr; }
    .stack-groups { grid-template-columns: minmax(0, 1fr); }
    .certs li:nth-child(-n+2) { border-top: 1px solid var(--border); }
    .certs li:first-child { border-top: 0; }
    .about-experience, .about-proof, .about-stack, .about-interests { margin-bottom: 4rem; }
  }

  @media (max-width: 639px) {
    .about-email-link { display: none !important; }
    .about-phone-link { display: inline-flex !important; }
  }
</style>

<script>
  import { observeReducedMotion, prefersReducedMotion } from '../lib/motion';
  type Message = { article: string; role: string };

  const createTypewriter = (
    text: HTMLElement | null,
    article: HTMLElement | null,
    toggle: HTMLButtonElement | null,
    messages: Message[],
  ) => {
    if (!text || !article || !toggle) return;

    let index = 0;
    let phase: 'hold' | 'delete' | 'type' = 'hold';
    let timer = 0;
    let inView = false;
    let userPaused = false;
    let disposed = false;
    let pageActive = true;

    const renderFull = () => {
      article.textContent = messages[index].article;
      text.textContent = messages[index].role;
      phase = 'hold';
    };

    const canRun = () => !disposed && pageActive && !userPaused && !prefersReducedMotion() && !document.hidden && inView;
    const schedule = (delay: number) => {
      timer = window.setTimeout(tick, delay);
    };

    const tick = () => {
      timer = 0;
      if (!canRun()) return;

      if (phase === 'hold') {
        phase = 'delete';
        schedule(24);
      } else if (phase === 'delete') {
        text.textContent = (text.textContent ?? '').slice(0, -1);
        if (text.textContent) {
          schedule(24);
        } else {
          index = (index + 1) % messages.length;
          article.textContent = messages[index].article;
          phase = 'type';
          schedule(42);
        }
      } else {
        const next = messages[index].role;
        text.textContent = next.slice(0, (text.textContent?.length ?? 0) + 1);
        if (text.textContent === next) {
          phase = 'hold';
          schedule(2200);
        } else {
          schedule(42);
        }
      }
    };

    const sync = () => {
      toggle.hidden = prefersReducedMotion() || !observer;
      toggle.textContent = userPaused ? 'Resume text' : 'Pause text';
      if (!canRun()) {
        window.clearTimeout(timer);
        timer = 0;
        renderFull();
      } else if (!timer) {
        schedule(2200);
      }
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    const stopObservingMotion = observeReducedMotion(sync);
    document.addEventListener('visibilitychange', sync);

    const observer = typeof IntersectionObserver === 'function'
      ? new IntersectionObserver(([entry]) => {
          inView = entry.isIntersecting;
          sync();
        }, { threshold: .1 })
      : null;
    if (observer) observer.observe(text);
    // Unavailable observation retains complete static text.

    window.addEventListener('pagehide', (event) => {
      pageActive = false;
      sync();
      if (!event.persisted) {
        disposed = true;
        observer?.disconnect();
        stopObservingMotion();
        document.removeEventListener('visibilitychange', sync);
      }
    });
    window.addEventListener('pageshow', () => {
      pageActive = true;
      sync();
    });
    sync();
  };

  createTypewriter(
    document.querySelector<HTMLElement>('[data-typewriter-text]'),
    document.querySelector<HTMLElement>('[data-typewriter-article]'),
    document.querySelector<HTMLButtonElement>('[data-typewriter-toggle="hero"]'),
    [
      { article: 'a', role: 'developer?' },
      { article: 'an', role: 'engineer?' },
      { article: 'a', role: 'speaker?' },
      { article: 'a', role: 'consultant?' },
      { article: 'an', role: 'instructor?' },
    ],
  );

  createTypewriter(
    document.querySelector<HTMLElement>('[data-contact-typewriter]'),
    document.querySelector<HTMLElement>('[data-contact-article]'),
    document.querySelector<HTMLButtonElement>('[data-typewriter-toggle="contact"]'),
    [
      { article: 'an ', role: 'idea?' },
      { article: 'a ', role: 'project?' },
    ],
  );
</script>
