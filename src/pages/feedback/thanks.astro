---
import Base from '../../layouts/Base.astro';
import { Check } from '@lucide/astro';
import { feedbackSuccess } from '../../data/feedback-copy';
---

<Base title="Thank you — Jedidiah Amaraegbu" description="Thanks for sharing your feedback." noindex>
  <div class="thanks">
    <span class="mark" aria-hidden="true"><Check size={16} strokeWidth={2} /></span>
    <h1>{feedbackSuccess.title}</h1>
    <p>{feedbackSuccess.detail}</p>
    <a href="/">Return home <span aria-hidden="true">&rarr;</span></a>
  </div>
</Base>

<style>
  .thanks { max-width: 42rem; margin: clamp(3rem, 10vw, 8rem) auto; }
  .mark { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--accent); border-radius: 50%; color: var(--accent); }
  h1 { margin-top: 1rem; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.03em; line-height: 1.1; text-wrap: balance; }
  p { margin-top: 1rem; color: var(--dim); }
  a { display: inline-block; margin-top: 1.5rem; }
</style>
