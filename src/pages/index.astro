---
import Base from '../layouts/Base.astro';
---

<Base title="Jedidiah Amaraegbu">
  <header>
    <h1>Jedidiah Amaraegbu</h1>
    <div class="sub">full stack engineer &middot; stripe architect &middot; security researcher</div>
    <div class="bio">
      <p>I build payment systems, AI agents, and real-time platforms. 6+ years shipping TypeScript, React, Node.js, and Python across fintech, edtech, and social products.</p>
      <p>Stripe-certified (Implementation Architect + Payments Developer). Currently hunting bugs on Stripe's HackerOne program and building multiplayer AI tooling.</p>
    </div>
  </header>

  <div class="now">
    <strong>/now</strong> &mdash; building <a href="/projects">Gwela</a> (multiplayer AI agent platform), doing security research on Stripe Connect & MCP, applying to YC W27.
  </div>

  <section>
    <h2>Featured Work</h2>
    <div class="grid">
      <a href="/projects" class="card">
        <span class="card-name">Gwela</span>
        <div class="card-desc">Multiplayer AI agent platform with real-time WebSocket streaming and multi-provider LLM support.</div>
        <div class="card-tech">React 19 &middot; FastAPI &middot; WebSockets</div>
      </a>
      <a href="/projects" class="card">
        <span class="card-name">AjoFlow</span>
        <div class="card-desc">AI-powered fintech digitising Nigerian savings circles with LangChain agents.</div>
        <div class="card-tech">Next.js &middot; LangChain &middot; Interswitch</div>
      </a>
      <a href="/projects" class="card">
        <span class="card-name">Web Scraper</span>
        <div class="card-desc">Intelligent data pipeline with custom scoring for high-value signal extraction.</div>
        <div class="card-tech">TypeScript &middot; Crawlee &middot; SQLite</div>
      </a>
    </div>
    <a href="/projects" class="see-all">all projects &rarr;</a>
  </section>

  <section>
    <h2>Latest</h2>
    <div class="posts">
      <p class="empty">Blog posts coming soon. Check back or follow on <a href="https://twitter.com/amjedidiah">X</a>.</p>
    </div>
  </section>
</Base>

<style>
  header { margin-bottom: 3rem; }
  .sub { color: var(--dim); font-size: .85rem; margin-top: .15em; margin-bottom: 1.5rem; }
  .bio { color: var(--fg); font-size: .9rem; line-height: 1.75; }
  .bio p { margin-bottom: .5em; }

  .now {
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 1rem 1.25rem; font-size: .85rem; color: var(--dim);
    margin-bottom: 2.5rem; line-height: 1.6;
    box-shadow: 0 0 0 1px var(--glow);
  }
  .now strong { color: var(--fg); font-weight: 600; }

  .grid {
    display: grid; gap: 1px; background: var(--border);
    border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
  }
  .card {
    background: var(--bg); padding: 1rem 1.25rem; display: block;
    color: inherit; transition: background .15s;
  }
  .card:hover { background: var(--surface); opacity: 1; }
  .card-name { font-weight: 600; color: var(--fg); font-size: .9rem; }
  .card-desc { color: var(--dim); font-size: .8rem; margin-top: .3em; line-height: 1.55; }
  .card-tech { color: var(--dim); font-size: .7rem; margin-top: .35em; opacity: .55; }

  .see-all {
    display: inline-block; margin-top: .8rem; font-size: .8rem; color: var(--dim);
  }
  .see-all:hover { color: var(--accent); }

  .posts { color: var(--dim); font-size: .85rem; }
  .empty { font-style: italic; opacity: .7; }

  @media (min-width: 640px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .grid .card:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .bio { font-size: .95rem; }
  }

  @media (max-width: 400px) {
    .now { padding: .85rem 1rem; }
    .card { padding: .85rem 1rem; }
  }
</style>
