---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';
import { getCollection } from 'astro:content';
import { current } from '../data/current';
import { imagePlaceholders } from '../data/image-placeholders';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const caseStudies = projects.filter((p) => p.id === 'ajoflow' || p.id === 'gwela');
const otherFeatured = projects.filter((p) => p.id !== 'ajoflow' && p.id !== 'gwela');

const caseFocus: Record<string, string> = { ajoflow: 'Payments + AI', gwela: 'Collaborative AI' };

const paymentInquirySubject = 'Payment project inquiry';
const paymentInquiryMessage = "Hi Jedidiah, I'd like to discuss a payment project.";
const paymentInquiryEmail = `mailto:imunacode@gmail.com?subject=${encodeURIComponent(paymentInquirySubject)}&body=${encodeURIComponent(paymentInquiryMessage)}`;
const paymentInquiryWhatsApp = `https://wa.me/2348165972229?text=${encodeURIComponent(paymentInquiryMessage)}`;

const clients = [
  { name: 'Fiverr Pro', note: '100+ contractors' },
  { name: 'Remotebase', note: 'cross-border payments' },
  { name: 'GoMyCode', note: '4 cohorts trained' },
  { name: 'Google DevFest', note: 'speaker' },
  { name: 'Andela', note: 'mentor' },
  { name: 'HackerOne', note: 'Stripe program' },
];
---

<Base title="Jedidiah Amaraegbu | Payments and AI Engineer" description="I help fintech and platform teams ship payments and AI that hold up in production. Explore working products and get in touch." fullBleed>
  <!-- HERO -->
  <section class="hero hero-frame">
    <HeroScene />
    <div class="hero-frame-inner">
      <p class="hero-name sr">Jedidiah Amaraegbu</p>
      <p class="hero-tag sr">full-stack engineer · Stripe architect · security researcher</p>
      <h1 class="sr">Payments and AI that hold up in production.</h1>
      <p class="hero-lede sr">From Stripe Connect integrations and cross-border payouts to collaborative AI agents — I take complex systems from prototype to production.</p>
      <div class="hero-actions sr">
        <a class="btn-primary hero-contact" href={paymentInquiryEmail} data-email-href={paymentInquiryEmail} data-whatsapp-href={paymentInquiryWhatsApp}>discuss a payment project</a>
        <a class="btn-ghost" href="/projects/gwela">explore Gwela (AI)</a>
      </div>
      <div class="scroll-hint" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <!-- 01 — NOW -->
  <section class="now-section" data-nav-surface="surface">
    <div class="constrained">
      <div class="section-label sr">
        <h2>now</h2>
      </div>
      <div class="now-grid sr">
        <p class="now">Building <a href="/projects/gwela">Gwela</a>, a shared AI session product, and researching Stripe Connect and MCP security.</p>
        <div class="current-signals" data-current-signals>
          <div class="current-signal">
            <span class="signal-label">Availability</span>
            <strong class="availability" data-current-availability data-available="true"><span class="availability-dot" aria-hidden="true"></span><span data-current-availability-label>{current.availability}</span></strong>
            <span class="signal-detail" data-current-availability-detail>{current.availabilityDetail}</span>
          </div>
          <div class="current-signal">
            <span class="signal-label">Latest Gwela update</span>
            <a href={current.latest.href} class="signal-title" data-current-latest-link><span data-current-latest-title>{current.latest.title}</span> <span aria-hidden="true">&rarr;</span></a>
            <span class="signal-detail" data-current-latest-detail>{current.latest.detail}</span>
            <time datetime={current.latest.date} data-current-latest-date>{new Date(`${current.latest.date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
          </div>
        </div>
      </div>
      <p class="current-reviewed" data-current-status role="status">Status last reviewed <time datetime={current.reviewedAt}>{new Date(`${current.reviewedAt}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time></p>
    </div>
  </section>

  <!-- 02 — FEATURED WORK -->
  <section class="work-section">
    <div class="constrained">
      <div class="section-label sr">
        <h2>featured work</h2>
      </div>
      <div class="case-list sr-stagger">
        {caseStudies.map((p, index) => (
          <article class:list={['case-study', { 'case-study--lead': index === 0 }]}>
            <a href={`/projects/${p.id}`} class="case-image-link" aria-label={`Read ${p.data.title} case study`}>
              <div class="case-image">
                {p.data.image && <ProgressiveImage src={p.data.image} alt={p.data.imageAlt ?? p.data.title} placeholder={imagePlaceholders[p.id]} sizes="(max-width: 900px) calc(100vw - 2rem), 45vw" />}
              </div>
              <span class="case-caption">{p.data.imageCaption}</span>
            </a>
            <div class="case-copy">
              <p class="case-focus">{caseFocus[p.id]}</p>
              <h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
              <p class="case-description">{p.data.description}</p>
              <dl class="case-facts">
                <div><dt>My role</dt><dd>{p.data.role}</dd></div>
                <div><dt>Proof</dt><dd>{p.data.evidence}</dd></div>
              </dl>
              <div class="case-actions">
                <a href={`/projects/${p.id}`}>Read case study <span aria-hidden="true">&rarr;</span></a>
                {p.data.url && <a href={p.data.url} target="_blank" rel="noopener noreferrer">{p.data.urlLabel ?? 'View project'} <span aria-hidden="true">&nearr;</span></a>}
              </div>
            </div>
          </article>
        ))}
      </div>
      {otherFeatured.length > 0 && <p class="other-work">Also built: {otherFeatured.map((p, index) => <span>{index > 0 && ', '}<a href={`/projects/${p.id}`}>{p.data.title}</a></span>)}</p>}
      <a href="/projects" class="see-all">all projects &rarr;</a>
    </div>
  </section>

  <!-- 03 — EXPERIENCE -->
  <section class="clients-section" data-nav-surface="surface">
    <div class="constrained">
      <div class="section-label sr">
        <h2>experience</h2>
      </div>
      <p class="experience-summary sr">Work spanning payment infrastructure, developer education, and security research.</p>
      <div class="proof-list sr-stagger">
        {clients.map((c) => (
          <span class="proof-item">
            <strong>{c.name}</strong>
            <span>{c.note}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="constrained sr">
      <p class="cta-text">Planning a payment integration or a production AI feature?</p>
      <a class="btn-primary" href="mailto:imunacode@gmail.com?subject=Project%20inquiry">Tell me what you're building</a>
      <a class="cta-email" href="mailto:imunacode@gmail.com">imunacode@gmail.com</a>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { overflow: visible; }
  .hero-tag {
    color: var(--dim); font: .8rem/1.5 var(--font-mono);
    margin-bottom: 1.2rem; letter-spacing: .02em;
  }
  .hero-name {
    color: var(--fg); font-family: var(--font-sans);
    font-size: .95rem; font-weight: 600;
    margin-bottom: .35rem;
  }
  .hero h1 {
    font-size: 2.2rem;
    line-height: 1.05;
    margin-bottom: 1rem;
    max-width: 16ch;
  }
  .hero-lede {
    font-family: var(--font-sans);
    color: var(--dim); font-size: 1rem;
    line-height: 1.7; max-width: 48ch;
    margin-bottom: 1.5rem; font-weight: 400;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  /* buttons */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--bg); background: var(--accent);
    padding: .65em 1.3em; border-radius: 2px;
    font-size: .8rem; font-weight: 600;
    transition: opacity .15s;
  }
  .btn-primary:hover { opacity: .85; color: var(--bg); }
  .btn-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--dim); font-size: .8rem;
    padding: .65em 1.3em;
    border: 1px solid var(--border); border-radius: 2px;
    transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); opacity: 1; }

  /* scroll hint */
  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
  }
  .scroll-hint span {
    display: block; width: 1px; height: 40px;
    background: var(--border);
    animation: pulse-down 2s ease-in-out infinite;
  }
  @keyframes pulse-down {
    0%, 100% { opacity: .2; transform: scaleY(.5); transform-origin: top; }
    50% { opacity: .6; transform: scaleY(1); }
  }

  /* constrained */
  .constrained {
    max-width: var(--max-w); margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* now */
  .now-section {
    padding: 1.4rem 0 1.6rem;
    background: transparent;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .section-label h2 { font-size: .82rem; }
  .now-grid {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 3.5rem;
  }
  .now {
    font-family: var(--font-sans);
    font-size: 1rem; color: var(--fg); line-height: 1.65;
    max-width: 40ch;
  }
  .current-signals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .current-signal {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: .4rem;
    padding-top: .75rem;
    border-top: 1px solid var(--border);
  }
  .signal-label {
    font-size: .75rem; color: var(--dim);
    text-transform: uppercase; letter-spacing: .06em;
  }
  .current-signal strong, .signal-title {
    font: 600 .9rem/1.4 var(--font-sans);
    color: var(--fg);
  }
  .signal-title:hover { color: var(--accent); }
  .availability { display: inline-flex; align-items: center; gap: .55rem; }
  .availability-dot {
    width: .42rem; height: .42rem; flex: none;
    border-radius: 50%; background: #2f9f69;
  }
  .availability:not([data-available="true"]) .availability-dot { background: var(--dim); }
  .signal-detail { color: var(--dim); font-size: .78rem; line-height: 1.55; }
  .current-signal time, .current-reviewed {
    color: var(--dim); font-size: .75rem;
  }
  .current-reviewed { margin-top: 1.5rem; min-height: 1rem; }

  /* work */
  .work-section { padding: 6rem 0 4rem; }
  .case-list { border-bottom: 1px solid var(--border); }
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: 2.25rem 0;
    border-top: 1px solid var(--border);
  }
  .case-study--lead {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    padding-top: 0;
  }
  .case-image-link { display: block; min-width: 0; }
  .case-image {
    display: grid; place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }
  .case-image :global(.progressive-image) {
    height: 100%;
    aspect-ratio: auto;
    background-size: cover;
    transform: scale(1);
    transition: transform .45s cubic-bezier(.2, .7, .2, 1);
  }
  .case-image :global(.progressive-image img) { object-fit: cover; }
  .case-image-link:is(:hover, :focus-visible) .case-image :global(.progressive-image) {
    transform: scale(1.025);
  }
  .case-caption {
    display: block; margin-top: .5rem;
    color: var(--dim); font-size: .75rem; line-height: 1.45;
    font-family: var(--font-mono);
  }
  .case-copy { min-width: 0; }
  .case-focus {
    color: var(--accent); font: .75rem/1.4 var(--font-mono);
    text-transform: uppercase; letter-spacing: .05em;
    margin-bottom: .6rem;
  }
  .case-copy h3 {
    color: var(--fg); font-family: var(--font-sans);
    font-size: 1.45rem;
    line-height: 1.2; margin-bottom: .7rem;
  }
  .case-copy h3 a { color: inherit; }
  .case-copy h3 a:hover { color: var(--accent); }
  .case-description {
    color: var(--dim); font-family: var(--font-sans);
    font-size: .92rem; line-height: 1.65;
    max-width: 45ch;
  }
  .case-facts {
    display: grid; gap: .75rem;
    margin: 1.2rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .case-facts div { display: grid; grid-template-columns: 4.2rem 1fr; gap: .6rem; }
  .case-facts dt {
    color: var(--dim); font-size: .75rem;
    text-transform: uppercase; letter-spacing: .04em;
    font-family: var(--font-mono);
  }
  .case-facts dd { color: var(--fg); font-size: .8rem; line-height: 1.5; }
  .case-actions { display: flex; flex-wrap: wrap; gap: .25rem 1.4rem; }
  .case-actions a { display: inline-flex; align-items: center; min-height: 40px; color: var(--accent); font: .8rem/1.4 var(--font-mono); }
  .case-actions a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .other-work {
    margin-top: 1.4rem;
    color: var(--dim); font-size: .75rem;
  }
  .other-work a { color: var(--fg); }
  .other-work a:hover { color: var(--accent); }
  .see-all {
    display: inline-block; margin-top: 1.2rem;
    font-size: .8rem; color: var(--accent);
  }
  .see-all:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .case-image :global(.progressive-image) { transition: none; }
  }

  /* experience */
  .clients-section {
    padding: 5rem 0;
    background: transparent;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .experience-summary {
    max-width: 48ch;
    margin: -0.35rem 0 1.75rem;
    color: var(--dim);
    font-family: var(--font-sans);
    font-size: .95rem;
    line-height: 1.65;
  }
  .proof-list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .7rem 1.2rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .proof-item {
    display: inline-flex;
    align-items: baseline;
    gap: .55rem;
  }
  .proof-item strong {
    font-family: var(--font-sans);
    font-size: .9rem; font-weight: 600; color: var(--fg);
  }
  .proof-item span {
    font: .75rem/1.4 var(--font-mono); color: var(--dim);
  }

  /* cta */
  .cta-section { padding: 4.5rem 0; }
  .cta-section .constrained {
    text-align: left;
    display: flex; flex-direction: column;
    align-items: flex-start; gap: 1.2rem;
  }
  .cta-text {
    font-family: var(--font-sans);
    color: var(--fg); font-size: 1.15rem; max-width: 28ch;
    line-height: 1.6;
  }
  .cta-email { color: var(--dim); font-size: .78rem; }
  .cta-email:hover { color: var(--accent); }

  @media (min-width: 640px) {
    .hero h1 { font-size: 2.8rem; }
  }

  @media (min-width: 960px) {
    .hero h1 { font-size: 3.3rem; }
    .hero-lede { font-size: 1.15rem; }
    .case-copy h3 { font-size: 1.85rem; }
    .cta-text { font-size: 1.3rem; }
  }

  @media (min-width: 1400px) {
    .hero h1 { font-size: 4.1rem; }
    .hero-lede { font-size: 1.2rem; }
    .case-copy h3 { font-size: 2rem; }
  }

  @media (max-width: 900px) {
    .now-grid { grid-template-columns: 1fr; gap: 2rem; }
    .case-study { grid-template-columns: 1fr; gap: 1.2rem; }
    .case-copy { max-width: 42rem; }
  }

  @media (min-width: 761px) and (max-width: 959px) {
    .hero-lede { max-width: 40ch; }
  }

  @media (max-width: 639px) {
    .hero {
      align-items: flex-start;
      min-height: calc(min(72svh, 640px) - 52px - env(safe-area-inset-top));
      padding-top: 3rem;
    }
  }

  @media (max-width: 400px) {
    .hero { padding-bottom: 2.5rem; }
    .current-signals { grid-template-columns: 1fr; }
    .scroll-hint { display: none; }
  }

  @media (max-width: 400px) and (max-height: 760px) {
    .hero { padding-top: 2rem; padding-bottom: 1rem; }
    .hero-tag { margin-bottom: .5rem; }
    .hero-lede { margin-bottom: 1rem; }
    .now-section { padding-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint span { animation: none; }
  }
</style>

<script>
  import { currentIssueUrls, parseAvailabilityIssue, parseLatestIssue } from '../lib/current-feed';

  const heroContact = document.querySelector<HTMLAnchorElement>('.hero-contact');
  if (heroContact) {
    const mobileBreakpoint = window.matchMedia('(max-width: 639px)');
    const updateHeroContact = () => {
      const isMobile = mobileBreakpoint.matches;
      heroContact.href = isMobile
        ? heroContact.dataset.whatsappHref ?? heroContact.href
        : heroContact.dataset.emailHref ?? heroContact.href;
      heroContact.setAttribute('aria-label', `Discuss a payment project via ${isMobile ? 'WhatsApp' : 'email'}`);
      if (isMobile) {
        heroContact.target = '_blank';
        heroContact.rel = 'noopener';
      } else {
        heroContact.removeAttribute('target');
        heroContact.removeAttribute('rel');
      }
    };
    updateHeroContact();
    mobileBreakpoint.addEventListener('change', updateHeroContact);
  }

  type FeedResult<T> =
    | { kind: 'data'; value: T; raw: unknown }
    | { kind: 'empty' }
    | { kind: 'error' }
    | { kind: 'rate-limited'; retryAt: number };

  type CachedIssue = { savedAt: number; raw: unknown };
  type FeedCache = { availability?: CachedIssue; latest?: CachedIssue; retryAt?: number };
  const cacheKey = 'jed-current-feed-v1';
  const refreshInterval = 5 * 60 * 1000;

  async function readIssue<T>(url: string, parse: (value: unknown) => T | null): Promise<FeedResult<T>> {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(url, {
        headers: { Accept: 'application/vnd.github+json' },
        cache: 'no-store',
        signal: controller.signal,
      });
      if (response.status === 404) return { kind: 'empty' };
      if (response.status === 403 || response.status === 429) {
        const reset = Number(response.headers.get('x-ratelimit-reset')) * 1000;
        const retryAfter = Number(response.headers.get('retry-after')) * 1000;
        return {
          kind: 'rate-limited',
          retryAt: reset > Date.now() ? reset + 1000 : Date.now() + (retryAfter > 0 ? retryAfter : refreshInterval),
        };
      }
      if (!response.ok) return { kind: 'error' };
      const raw = await response.json();
      const value = parse(raw);
      return value ? { kind: 'data', value, raw } : { kind: 'empty' };
    } catch {
      return { kind: 'error' };
    } finally {
      window.clearTimeout(timeout);
    }
  }

  const signals = document.querySelector<HTMLElement>('[data-current-signals]');
  const availability = signals?.querySelector<HTMLElement>('[data-current-availability]');
  const availabilityLabel = signals?.querySelector<HTMLElement>('[data-current-availability-label]');
  const availabilityDetail = signals?.querySelector<HTMLElement>('[data-current-availability-detail]');
  const latestLink = signals?.querySelector<HTMLAnchorElement>('[data-current-latest-link]');
  const latestTitle = signals?.querySelector<HTMLElement>('[data-current-latest-title]');
  const latestDetail = signals?.querySelector<HTMLElement>('[data-current-latest-detail]');
  const latestDate = signals?.querySelector<HTMLTimeElement>('[data-current-latest-date]');
  const status = document.querySelector<HTMLElement>('[data-current-status]');

  if (availability && availabilityLabel && availabilityDetail && latestLink && latestTitle && latestDetail && latestDate && status) {
    const fallbackStatus = status.textContent?.trim() ?? 'Status last reviewed';
    const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const checkFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    const cache: FeedCache = (() => {
      try {
        const stored = JSON.parse(localStorage.getItem(cacheKey) ?? 'null');
        return stored && typeof stored === 'object' ? stored as FeedCache : {};
      } catch { return {}; }
    })();
    const saveCache = () => {
      try { localStorage.setItem(cacheKey, JSON.stringify(cache)); } catch { /* Storage is optional. */ }
    };
    const cachedValue = <T,>(entry: CachedIssue | undefined, parse: (raw: unknown) => T | null): T | null => {
      if (!entry || typeof entry.savedAt !== 'number' || Date.now() - entry.savedAt > 60 * 60 * 1000) return null;
      return parse(entry.raw);
    };
    const showAvailability = (value: NonNullable<ReturnType<typeof parseAvailabilityIssue>>, fresh: boolean) => {
      availability.dataset.available = fresh ? String(value.available) : 'unknown';
      availabilityLabel.textContent = value.label;
      availabilityDetail.textContent = value.detail;
    };
    const showLatest = (value: NonNullable<ReturnType<typeof parseLatestIssue>>) => {
      latestTitle.textContent = value.title;
      latestDetail.textContent = value.detail;
      latestLink.href = value.href;
      latestDate.dateTime = value.updatedAt;
      latestDate.textContent = dateFormat.format(new Date(value.updatedAt));
      latestDate.hidden = false;
    };
    let pending = false;
    let checked = false;
    let lastCheck = 0;
    let lastKnownStatus = fallbackStatus;

    const savedAvailability = cachedValue(cache.availability, parseAvailabilityIssue);
    const savedLatest = cachedValue(cache.latest, parseLatestIssue);
    if (savedAvailability && savedLatest && cache.availability && cache.latest) {
      showAvailability(savedAvailability, false);
      showLatest(savedLatest);
      lastCheck = Math.min(cache.availability.savedAt, cache.latest.savedAt);
      lastKnownStatus = `Last synced ${checkFormat.format(new Date(lastCheck))}`;
      status.dataset.state = 'cached';
      status.textContent = lastKnownStatus;
      checked = true;
    }

    const refresh = async () => {
      if (pending || (cache.retryAt && Date.now() < cache.retryAt)) return;
      pending = true;
      lastCheck = Date.now();
      if (!checked) {
        availability.dataset.available = 'unknown';
        status.dataset.state = 'loading';
        status.textContent = 'Checking current status...';
      }

      const [availabilityResult, latestResult] = await Promise.all([
        readIssue(currentIssueUrls.availability, parseAvailabilityIssue),
        readIssue(currentIssueUrls.latest, parseLatestIssue),
      ]);

      if (availabilityResult.kind === 'data') {
        showAvailability(availabilityResult.value, true);
        cache.availability = { savedAt: Date.now(), raw: availabilityResult.raw };
      } else if (availabilityResult.kind === 'empty') {
        availability.dataset.available = 'false';
        availabilityLabel.textContent = 'Availability not published';
        availabilityDetail.textContent = 'Please email to ask about timing.';
        delete cache.availability;
      } else {
        availability.dataset.available = 'unknown';
      }

      if (latestResult.kind === 'data') {
        showLatest(latestResult.value);
        cache.latest = { savedAt: Date.now(), raw: latestResult.raw };
      } else if (latestResult.kind === 'empty') {
        latestTitle.textContent = 'No public update yet';
        latestDetail.textContent = 'Explore the Gwela case study.';
        latestLink.href = '/projects/gwela';
        latestDate.hidden = true;
        delete cache.latest;
      }

      cache.retryAt = Math.max(
        availabilityResult.kind === 'rate-limited' ? availabilityResult.retryAt : 0,
        latestResult.kind === 'rate-limited' ? latestResult.retryAt : 0,
      );
      saveCache();
      const errorCount = Number(availabilityResult.kind === 'error' || availabilityResult.kind === 'rate-limited')
        + Number(latestResult.kind === 'error' || latestResult.kind === 'rate-limited');
      status.dataset.state = errorCount === 0 ? 'data' : errorCount === 2 ? 'error' : 'partial';
      if (errorCount === 0) lastKnownStatus = `Last synced ${checkFormat.format(new Date())}`;
      status.textContent = errorCount === 0
        ? `Live status checked ${checkFormat.format(new Date())}`
        : `Unable to refresh live status. ${lastKnownStatus}`;
      checked = true;
      pending = false;
    };

    if (cache.retryAt && Date.now() < cache.retryAt) {
      availability.dataset.available = 'unknown';
      status.dataset.state = 'error';
      status.textContent = `Unable to refresh live status. ${lastKnownStatus}`;
    } else if (!savedAvailability || !savedLatest || Date.now() - lastCheck >= refreshInterval) {
      void refresh();
    }
    window.setInterval(() => {
      if (document.visibilityState === 'visible' && Date.now() - lastCheck >= refreshInterval) void refresh();
    }, 60 * 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - lastCheck >= refreshInterval) void refresh();
    });
  }
</script>
