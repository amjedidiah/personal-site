---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';
import { getCollection } from 'astro:content';
import { current } from '../data/current';
import { hashnodePosts } from '../data/hashnode';
import { imagePlaceholders } from '../data/image-placeholders';
import { pickHomeFeaturedArticles } from '../lib/home-featured-articles';
import { experienceClients } from '../data/experience-clients';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const caseStudyIds = ['cocktail-book-club', 'gwela'];
const caseStudies = caseStudyIds
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is (typeof projects)[number] => p !== undefined);
const otherFeatured = projects.filter((p) => !caseStudyIds.includes(p.id));

const blogPosts = await getCollection('blog');
const featuredArticles = pickHomeFeaturedArticles(blogPosts, hashnodePosts, 2);

const caseFocus: Record<string, string> = {
  'cocktail-book-club': 'Mobile · community',
  gwela: 'Collaborative AI',
};
/** TODO: set true when featured case study images are ready to ship */
const showCaseStudyImages = false;

const paymentInquirySubject = 'Payment project inquiry';
const paymentInquiryMessage = "Hi Jedidiah, I'd like to discuss a payment project.";
const paymentInquiryEmail = `mailto:imunacode@gmail.com?subject=${encodeURIComponent(paymentInquirySubject)}&body=${encodeURIComponent(paymentInquiryMessage)}`;
const paymentInquiryWhatsApp = `https://wa.me/2348165972229?text=${encodeURIComponent(paymentInquiryMessage)}`;

---

<Base title="Jedidiah Amaraegbu | Payments and AI Engineer" description="I help fintech and platform teams ship payments and AI that hold up in production. Explore working products and get in touch." fullBleed>
  <!-- HERO -->
  <section class="hero hero-frame">
    <div class="hero-frame-inner">
      <p class="hero-name">Jedidiah Amaraegbu</p>
      <p class="hero-tag">full-stack engineer · Stripe architect · security researcher</p>
      <h1><span>Apps and payments</span>{' '}<span>that hold up in</span>{' '}<span class="hero-title-emphasis">production.</span></h1>
    </div>
    <HeroScene />
    <div class="hero-copy">
      <p class="hero-lede">Stripe and payments architecture, full-stack web, mobile, and AI engineering — from requirements gathering through general availability.</p>
      <div class="hero-actions">
        <a
          class="btn-primary hero-contact"
          href={paymentInquiryEmail}
          data-contact-primary
          data-email-href={paymentInquiryEmail}
          data-whatsapp-href={paymentInquiryWhatsApp}
        >
          Discuss a payment project
        </a>
        <a class="btn-ghost" href="/projects/gwela">Explore Gwela (AI)</a>
      </div>
    </div>
  </section>

  <!-- 01 — NOW -->
  <section class="now-section" data-nav-surface="surface">
    <div class="constrained">
      <div class="section-label section-label--plain sr">
        <h2>now</h2>
      </div>
      <div class="now-panel sr">
        <div class="now-primary">
          <p class="now-eyebrow">Current focus</p>
          <p class="now-lede">Building <a href="/projects/gwela">Gwela</a>, a shared AI session product, and researching application security using HackerOne Bug bounty program.</p>
        </div>
        <div class="current-signals" data-current-signals>
          <article class="current-signal signal-card">
            <span class="signal-label">Availability</span>
            <strong class="availability" data-current-availability data-available="true"><span class="availability-dot" aria-hidden="true"></span><span data-current-availability-label>{current.availability}</span></strong>
            <span class="signal-detail" data-current-availability-detail>{current.availabilityDetail}</span>
          </article>
        </div>
      </div>
      <p class="current-reviewed" data-current-status role="status">Status last reviewed <time datetime={current.reviewedAt}>{new Date(`${current.reviewedAt}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time></p>
    </div>
  </section>

  <!-- 02 — FEATURED WORK -->
  <section class="work-section home-band">
    <div class="constrained">
      <div class="section-label section-label--plain sr">
        <h2>featured work</h2>
      </div>
      <div class="featured-work sr-stagger">
        {caseStudies.map((p, index) => (
          <article class="featured-card">
            {showCaseStudyImages && p.data.image && (
              <a href={`/projects/${p.id}`} class="featured-card-media" aria-label={`Read ${p.data.title} case study`}>
                <div class="case-image">
                  <ProgressiveImage src={p.data.image} alt={p.data.imageAlt ?? p.data.title} placeholder={imagePlaceholders[p.id]} sizes="(max-width: 900px) calc(100vw - 2rem), 50vw" />
                </div>
                {p.data.imageCaption && <span class="case-caption">{p.data.imageCaption}</span>}
              </a>
            )}
            <div class="featured-card-body">
              <header class="featured-card-head">
                <span class="featured-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p class="featured-focus">{caseFocus[p.id]}</p>
              </header>
              <h3 class="featured-title"><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
              <p class="featured-description">{p.data.description}</p>
              <dl class="featured-facts">
                {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                {p.data.evidence && <div><dt>Proof</dt><dd>{p.data.evidence}</dd></div>}
              </dl>
              <div class="featured-actions">
                <a href={`/projects/${p.id}`}>Case study <span aria-hidden="true">&rarr;</span></a>
                {p.data.url && (
                  <a href={p.data.url} target="_blank" rel="noopener noreferrer">
                    {p.data.urlLabel ?? 'View project'} <span aria-hidden="true">&nearr;</span>
                  </a>
                )}
                {p.data.urlSecondary && (
                  <a href={p.data.urlSecondary} target="_blank" rel="noopener noreferrer">
                    {p.data.urlSecondaryLabel ?? 'View project'} <span aria-hidden="true">&nearr;</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      {otherFeatured.length > 0 && <p class="other-work">Also built: {otherFeatured.map((p, index) => <span>{index > 0 && ', '}<a href={`/projects/${p.id}`}>{p.data.title}</a></span>)}</p>}
      <a href="/projects" class="see-all">all projects &rarr;</a>
    </div>
  </section>

  <!-- FEATURED ARTICLES (after featured work) -->
  {featuredArticles.length > 0 && (
    <section class="writing-section home-band">
      <div class="constrained">
        <div class="section-label section-label--plain sr">
          <h2>featured articles</h2>
        </div>
        <div class="featured-writing sr-stagger">
          {featuredArticles.map((article) => (
            <article class="writing-card">
              <div class="writing-card-body">
                <header class="writing-card-head">
                  <time datetime={article.date.toISOString().slice(0, 10)} class="writing-date">
                    {article.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
                  </time>
                  <p class="writing-focus">
                    {article.external ? 'Hashnode' : (article.focus ?? 'on-site')}
                  </p>
                </header>
                <h3 class="writing-title">
                  <a
                    href={article.href}
                    {...(article.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {article.title}
                  </a>
                </h3>
                {article.description && <p class="writing-description">{article.description}</p>}
                <div class="writing-actions">
                  <a
                    href={article.href}
                    {...(article.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    Read article
                    <span aria-hidden="true">{article.external ? '\u2197' : '\u2192'}</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <a href="/blog" class="see-all">all posts &rarr;</a>
      </div>
    </section>
  )}

  <!-- 03 — EXPERIENCE -->
  <section class="clients-section home-band" data-nav-surface="surface">
    <div class="constrained">
      <div class="section-label section-label--plain sr">
        <h2>experience</h2>
      </div>
      <p class="experience-summary sr">Payments platforms, AI products, and the teams that ship them — in production, not slide decks.</p>
      <ul class="experience-grid sr-stagger">
        {experienceClients.map((c) => (
          <li>
            <a
              class="experience-card"
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.name} — ${c.note} (opens in a new tab)`}
            >
              <img
                class:list={[
                  'experience-logo',
                  c.logoShape === 'wordmark' && 'experience-logo--wordmark',
                  c.logoShape === 'mark' && 'experience-logo--mark',
                  c.logoShape === 'gdg' && 'experience-logo--gdg',
                ]}
                src={c.logo}
                alt=""
                width="112"
                height="28"
                loading="lazy"
                decoding="async"
              />
              <strong>{c.name}</strong>
              <span>{c.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section home-band" data-nav-surface="surface">
    <div class="constrained">
      <div class="section-label section-label--plain sr">
        <h2>work together</h2>
      </div>
      <div class="cta-band sr">
        <div class="cta-copy">
          <p class="cta-proof">
            <span>Payments</span>
            <span class="cta-proof-sep" aria-hidden="true">·</span>
            <span>Production AI</span>
            <span class="cta-proof-sep" aria-hidden="true">·</span>
            <span>Full-stack</span>
          </p>
          <h3 class="cta-headline">Ship payments tooling, collaborative AI, or full-stack product work — without the three-month detour.</h3>
          <p class="cta-lede">Email a short note on what you’re building and when you need it — I usually reply within a few days.</p>
        </div>
        <div class="cta-actions">
          <a
            class="btn-primary cta-contact"
            href={paymentInquiryEmail}
            data-contact-primary
            data-email-href={paymentInquiryEmail}
            data-whatsapp-href={paymentInquiryWhatsApp}
            data-email-label="Email me"
            data-whatsapp-label="WhatsApp"
          >
            Email me
          </a>
          <a class="cta-light" href="/feedback">lighter ask: share feedback</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero {
    --hero-muted: color-mix(in srgb, var(--dim) 65%, var(--fg));
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 0;
    overflow: clip;
    min-height: min(82svh, 760px);
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .hero-frame-inner {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    min-width: 0;
    max-width: none;
    margin: 0;
  }
  .hero-copy { grid-column: 1; grid-row: 2; align-self: start; min-width: 0; }
  .hero-tag {
    color: var(--hero-muted); font: .78rem/1.6 var(--font-sans);
    max-width: 42ch;
    margin-bottom: 1.2rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .hero-name {
    color: var(--fg); font-family: var(--font-sans);
    font-size: .95rem; font-weight: 600;
    margin-bottom: .35rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 4.65vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -.035em;
    margin-bottom: 1.5rem;
    max-width: none;
  }
  .hero h1 > span { display: block; }
  .hero-title-emphasis { color: var(--accent); }
  .hero-lede {
    font-family: var(--font-sans);
    color: var(--hero-muted); font-size: 1rem;
    line-height: 1.7; max-width: 40ch;
    margin-bottom: 1.5rem; font-weight: 400;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  /* buttons */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--bg); background: var(--accent);
    padding: .65em 1.3em; border-radius: 2px;
    font-size: .8rem; font-weight: 600;
    transition: opacity .15s;
  }
  .btn-primary:hover { opacity: .85; color: var(--bg); }
  .btn-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--fg); font-size: .8rem;
    padding: .65em 1.3em;
    border: 1px solid var(--dim); border-radius: 2px;
    transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); opacity: 1; }

  /* constrained */
  .constrained {
    max-width: var(--max-w); margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* now */
  .now-section {
    margin-bottom: 0;
    padding: clamp(2rem, 4.5vw, 2.85rem) 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .now-section .section-label--plain {
    margin-bottom: 1rem;
  }
  .now-section .section-label--plain::after {
    display: none;
  }
  .now-section .section-label--plain h2 {
    flex: none;
  }
  .section-label h2 { font-size: .82rem; }
  .now-panel {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: stretch;
    padding: clamp(1.1rem, 2.2vw, 1.45rem);
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 38%, var(--bg));
  }
  .now-primary {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .55rem;
    min-width: 0;
  }
  .now-eyebrow {
    margin: 0;
    color: var(--dim);
    font: 600 .68rem/1.35 var(--font-mono);
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .now-lede {
    margin: 0;
    max-width: 36ch;
    color: var(--fg);
    font: 500 clamp(1.08rem, 1.9vw, 1.32rem)/1.5 var(--font-sans);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .now-lede a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--fg) 28%, transparent);
    text-underline-offset: .18em;
    transition: text-decoration-color .15s ease;
  }
  .now-lede a:hover {
    text-decoration-color: color-mix(in srgb, var(--fg) 55%, transparent);
  }
  .current-signals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .65rem;
    align-content: center;
  }
  .current-signal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .45rem;
    min-width: 0;
  }
  .signal-card {
    padding: .9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: color-mix(in srgb, var(--bg) 72%, var(--surface));
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .signal-card:hover {
    border-color: color-mix(in srgb, var(--fg) 12%, var(--border));
    background: color-mix(in srgb, var(--bg) 58%, var(--surface));
  }
  .signal-label {
    font-size: .72rem;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .current-signal strong,
  .signal-title {
    font: 600 clamp(.88rem, 1.4vw, .95rem)/1.4 var(--font-sans);
    color: var(--fg);
  }
  .signal-title {
    display: inline-flex;
    align-items: baseline;
    gap: .35rem;
    max-width: 100%;
  }
  .signal-title:hover { color: var(--accent); }
  .signal-title-arrow {
    flex: none;
    color: var(--accent);
    transition: transform .2s ease;
  }
  .signal-title:hover .signal-title-arrow { transform: translateX(3px); }
  .availability { display: inline-flex; align-items: center; gap: .55rem; }
  .availability-dot {
    width: .48rem;
    height: .48rem;
    flex: none;
    border-radius: 50%;
    background: #2f9f69;
    box-shadow: 0 0 0 0 color-mix(in srgb, #2f9f69 35%, transparent);
  }
  .availability:not([data-available="false"]) .availability-dot {
    background: #2f9f69;
    animation: now-availability-pulse 2.8s ease-in-out infinite;
  }
  .availability[data-available="false"] .availability-dot {
    background: var(--dim);
    animation: none;
  }
  @keyframes now-availability-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, #2f9f69 45%, transparent);
    }
    55% {
      box-shadow: 0 0 0 5px color-mix(in srgb, #2f9f69 0%, transparent);
    }
  }
  .signal-detail {
    color: var(--dim);
    font-size: .78rem;
    line-height: 1.55;
  }
  .current-signal time,
  .current-reviewed {
    color: var(--dim);
    font-size: .75rem;
  }
  .current-reviewed {
    margin-top: 1rem;
    min-height: 1rem;
  }

  /* homepage bands — shared vertical rhythm (work had 6rem/4rem + section margin; trimmed) */
  .home-band {
    margin-bottom: 0;
    padding: clamp(2.75rem, 5vw, 3.75rem) 0;
  }
  .home-band .section-label--plain {
    margin-bottom: 1.25rem;
  }
  .home-band .section-label--plain::after {
    display: none;
  }
  .home-band .section-label--plain h2 {
    flex: none;
  }

  /* work */
  .featured-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-top: .25rem;
  }
  .featured-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 30%, var(--bg));
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .featured-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--surface) 45%, var(--bg));
  }
  .featured-card-media {
    display: block;
    min-width: 0;
    border-bottom: 1px solid var(--border);
  }
  .featured-card-media .case-image {
    border: 0;
    border-radius: 6px 6px 0 0;
  }
  .featured-card-media .case-caption {
    padding: 0 1.1rem .75rem;
  }
  .featured-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.2rem 1.35rem;
  }
  .featured-card-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .featured-index {
    font: 600 clamp(2rem, 4vw, 2.75rem)/1 var(--font-sans);
    letter-spacing: -0.05em;
    color: color-mix(in srgb, var(--dim) 55%, var(--border));
  }
  .featured-focus {
    margin: 0;
    text-align: right;
    color: var(--accent);
    font: 600 .68rem/1.35 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .case-image {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }
  .case-image :global(.progressive-image) {
    height: 100%;
    aspect-ratio: auto;
    background-size: cover;
    transform: scale(1);
    transition: transform .45s cubic-bezier(.2, .7, .2, 1);
  }
  .case-image :global(.progressive-image img) { object-fit: cover; }
  .featured-card-media:is(:hover, :focus-visible) .case-image :global(.progressive-image) {
    transform: scale(1.025);
  }
  .case-caption {
    display: block;
    margin-top: .5rem;
    color: var(--dim);
    font-size: .75rem;
    line-height: 1.45;
    font-family: var(--font-mono);
  }
  .featured-title {
    margin: 0 0 .65rem;
    font: 600 clamp(1.25rem, 2.2vw, 1.65rem)/1.15 var(--font-sans);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .featured-title a { color: inherit; }
  .featured-title a:hover { color: var(--accent); }
  .featured-description {
    margin: 0;
    flex: 1;
    color: var(--dim);
    font: 400 .9rem/1.65 var(--font-sans);
  }
  .featured-facts {
    display: grid;
    gap: .65rem;
    margin: 1.15rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .featured-facts div {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: .5rem;
  }
  .featured-facts dt {
    color: var(--dim);
    font: 600 .68rem/1.4 var(--font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .featured-facts dd {
    margin: 0;
    color: var(--fg);
    font-size: .8rem;
    line-height: 1.5;
  }
  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem 1.25rem;
    margin-top: 1.1rem;
  }
  .featured-actions a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 40px;
    color: var(--accent);
    font: .8rem/1.4 var(--font-mono);
  }
  .featured-actions a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .other-work {
    margin-top: 1.4rem;
    color: var(--dim); font-size: .75rem;
  }
  .other-work a { color: var(--fg); }
  .other-work a:hover { color: var(--accent); }
  .see-all {
    display: inline-block; margin-top: 1.2rem;
    font-size: .8rem; color: var(--accent);
  }
  .see-all:hover { color: var(--accent); }

  /* writing */
  .writing-section {
    border-top: 1px solid var(--border);
  }
  .featured-writing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-top: .25rem;
  }
  .writing-card {
    display: flex;
