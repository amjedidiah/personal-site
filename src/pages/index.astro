---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const typeLabel: Record<string, string> = { founder: 'own project', client: 'client work', oss: 'OSS' };
const typeColor: Record<string, string> = { founder: '#58a6ff', client: '#3fb950', oss: '#d2a8ff' };

const clients = [
  { name: 'Fiverr Pro', note: '100+ contractors' },
  { name: 'Remotebase', note: 'cross-border payments' },
  { name: 'GoMyCode', note: '4 cohorts trained' },
  { name: 'Google DevFest', note: 'speaker' },
  { name: 'Andela', note: 'mentor' },
  { name: 'HackerOne', note: 'Stripe program' },
];
---

<Base title="Jedidiah Amaraegbu" fullBleed>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-tag sr">full stack engineer · stripe architect · security researcher</p>
      <h1 class="sr">Jedidiah<br/>Amaraegbu</h1>
      <p class="hero-lede sr">I build payment infrastructure and AI products for complex, high-stakes workflows.</p>
      <div class="hero-actions sr">
        <a class="btn-primary" href="/projects">see selected work</a>
        <a class="btn-ghost" href="mailto:imunacode@gmail.com">start a conversation</a>
      </div>
      <div class="scroll-hint" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <!-- 01 — NOW -->
  <section class="now-section">
    <div class="constrained">
      <div class="section-label sr">
        <span class="section-num">01</span>
        <h2>now</h2>
      </div>
      <div class="now sr">
        Building <a href="/projects/gwela">Gwela</a> (multiplayer AI agent platform), doing security research on Stripe Connect & MCP, applying to YC W27.
      </div>
    </div>
  </section>

  <!-- 02 — FEATURED WORK -->
  <section class="work-section">
    <div class="constrained">
      <div class="section-label sr">
        <span class="section-num">02</span>
        <h2>featured work</h2>
      </div>
      <div class="project-grid sr-stagger">
        {projects.map((p) => (
          <a href={`/projects/${p.id}`} class="project-card" style={`--card-accent: ${typeColor[p.data.type]}`}>
            <div class="card-header">
              <span class="card-type" style={`color: ${typeColor[p.data.type]}`}>{typeLabel[p.data.type]}</span>
              {p.data.order === 1 && <span class="card-live">building now</span>}
            </div>
            <h3 class="card-title">{p.data.title}</h3>
            <p class="card-desc">{p.data.description}</p>
            {p.data.metric && (
              <div class="card-metric">
                <span class="metric-value">{p.data.metric}</span>
              </div>
            )}
            <div class="card-bottom">
              <div class="card-tech">{p.data.tech.slice(0, 4).join(' · ')}</div>
              <span class="card-arrow">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
      <a href="/projects" class="see-all sr">all projects &rarr;</a>
    </div>
  </section>

  <!-- 03 — EXPERIENCE -->
  <section class="clients-section">
    <div class="constrained">
      <div class="section-label sr">
        <span class="section-num">03</span>
        <h2>experience</h2>
      </div>
      <div class="clients-grid sr-stagger">
        {clients.map((c) => (
          <div class="client-item">
            <span class="client-name">{c.name}</span>
            <span class="client-note">{c.note}</span>
          </div>
        ))}
      </div>
      <div class="clients-stats sr">
        <div class="stat">
          <span class="stat-num">6+</span>
          <span class="stat-label">years shipping</span>
        </div>
        <div class="stat">
          <span class="stat-num">200+</span>
          <span class="stat-label">devs mentored</span>
        </div>
        <div class="stat">
          <span class="stat-num">3</span>
          <span class="stat-label">continents</span>
        </div>
        <div class="stat">
          <span class="stat-num">2x</span>
          <span class="stat-label">Stripe certified</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="constrained sr">
      <p class="cta-text">Have a payment, AI, or real-time product problem?</p>
      <a class="btn-primary" href="mailto:imunacode@gmail.com">Let's talk</a>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero {
    min-height: calc(100vh - 3.5rem);
    display: flex; align-items: center;
    position: relative;
    padding: 2rem var(--gutter);
  }
  .hero-inner {
    max-width: var(--max-w); width: 100%;
    margin: 0 auto;
  }
  .hero-tag {
    color: var(--dim); font-size: .8rem;
    margin-bottom: 1.2rem; letter-spacing: .02em;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    line-height: 1.05;
    margin-bottom: 1.4rem;
  }
  .hero-lede {
    font-family: var(--font-sans);
    color: var(--dim); font-size: clamp(.95rem, 2vw, 1.2rem);
    line-height: 1.7; max-width: 48ch;
    margin-bottom: 2.5rem; font-weight: 400;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; }

  /* buttons */
  .btn-primary {
    font-family: var(--font-mono);
    color: var(--bg); background: var(--accent);
    padding: .65em 1.3em; border-radius: 6px;
    font-size: .8rem; font-weight: 600;
    transition: opacity .15s;
  }
  .btn-primary:hover { opacity: .85; color: var(--bg); }
  .btn-ghost {
    font-family: var(--font-mono);
    color: var(--dim); font-size: .8rem;
    padding: .65em 1.3em;
    border: 1px solid var(--border); border-radius: 6px;
    transition: border-color .15s, color .15s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); opacity: 1; }

  /* scroll hint */
  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
  }
  .scroll-hint span {
    display: block; width: 1px; height: 40px;
    background: var(--border);
    animation: pulse-down 2s ease-in-out infinite;
  }
  @keyframes pulse-down {
    0%, 100% { opacity: .2; transform: scaleY(.5); transform-origin: top; }
    50% { opacity: .6; transform: scaleY(1); }
  }

  /* constrained */
  .constrained {
    max-width: var(--max-w); margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* now */
  .now-section {
    padding: 4rem 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .now {
    font-family: var(--font-sans);
    font-size: .95rem; color: var(--dim); line-height: 1.7;
    max-width: 55ch;
  }

  /* work */
  .work-section { padding: 5rem 0 3rem; }

  .project-grid {
    display: grid; grid-template-columns: 1fr;
    gap: 1px; background: var(--border);
    border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden;
  }
  .project-card {
    background: var(--bg);
    padding: 1.6rem 1.8rem;
    display: flex; flex-direction: column;
    color: inherit; position: relative;
    transition: background .2s;
    border-left: 3px solid transparent;
  }
  .project-card:hover {
    background: var(--surface);
    border-left-color: var(--card-accent);
    opacity: 1;
  }
  .card-header {
    display: flex; align-items: center; gap: .6em;
    margin-bottom: .5rem;
  }
  .card-type {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .08em; font-weight: 600;
  }
  .card-live {
    font-size: .6rem; color: var(--bg); background: var(--accent);
    padding: .15em .5em; border-radius: 3px;
    text-transform: uppercase; letter-spacing: .06em; font-weight: 600;
  }
  .card-title {
    font-family: var(--font-sans);
    font-size: 1.15rem; font-weight: 700; color: var(--fg);
    margin-bottom: .4rem; letter-spacing: -.02em;
  }
  .card-desc {
    color: var(--dim); font-size: .8rem; line-height: 1.6;
    max-width: 55ch; flex: 1;
  }
  .card-metric { margin-top: .6rem; }
  .metric-value {
    font-family: var(--font-sans);
    font-size: .7rem; font-weight: 600;
    color: var(--accent); opacity: .8;
    text-transform: uppercase; letter-spacing: .04em;
  }
  .card-bottom {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: .8rem;
  }
  .card-tech { color: var(--dim); font-size: .7rem; opacity: .6; }
  .card-arrow {
    color: var(--accent); font-size: .85rem;
    opacity: 0; transform: translateX(-4px);
    transition: opacity .2s, transform .2s;
  }
  .project-card:hover .card-arrow { opacity: 1; transform: translateX(0); }

  .see-all {
    display: inline-block; margin-top: 1.2rem;
    font-size: .8rem; color: var(--dim);
  }
  .see-all:hover { color: var(--accent); }

  /* clients / experience */
  .clients-section {
    padding: 5rem 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .clients-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .client-item {
    padding: .9rem 0;
    border-bottom: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: baseline;
    gap: .5rem;
  }
  .client-name {
    font-family: var(--font-sans);
    font-size: .85rem; font-weight: 600; color: var(--fg);
  }
  .client-note {
    font-size: .7rem; color: var(--dim); opacity: .7;
    text-align: right;
  }
  .clients-grid .client-item:nth-child(odd) { padding-right: 1.5rem; }
  .clients-grid .client-item:nth-child(even) { padding-left: 1.5rem; border-left: 1px solid var(--border); }

  .clients-stats {
    display: flex; flex-wrap: wrap; gap: 2rem;
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .stat { display: flex; flex-direction: column; }
  .stat-num {
    font-family: var(--font-sans);
    font-size: 1.6rem; font-weight: 700; color: var(--fg);
    letter-spacing: -.03em; line-height: 1.1;
  }
  .stat-label {
    font-size: .7rem; color: var(--dim);
    margin-top: .15rem; text-transform: uppercase;
    letter-spacing: .06em;
  }

  /* cta */
  .cta-section { padding: 5rem 0; }
  .cta-section .constrained {
    text-align: center;
    display: flex; flex-direction: column;
    align-items: center; gap: 1.5rem;
  }
  .cta-text {
    font-family: var(--font-sans);
    color: var(--dim); font-size: 1rem; max-width: 28ch;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .project-grid { grid-template-columns: 1fr 1fr; }
    .project-card { padding: 1.8rem 2rem; }
    .clients-grid { grid-template-columns: repeat(3, 1fr); }
    .clients-grid .client-item:nth-child(odd) { padding-right: 0; }
    .clients-grid .client-item:nth-child(even) { padding-left: 0; border-left: none; }
    .clients-grid .client-item { padding: .9rem 1rem; }
    .clients-grid .client-item:nth-child(3n+2),
    .clients-grid .client-item:nth-child(3n) {
      border-left: 1px solid var(--border); padding-left: 1.5rem;
    }
  }

  @media (min-width: 960px) {
    .project-grid { grid-template-columns: repeat(3, 1fr); }
    .project-card { padding: 2rem 2.2rem; }
    .clients-stats { gap: 3rem; }
    .stat-num { font-size: 2rem; }
  }

  @media (max-width: 400px) {
    .hero { min-height: calc(100svh - 3.5rem); }
    .project-card { padding: 1.2rem 1rem; }
    .scroll-hint { display: none; }
    .clients-grid { grid-template-columns: 1fr; }
    .clients-grid .client-item:nth-child(even) { padding-left: 0; border-left: none; }
    .clients-stats { gap: 1.5rem; }
  }
</style>
