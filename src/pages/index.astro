</style>

<script>
  import { currentIssueUrls, parseAvailabilityIssue } from '../lib/current-feed';

  const contactPrimaryLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-contact-primary]'),
  );
  if (contactPrimaryLinks.length) {
    const mobileBreakpoint = window.matchMedia('(max-width: 639px)');
    const updateContactPrimaryLinks = () => {
      const isMobile = mobileBreakpoint.matches;
      contactPrimaryLinks.forEach((link) => {
        link.href = isMobile
          ? link.dataset.whatsappHref ?? link.href
          : link.dataset.emailHref ?? link.href;
        const channel = isMobile ? 'WhatsApp' : 'email';
        if (link.classList.contains('hero-contact')) {
          link.setAttribute('aria-label', `Discuss a payment project via ${channel}`);
        } else {
          link.setAttribute('aria-label', `Start a conversation via ${channel}`);
        }
        const emailLabel = link.dataset.emailLabel;
        const whatsappLabel = link.dataset.whatsappLabel;
        if (emailLabel && whatsappLabel) {
          link.textContent = isMobile ? whatsappLabel : emailLabel;
        }
        if (isMobile) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        } else {
          link.removeAttribute('target');
          link.removeAttribute('rel');
        }
      });
    };
    updateContactPrimaryLinks();
    mobileBreakpoint.addEventListener('change', updateContactPrimaryLinks);
  }

  type FeedResult<T> =
    | { kind: 'data'; value: T; raw: unknown }
    | { kind: 'empty' }
    | { kind: 'error' }
    | { kind: 'rate-limited'; retryAt: number };

  type CachedIssue = { savedAt: number; raw: unknown };
  type FeedCache = { availability?: CachedIssue; retryAt?: number };
  const cacheKey = 'jed-current-feed-v1';
  const refreshInterval = 5 * 60 * 1000;

  async function readIssue<T>(url: string, parse: (value: unknown) => T | null): Promise<FeedResult<T>> {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(url, {
        headers: { Accept: 'application/vnd.github+json' },
        cache: 'no-store',
        signal: controller.signal,
      });
      if (response.status === 404) return { kind: 'empty' };
      if (response.status === 403 || response.status === 429) {
        const reset = Number(response.headers.get('x-ratelimit-reset')) * 1000;
        const retryAfter = Number(response.headers.get('retry-after')) * 1000;
        return {
          kind: 'rate-limited',
          retryAt: reset > Date.now() ? reset + 1000 : Date.now() + (retryAfter > 0 ? retryAfter : refreshInterval),
        };
      }
      if (!response.ok) return { kind: 'error' };
      const raw = await response.json();
      const value = parse(raw);
      return value ? { kind: 'data', value, raw } : { kind: 'empty' };
    } catch {
      return { kind: 'error' };
    } finally {
      window.clearTimeout(timeout);
    }
  }

  const signals = document.querySelector<HTMLElement>('[data-current-signals]');
  const availability = signals?.querySelector<HTMLElement>('[data-current-availability]');
  const availabilityLabel = signals?.querySelector<HTMLElement>('[data-current-availability-label]');
  const availabilityDetail = signals?.querySelector<HTMLElement>('[data-current-availability-detail]');
  const status = document.querySelector<HTMLElement>('[data-current-status]');

  if (availability && availabilityLabel && availabilityDetail && status) {
    const fallbackStatus = status.textContent?.trim() ?? 'Status last reviewed';
    const checkFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    const cache: FeedCache = (() => {
      try {
        const stored = JSON.parse(localStorage.getItem(cacheKey) ?? 'null');
        return stored && typeof stored === 'object' ? stored as FeedCache : {};
      } catch { return {}; }
    })();
    const saveCache = () => {
      try { localStorage.setItem(cacheKey, JSON.stringify(cache)); } catch { /* Storage is optional. */ }
    };
    const cachedValue = <T,>(entry: CachedIssue | undefined, parse: (raw: unknown) => T | null): T | null => {
      if (!entry || typeof entry.savedAt !== 'number' || Date.now() - entry.savedAt > 60 * 60 * 1000) return null;
      return parse(entry.raw);
    };
    const showAvailability = (value: NonNullable<ReturnType<typeof parseAvailabilityIssue>>) => {
      availability.dataset.available = String(value.available);
      availabilityLabel.textContent = value.label;
      availabilityDetail.textContent = value.detail;
    };
    let pending = false;
    let checked = false;
    let lastCheck = 0;
    let lastKnownStatus = fallbackStatus;

    const savedAvailability = cachedValue(cache.availability, parseAvailabilityIssue);
    if (savedAvailability && cache.availability) {
      showAvailability(savedAvailability);
      lastCheck = cache.availability.savedAt;
      lastKnownStatus = `Last synced ${checkFormat.format(new Date(lastCheck))}`;
      status.dataset.state = 'cached';
      status.textContent = lastKnownStatus;
      checked = true;
    }

    const refresh = async () => {
      if (pending || (cache.retryAt && Date.now() < cache.retryAt)) return;
      pending = true;
      lastCheck = Date.now();
      if (!checked) {
        status.dataset.state = 'loading';
        status.textContent = 'Checking current status...';
      }

      const availabilityResult = await readIssue(currentIssueUrls.availability, parseAvailabilityIssue);

      if (availabilityResult.kind === 'data') {
        showAvailability(availabilityResult.value);
        cache.availability = { savedAt: Date.now(), raw: availabilityResult.raw };
      } else if (availabilityResult.kind === 'empty') {
        availability.dataset.available = 'false';
        availabilityLabel.textContent = 'Availability not published';
        availabilityDetail.textContent = 'Please email to ask about timing.';
        delete cache.availability;
      }

      cache.retryAt = availabilityResult.kind === 'rate-limited' ? availabilityResult.retryAt : 0;
      saveCache();
      const failed = availabilityResult.kind === 'error' || availabilityResult.kind === 'rate-limited';
      status.dataset.state = failed ? 'error' : 'data';
      if (!failed) lastKnownStatus = `Last synced ${checkFormat.format(new Date())}`;
      status.textContent = failed
        ? `Unable to refresh live status. ${lastKnownStatus}`
        : `Live status checked ${checkFormat.format(new Date())}`;
      checked = true;
      pending = false;
    };

    if (cache.retryAt && Date.now() < cache.retryAt) {
      status.dataset.state = 'error';
      status.textContent = `Unable to refresh live status. ${lastKnownStatus}`;
    } else if (!savedAvailability || Date.now() - lastCheck >= refreshInterval) {
      void refresh();
    }
    window.setInterval(() => {
      if (document.visibilityState === 'visible' && Date.now() - lastCheck >= refreshInterval) void refresh();
    }, 60 * 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - lastCheck >= refreshInterval) void refresh();
    });
  }
</script>
