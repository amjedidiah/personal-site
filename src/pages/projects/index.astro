---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const typeLabel: Record<string, string> = { founder: 'own project', client: 'client work', oss: 'OSS contributor' };
const typeColor: Record<string, string> = {
  founder: 'var(--project-founder)',
  client: 'var(--project-client)',
  oss: 'var(--project-oss)',
};
---

<Base title="Projects — Jedidiah Amaraegbu" description="Selected projects: AI agents, fintech, security tools, and open source.">
  <header class="sr">
    <h1>Projects</h1>
    <p class="sub">Systems I’ve built, shipped, and helped scale.</p>
  </header>

  <nav class="project-filters sr" aria-label="Filter projects by type">
    <button type="button" data-project-filter="all" aria-pressed="true">all</button>
    <button type="button" data-project-filter="founder" aria-pressed="false">founder</button>
    <button type="button" data-project-filter="client" aria-pressed="false">client</button>
    <button type="button" data-project-filter="oss" aria-pressed="false">OSS</button>
    <span class="project-count" data-project-count>{allProjects.length} projects</span>
  </nav>

  <div class="grid sr-stagger">
    {allProjects.map((p, index) => (
      <a href={`/projects/${p.id}`} class:list={['card', { 'card--lead': index === 0 }]} data-project-type={p.data.type} style={`--card-accent: ${typeColor[p.data.type]}`}>
        <div class="card-head">
          <span class="card-type" style={`color: ${typeColor[p.data.type]}`}>{typeLabel[p.data.type]}</span>
          {p.data.featured && <span class="card-feat">featured</span>}
        </div>
        <h3 class="card-name">{p.data.title}</h3>
        <div class="card-desc">{p.data.description}</div>
        {p.data.metric && (
          <div class="card-metric">
            <span class="metric-value">{p.data.metric}</span>
          </div>
        )}
        <div class="card-bottom">
          <div class="card-tech">{p.data.tech.join(' · ')}</div>
          <span class="card-arrow">&rarr;</span>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  header { margin-bottom: 2.5rem; }
  .sub { color: var(--dim); font-size: .85rem; margin-top: .3em; }
  .project-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem .55rem;
    margin: -1rem 0 1.5rem;
  }
  .project-filters button {
    min-height: 32px;
    padding: .35rem .65rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: var(--dim);
    font: .7rem/1 var(--font-mono);
    cursor: pointer;
  }
  .project-filters button:hover,
  .project-filters button[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .project-filters button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .project-count {
    margin-inline-start: auto;
    color: var(--dim);
    font: .68rem/1.3 var(--font-mono);
  }

  .grid {
    display: grid;
    gap: 1rem;
  }
  .card[hidden] { display: none; }
  .card {
    background: var(--bg); padding: 1.25rem 1.4rem;
    display: flex; flex-direction: column;
    color: inherit; transition: background .2s;
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
  }
  .card:hover {
    background: var(--surface); opacity: 1;
    border-left-color: var(--card-accent);
  }
  .card--lead {
    padding: 1.75rem 2rem;
    border-top: 2px solid var(--card-accent);
  }
  .card--lead .card-name { font-size: 1.5rem; }
  .card-head {
    display: flex; align-items: center; gap: .5em;
    margin-bottom: .5rem;
  }
  .card-type {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .08em; font-weight: 600;
  }
  .card-feat {
    font-size: .55rem; color: var(--dim); opacity: .5;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .card-name {
    font-weight: 700; color: var(--fg); font-size: 1rem;
    margin-bottom: .3rem; letter-spacing: -.02em;
  }
  .card-desc { color: var(--dim); font-size: .8rem; line-height: 1.6; flex: 1; }
  .card-metric { margin-top: .5rem; }
  .metric-value {
    font-family: var(--font-sans);
    font-size: .7rem; font-weight: 600;
    color: var(--accent); opacity: .8;
    text-transform: uppercase; letter-spacing: .04em;
  }
  .card-bottom {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: .8rem;
  }
  .card-tech { color: var(--dim); font-size: .7rem; opacity: .5; }
  .card-arrow {
    color: var(--card-accent); font-size: .85rem;
    opacity: 0; transform: translateX(-4px);
    transition: opacity .2s, transform .2s;
  }
  .card:hover .card-arrow { opacity: 1; transform: translateX(0); }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) {
    .card--lead { padding: 1.25rem 1rem; }
    .card--lead .card-name { font-size: 1rem; }
  }
  @media (max-width: 400px) { .card { padding: 1.2rem 1rem; } }
</style>

<script>
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-type]'));
  const projectFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const projectCount = document.querySelector<HTMLElement>('[data-project-count]');

  const setProjectFilter = (type: string) => {
    let visible = 0;
    projectCards.forEach((card) => {
      const matches = type === 'all' || card.dataset.projectType === type;
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    projectFilters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === type));
    });
    if (projectCount) projectCount.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
  };

  projectFilters.forEach((button) => {
    button.addEventListener('click', () => setProjectFilter(button.dataset.projectFilter ?? 'all'));
  });
</script>
