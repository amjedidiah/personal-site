---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import { formatProjectScope } from '../../data/project-scope';
import ListingPageControls from '../../components/ListingPageControls.astro';
import ListingPageIntro from '../../components/ListingPageIntro.astro';
import ProjectExplore from '../../components/ProjectExplore.astro';
import ListingTimelineYear from '../../components/ListingTimelineYear.astro';
import ProjectTimelineCard from '../../components/ProjectTimelineCard.astro';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const numberedProjects = allProjects.map((project, index) => ({ project, number: String(index + 1).padStart(2, '0') }));
const typeLabel: Record<string, string> = { founder: 'independent build', client: 'client work', oss: 'OSS contributor' };
const typeColor: Record<string, string> = {
  founder: 'var(--project-founder)',
  client: 'var(--project-client)',
  oss: 'var(--project-oss)',
};

const projectsByYear = new Map<number, typeof numberedProjects>();
for (const entry of numberedProjects) {
  const year = Number(entry.project.data.dateStart.slice(0, 4));
  if (!projectsByYear.has(year)) projectsByYear.set(year, []);
  projectsByYear.get(year)!.push(entry);
}
for (const entries of projectsByYear.values()) {
  entries.sort((a, b) => b.project.data.dateStart.localeCompare(a.project.data.dateStart) || a.project.data.order - b.project.data.order);
}
const timelineYears = Array.from(projectsByYear.keys()).sort((a, b) => b - a);

const letterForTitle = (title: string) => {
  const match = title.match(/[A-Za-z0-9]/);
  return match ? match[0].toUpperCase() : '#';
};

const projectsByLetter = new Map<string, typeof numberedProjects>();
for (const entry of [...numberedProjects].sort((a, b) =>
  a.project.data.title.localeCompare(b.project.data.title, undefined, { sensitivity: 'base' }),
)) {
  const letter = letterForTitle(entry.project.data.title);
  if (!projectsByLetter.has(letter)) projectsByLetter.set(letter, []);
  projectsByLetter.get(letter)!.push(entry);
}
const letterKeys = Array.from(projectsByLetter.keys()).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

const exploreProjects = numberedProjects.map(({ project }) => ({
  id: project.id,
  title: project.data.title,
  description: project.data.description,
  type: project.data.type,
  typeLabel: typeLabel[project.data.type],
  scope: formatProjectScope(project.data),
  href: `/projects/${project.id}`,
  platforms: project.data.platforms.join(' '),
  yearStart: Number(project.data.dateStart.slice(0, 4)),
}));

const projectAttrs = (project: (typeof numberedProjects)[number]['project']) => ({
  type: project.data.type,
  platforms: project.data.platforms.join(' '),
  href: `/projects/${project.id}`,
  sortTitle: project.data.title,
});
---

<Base title="Projects — Jedidiah Amaraegbu" description="Selected projects across collaborative AI, payments, open source, mobile apps, and client platforms.">
  <div class:list={['projects-page', { 'is-empty': allProjects.length === 0 }]} data-view="timeline">
    <ListingPageIntro title="Projects" description="Selected products, client work, and open-source contributions." />
    {allProjects.length > 0 && (
      <ListingPageControls>
        <nav slot="toolbar" class="year-nav" aria-label="Jump to year">
          {timelineYears.map((year) => (
            <a href={`#year-${year}`}>{year}</a>
          ))}
        </nav>
        <nav slot="toolbar" class="list-sort-nav" aria-label="Sort projects">
          <span class="sort-label" aria-hidden="true">Sort</span>
          <div class="sort-options" role="group" aria-label="Sort direction">
            <button type="button" data-list-sort="asc" aria-pressed="true">A–Z</button>
            <button type="button" data-list-sort="desc" aria-pressed="false">Z–A</button>
          </div>
        </nav>
        <div slot="actions" class="view-switch" role="group" aria-label="Projects view" hidden>
          <button type="button" data-view-choice="timeline" aria-controls="projects-archive-timeline projects-archive-list" aria-pressed="true">Timeline</button>
          <button type="button" data-view-choice="list" aria-controls="projects-archive-timeline projects-archive-list" aria-pressed="false">List</button>
          <button type="button" data-view-choice="explore" aria-controls="projects-explore" aria-pressed="false">Explore</button>
        </div>
        <div slot="filters" class="project-filters listing-filter-grid listing-filter-nav" role="group" aria-label="Project filters" hidden>
          <div class="filter-group" role="group" aria-label="Filter by type">
            <span class="filter-label" aria-hidden="true">Type</span>
            <div class="filter-options">
              <button type="button" data-project-filter="all" aria-pressed="true">all</button>
              <button type="button" data-project-filter="founder" aria-pressed="false">independent</button>
              <button type="button" data-project-filter="client" aria-pressed="false">client</button>
              <button type="button" data-project-filter="oss" aria-pressed="false">OSS</button>
            </div>
          </div>
          <div class="filter-group" role="group" aria-label="Filter by platform">
            <span class="filter-label" aria-hidden="true">Platform</span>
            <div class="filter-options">
              <button type="button" data-platform-filter="all" aria-pressed="true">all</button>
              <button type="button" data-platform-filter="web" aria-pressed="false">web</button>
              <button type="button" data-platform-filter="mobile" aria-pressed="false">mobile</button>
            </div>
          </div>
          <span class="project-count listing-filter-count" data-project-count aria-live="polite">{allProjects.length} projects</span>
        </div>
      </ListingPageControls>
    )}
    <script is:inline>
      (() => {
        const root = document.currentScript?.parentElement;
        if (!root) return;
        const mobile = window.matchMedia('(max-width: 639px)').matches;
        let saved;
        try {
          saved = window.localStorage.getItem(mobile ? 'amjed-projects-view-mobile' : 'amjed-projects-view-desktop');
        } catch {
          // Browsing still works when storage is unavailable.
        }
        const yearHash = /^#year-\d+$/.test(window.location.hash);
        let view = saved === 'timeline' || saved === 'list' || saved === 'explore' ? saved : mobile ? 'list' : 'timeline';
        if (yearHash) view = 'timeline';
        root.dataset.view = view;
        root.querySelectorAll('[data-view-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.viewChoice === view));
        });
        const params = new URLSearchParams(window.location.search);
        const type = params.get('type');
        const platform = params.get('platform');
        const typeIds = new Set(['all', ...Array.from(root.querySelectorAll('[data-project-filter]'), (button) => button.dataset.projectFilter)]);
        const platformIds = new Set(['all', ...Array.from(root.querySelectorAll('[data-platform-filter]'), (button) => button.dataset.platformFilter)]);
        root.dataset.filterType = type && typeIds.has(type) ? type : 'all';
        root.dataset.filterPlatform = platform && platformIds.has(platform) ? platform : 'all';
        root.querySelectorAll('[data-project-filter]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.projectFilter === root.dataset.filterType));
        });
        root.querySelectorAll('[data-platform-filter]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.platformFilter === root.dataset.filterPlatform));
        });
        root.querySelector('.view-switch')?.removeAttribute('hidden');
        root.querySelector('.project-filters')?.removeAttribute('hidden');
      })();
    </script>

    <div class="listing-results" data-listing-results>
    {allProjects.length === 0 && (
      <div class="project-empty" role="status">
        <p>No projects published yet.</p>
        <span>New work will appear here when it is ready.</span>
      </div>
    )}
    {allProjects.length > 0 && (
      <div class="filter-empty" role="status" hidden>
        <p>No projects match these filters.</p>
        <span>Try another type or platform, or browse all projects.</span>
        <button type="button" data-clear-project-filter>Show all projects</button>
      </div>
    )}

    <div class="timeline year-timeline" id="projects-archive-timeline">
      {timelineYears.map((year) => (
        <ListingTimelineYear year={year} entriesClass="year-posts">
          {projectsByYear.get(year)!.map(({ project }) => (
            <ProjectTimelineCard project={project} typeColor={typeColor[project.data.type]} />
          ))}
        </ListingTimelineYear>
      ))}
    </div>

    <div class="list-archive" id="projects-archive-list">
      {letterKeys.map((letter) => (
        <section class="letter-group" aria-labelledby={`letter-${letter}`}>
          <h2 id={`letter-${letter}`} class="letter-label">{letter}</h2>
          <ol class="letter-projects">
            {projectsByLetter.get(letter)!.map(({ project }) => {
              const attrs = projectAttrs(project);
              return (
                <li
                  class="project-list-item"
                  data-project-type={attrs.type}
                  data-project-platforms={attrs.platforms}
                  data-project-href={attrs.href}
                  data-sort-title={attrs.sortTitle}
                >
                  <a href={attrs.href} class="project-row" aria-labelledby={`list-${project.id}-title`}>
                    <span class="project-row-meta">
                      <span style={`color: ${typeColor[project.data.type]}`}>{typeLabel[project.data.type]}</span>
                      <span>{formatProjectScope(project.data)}</span>
                    </span>
                    <span class="project-row-copy">
                      <span class="project-row-title" id={`list-${project.id}-title`}>{project.data.title}</span>
                      {project.data.description && <span class="project-row-desc">{project.data.description}</span>}
                    </span>
                    <span class="view-cue">View project <ArrowRight size={16} strokeWidth={1.8} aria-hidden="true" /></span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>

    <div class="explore-panel" id="projects-explore">
      <ProjectExplore projects={exploreProjects} />
    </div>
    </div>
  </div>
</Base>

<style>
  :global(#main-content) { width: 100%; }
  .projects-page {
    width: 100%;
    min-width: 0;
    --year-sticky-top: 17.5rem;
    --project-muted: color-mix(in srgb, var(--dim) 65%, var(--fg));
    --listing-muted: var(--project-muted);
  }
  .projects-page.is-empty .header-controls,
  .projects-page.is-empty .timeline,
  .projects-page.is-empty .list-archive,
  .projects-page.is-empty .explore-panel,
  .projects-page.is-empty[data-view="explore"] .explore-panel { display: none; }
  .list-archive { display: none; }
  .projects-page[data-view="list"] .timeline { display: none; }
  .projects-page[data-view="list"] .list-archive { display: block; }
  .projects-page[data-view="list"] .year-nav { display: none; }
  .projects-page[data-view="list"] .list-sort-nav { display: flex; }
  .projects-page[data-view="explore"] .timeline,
  .projects-page[data-view="explore"] .list-archive { display: none; }
  .projects-page[data-view="explore"] .list-sort-nav { display: none; }
  .projects-page[data-view="explore"]:not(.is-filter-empty) .explore-panel { display: block; }
  .projects-page.is-filter-empty .explore-panel { display: none; }

  .project-empty { padding: 2rem 0 3rem; border-top: 1px solid var(--border); }
  .filter-empty { padding: 0 0 3rem; }
  .project-empty p, .filter-empty p { color: var(--fg); font: 600 1.1rem/1.4 var(--font-sans); }
  .project-empty span { display: block; margin-top: .3rem; color: var(--project-muted); font-size: .85rem; }
  .filter-empty span { display: block; margin-top: .4rem; color: var(--project-muted); font-size: .85rem; }
  .filter-empty[hidden],
  .projects-page:not(.is-filter-empty) .filter-empty { display: none; }
  .filter-empty button { min-height: 44px; margin-top: .75rem; padding: .5rem 0; border: 0; background: transparent; color: var(--accent); font: 600 .85rem/1.4 var(--font-sans); cursor: pointer; }
  .filter-empty button:hover { text-decoration: underline; text-underline-offset: .2em; }
  .filter-empty button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .timeline-item[hidden] { display: none; }
  .projects-page :global(#projects-archive-timeline .timeline-entry.project-entry) {
    border-bottom: 1px solid var(--border);
  }
  .projects-page :global(
      #projects-archive-timeline .timeline-item:not([hidden]):not(:has(~ .timeline-item:not([hidden])))
        .timeline-entry.project-entry
    ) {
    border-bottom: 0;
  }
  .projects-page .timeline-entry-action {
    color: var(--accent);
    opacity: 1;
  }

  .projects-page[data-view="list"] .list-archive { max-width: 780px; }
  .projects-page .letter-group[hidden] { display: none !important; }
  .projects-page[data-view="list"] .letter-group { display: block; margin-bottom: 1.8rem; }
  .projects-page[data-view="list"] .letter-label {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--project-muted);
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    background: var(--bg);
  }
  .projects-page[data-view="list"] .letter-projects {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .project-list-item { position: relative; }
  .project-list-item[hidden] { display: none; }
  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .3rem .75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
  }
  .project-list-item:last-child .project-row { border-bottom: 0; }
  .project-row-meta {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .75rem;
    color: var(--project-muted);
    font: .68rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .project-row-copy { grid-column: 1 / -1; grid-row: 2; display: grid; gap: .25rem; min-width: 0; }
  .project-row-title {
    color: var(--fg);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.018em;
    text-wrap: pretty;
    transition: color .2s;
  }
  .project-row:hover .project-row-title,
  .project-row:focus-visible .project-row-title { color: var(--accent); }
  .project-row-desc {
    max-width: 64ch;
    color: var(--fg);
    opacity: .75;
    font-size: .8rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .project-row .view-cue { grid-column: 2; grid-row: 1; align-self: start; padding-top: .05rem; }

  .projects-page[data-view="list"] .timeline-item::before { display: none; }
  .view-cue { display: inline-flex; align-items: center; gap: .3rem; color: var(--accent); font: .74rem/1.4 var(--font-mono); white-space: nowrap; }
  .view-cue :global(svg) { transition: transform .2s ease; }
</style>

<script>
  import { dispatchListingViewChange, initListingHeaderCollapse } from '../../lib/listing-header-collapse';
  import { initListingTimelineYearSpy } from '../../lib/listing-timeline-year-spy';
  import { focusListingRecovery, transitionListing } from '../../lib/listing-transition';

  const projectNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-project-type]'));
  const projectFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const platformFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-platform-filter]'));
  const projectCount = document.querySelector<HTMLElement>('[data-project-count]');
  const filterEmpty = document.querySelector<HTMLElement>('.filter-empty');
  const projectsPage = document.querySelector<HTMLElement>('.projects-page');
  const yearGroups = Array.from(document.querySelectorAll<HTMLElement>('.year-group'));
  const letterGroups = Array.from(document.querySelectorAll<HTMLElement>('.letter-group'));
  const listArchive = document.getElementById('projects-archive-list');
  const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-list-sort]'));
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view-choice]'));
  const validTypes = new Set(projectFilters.map((button) => button.dataset.projectFilter));
  const validPlatforms = new Set(platformFilters.map((button) => button.dataset.platformFilter));
  const mobileView = window.matchMedia('(max-width: 639px)');
  let activeType = projectsPage?.dataset.filterType ?? 'all';
  let activePlatform = projectsPage?.dataset.filterPlatform ?? 'all';

  const isYearHash = (hash = window.location.hash) => /^#year-\d+$/.test(hash);

  const clearYearHashFromUrl = () => {
    if (!isYearHash()) return;
    const url = new URL(window.location.href);
    url.hash = '';
    window.history.replaceState({}, '', url);
  };

  const syncYearHashAfterFilters = () => {
    if (projectsPage?.dataset.view !== 'timeline') {
      clearYearHashFromUrl();
      return;
    }
    const visibleGroups = yearGroups.filter((group) => !group.hidden);
    if (!visibleGroups.length) {
      clearYearHashFromUrl();
      return;
    }
    const hash = window.location.hash;
    if (!isYearHash(hash)) {
      yearSpy?.requestActiveYearUpdate();
      return;
    }
    let targetGroup = visibleGroups[0];
    if (isYearHash(hash)) {
      const group = document.querySelector<HTMLElement>(hash)?.closest<HTMLElement>('.year-group');
      if (group && !group.hidden) targetGroup = group;
    }
    const yearId = targetGroup.querySelector<HTMLElement>('.year-label')?.id;
    if (!yearId) return;
    const newHash = `#${yearId}`;
    const url = new URL(window.location.href);
    if (url.hash !== newHash) {
      url.hash = newHash;
      window.history.replaceState({}, '', url);
    }
    window.requestAnimationFrame(() => {
      document.getElementById(yearId)?.scrollIntoView({ block: 'start' });
      yearSpy?.requestActiveYearUpdate();
    });
  };

  const reconcileYearDeepLink = () => {
    if (!isYearHash() || !projectsPage) return;
    projectsPage.dataset.view = 'timeline';
    viewButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.viewChoice === 'timeline'));
    });
    syncViewHighlight();
  };

  const yearSpy = initListingTimelineYearSpy({
    listingRoot: '.projects-page',
    viewsToSkip: ['list', 'explore'],
    exploreJumpEvent: 'projectexploreyear',
    exploreSelectJumpEvent: 'projectexploreselectyear',
  });

  const buildProjectsSummary = () => {
    const parts: string[] = [];
    const view = projectsPage?.dataset.view ?? 'timeline';
    if (view === 'list') {
      const sort = sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true');
      parts.push(sort?.textContent?.trim() ?? 'A–Z');
    } else {
      const year = document.querySelector<HTMLAnchorElement>('.projects-page .year-nav a.is-active')?.textContent?.trim();
      if (year) parts.push(year);
    }
    const typeBtn = projectFilters.find((button) => button.getAttribute('aria-pressed') === 'true');
    if (typeBtn && typeBtn.dataset.projectFilter !== 'all') {
      parts.push(typeBtn.textContent?.trim() ?? '');
    }
    const platformBtn = platformFilters.find((button) => button.getAttribute('aria-pressed') === 'true');
    if (platformBtn && platformBtn.dataset.platformFilter !== 'all') {
      parts.push(platformBtn.textContent?.trim() ?? '');
    }
    const count = projectCount?.textContent?.trim();
    if (count) parts.push(count);
    return parts.filter(Boolean).join(' · ');
  };

  const headerCollapse = initListingHeaderCollapse({
    listingRoot: '.projects-page',
    getSummary: buildProjectsSummary,
  });

  const countVisibleProjects = () => new Set(
    projectNodes
      .filter((node) => !node.hidden)
      .map((node) => node.dataset.projectHref ?? node.querySelector<HTMLAnchorElement>('a')?.getAttribute('href') ?? '')
      .filter(Boolean),
  ).size;

  const readListSort = () => {
    try {
      const saved = window.localStorage.getItem('amjed-projects-list-sort');
      if (saved === 'asc' || saved === 'desc') return saved;
    } catch {
      // Keep the default sort when storage is unavailable.
    }
    return 'asc';
  };

  const applyListSort = (direction: 'asc' | 'desc') => {
    if (!listArchive) return;
    const groups = Array.from(listArchive.querySelectorAll<HTMLElement>('.letter-group'));
    groups.sort((a, b) => {
      const left = a.querySelector<HTMLElement>('.letter-label')?.textContent?.trim() ?? '';
      const right = b.querySelector<HTMLElement>('.letter-label')?.textContent?.trim() ?? '';
      return direction === 'asc'
        ? left.localeCompare(right, undefined, { sensitivity: 'base' })
        : right.localeCompare(left, undefined, { sensitivity: 'base' });
    });
    groups.forEach((group) => {
      const list = group.querySelector<HTMLElement>('.letter-projects');
      const items = Array.from(group.querySelectorAll<HTMLElement>('.project-list-item'));
      items.sort((a, b) => {
        const left = a.dataset.sortTitle ?? '';
        const right = b.dataset.sortTitle ?? '';
        return direction === 'asc'
          ? left.localeCompare(right, undefined, { sensitivity: 'base' })
          : right.localeCompare(left, undefined, { sensitivity: 'base' });
      });
      items.forEach((item) => list?.appendChild(item));
      listArchive.appendChild(group);
    });
  };

  const syncSortHighlight = () => {
    const active = sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true');
    const switcher = active?.parentElement;
    if (!active || !switcher) return;
    switcher.style.setProperty('--sort-highlight-width', `${active.offsetWidth}px`);
    switcher.style.setProperty('--sort-highlight-offset', `${active.offsetLeft - 3}px`);
  };

  const setListSort = (direction: 'asc' | 'desc', remember = false) => {
    sortButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.listSort === direction));
    });
    syncSortHighlight();
    applyListSort(direction);
    if (remember) {
      try {
        window.localStorage.setItem('amjed-projects-list-sort', direction);
      } catch {
        // The current sort still works without storage.
      }
    }
  };

  const syncViewHighlight = () => {
    const active = viewButtons.find((button) => button.getAttribute('aria-pressed') === 'true');
    const switcher = active?.parentElement;
    if (!active || !switcher) return;
    switcher.style.setProperty('--view-highlight-width', `${active.offsetWidth}px`);
    switcher.style.setProperty('--view-highlight-offset', `${active.offsetLeft - 3}px`);
  };

  const readView = () => {
    let saved: string | null = null;
    try {
      saved = window.localStorage.getItem(mobileView.matches ? 'amjed-projects-view-mobile' : 'amjed-projects-view-desktop');
    } catch {
      // Keep the responsive default if storage is unavailable.
    }
    return saved === 'timeline' || saved === 'list' || saved === 'explore'
      ? saved
      : mobileView.matches ? 'list' : 'timeline';
  };

  const setProjectFilters = (type: string, platform: string, updateUrl = false) => {
    activeType = validTypes.has(type) ? type : 'all';
    activePlatform = validPlatforms.has(platform) ? platform : 'all';
    if (projectsPage) {
      projectsPage.dataset.filterType = activeType;
      projectsPage.dataset.filterPlatform = activePlatform;
    }
    projectNodes.forEach((node) => {
      const matchesType = activeType === 'all' || node.dataset.projectType === activeType;
      const matchesPlatform = activePlatform === 'all' || node.dataset.projectPlatforms?.split(' ').includes(activePlatform);
      node.hidden = !(matchesType && matchesPlatform);
    });
    projectFilters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === activeType));
    });
    platformFilters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.platformFilter === activePlatform));
    });
    const syncGroupVisibility = (groups: HTMLElement[]) => {
      groups.forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-project-type]'))
          .some((node) => !node.hidden);
      });
    };
    syncGroupVisibility(yearGroups);
    syncGroupVisibility(letterGroups);
    yearSpy?.updateYearLinkDisabledState((hash) => {
      const yearGroup = document.querySelector<HTMLElement>(hash)?.closest<HTMLElement>('.year-group');
      return Boolean(yearGroup?.hidden);
    });
    const visibleCount = countVisibleProjects();
    const noMatches = visibleCount === 0;
    if (projectsPage) projectsPage.classList.toggle('is-filter-empty', noMatches);
    if (projectCount) projectCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'project' : 'projects'}`;
    if (filterEmpty) filterEmpty.hidden = !noMatches;
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (activeType === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', activeType);
      if (activePlatform === 'all') url.searchParams.delete('platform');
      else url.searchParams.set('platform', activePlatform);
      window.history.pushState({}, '', url);
    }
    if (projectsPage?.dataset.view === 'explore') yearSpy?.activateLatestVisibleYear();
    if (projectsPage?.dataset.view === 'list') setListSort(readListSort());
    projectsPage?.dispatchEvent(new CustomEvent('projectfilterchange', { detail: { type: activeType, platform: activePlatform } }));
    syncYearHashAfterFilters();
    headerCollapse?.refreshSummary();
  };

  const setView = (view: 'timeline' | 'list' | 'explore', remember = false, preservePosition = false) => {
    if (!projectsPage) return;
    const changingExplore = view === 'explore' || projectsPage.dataset.view === 'explore';
    const anchor = !changingExplore && preservePosition && window.scrollY > 200
      ? Array.from(document.querySelectorAll<HTMLElement>('.list-card, .project-list-item')).find(
          (item) => !item.hidden && item.getBoundingClientRect().bottom > 80,
        )
      : undefined;
    const anchorTop = anchor?.getBoundingClientRect().top;

    projectsPage.dataset.view = view;
    if (view === 'list' || view === 'explore') clearYearHashFromUrl();
    if (view === 'list') setListSort(readListSort());
    if (view === 'explore') yearSpy?.activateLatestVisibleYear();
    if (changingExplore) window.scrollTo(0, 0);
    if (view === 'explore') projectsPage.dispatchEvent(new Event('projectexploreenter'));
    viewButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.viewChoice === view));
    });
    syncViewHighlight();

    if (remember) {
      try {
        window.localStorage.setItem(
          mobileView.matches ? 'amjed-projects-view-mobile' : 'amjed-projects-view-desktop',
          view,
        );
      } catch {
        // The current choice still works without storage.
      }
    }

    if (anchor && anchorTop !== undefined) {
      window.requestAnimationFrame(() => {
        window.scrollBy(0, anchor.getBoundingClientRect().top - anchorTop);
        yearSpy?.requestActiveYearUpdate();
      });
    } else if (view === 'timeline') {
      syncYearHashAfterFilters();
    } else {
      yearSpy?.requestActiveYearUpdate();
    }
    if (projectsPage) dispatchListingViewChange(projectsPage);
    headerCollapse?.refreshSummary();
  };

  viewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const view = button.dataset.viewChoice;
      if ((view === 'timeline' || view === 'list' || view === 'explore') && view !== projectsPage?.dataset.view) {
        transitionListing(projectsPage, () => setView(view, true));
      }
    });
  });
  mobileView.addEventListener('change', () => setView(readView(), false, true));
  projectFilters.forEach((button) => {
    button.addEventListener('click', () => transitionListing(projectsPage, () => setProjectFilters(button.dataset.projectFilter ?? 'all', activePlatform, true)));
  });
  platformFilters.forEach((button) => {
    button.addEventListener('click', () => transitionListing(projectsPage, () => setProjectFilters(activeType, button.dataset.platformFilter ?? 'all', true)));
  });
  document.querySelector<HTMLButtonElement>('[data-clear-project-filter]')?.addEventListener('click', () => {
    focusListingRecovery(projectsPage, '[data-project-filter="all"]');
    transitionListing(projectsPage, () => setProjectFilters('all', 'all', true));
  });
  sortButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const direction = button.dataset.listSort;
      if (direction === 'asc' || direction === 'desc') {
        transitionListing(projectsPage, () => {
          setListSort(direction, true);
          headerCollapse?.refreshSummary();
        });
      }
    });
  });
  projectsPage?.addEventListener('projectexploreselectyear', () => headerCollapse?.refreshSummary());
  projectsPage?.addEventListener('listingyearchange', () => headerCollapse?.refreshSummary());
  window.addEventListener('popstate', () => {
    reconcileYearDeepLink();
    const params = new URLSearchParams(window.location.search);
    setProjectFilters(params.get('type') ?? 'all', params.get('platform') ?? 'all');
  });
  syncViewHighlight();
  syncSortHighlight();
  window.addEventListener('resize', () => {
    syncViewHighlight();
    syncSortHighlight();
    yearSpy?.syncYearHighlight();
  }, { passive: true });

  reconcileYearDeepLink();
  setListSort(readListSort());
  setProjectFilters(
    projectsPage?.dataset.filterType ?? 'all',
    projectsPage?.dataset.filterPlatform ?? 'all',
  );
</script>
