---
import ArticleToc from '../../components/ArticleToc.astro';
import Base from '../../layouts/Base.astro';
import ProgressiveImage from '../../components/ProgressiveImage.astro';
import { getCollection, render } from 'astro:content';
import { imagePlaceholders } from '../../data/image-placeholders';
import ProjectArticleMeta from '../../components/ProjectArticleMeta.astro';
import '../../styles/reading.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previousProject: projects[index - 1] ?? null,
      nextProject: projects[index + 1] ?? null,
    },
  }));
}

const { project, previousProject, nextProject } = Astro.props;
const { Content, headings } = await render(project);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<Base title={`${project.data.title} — Jedidiah Amaraegbu`} description={project.data.description}>
  <article class:list={['project-article', { 'project-article--with-toc': tocHeadings.length > 0 }]}>
    {!tocHeadings.length && <a href="/projects" class="back back-top"><span aria-hidden="true">&larr;</span> all projects</a>}
    {tocHeadings.length === 0 && (
      <header id="overview">
        <h1>{project.data.title}</h1>
        <p class="lead">{project.data.description}</p>
        <ProjectArticleMeta project={project} />
      </header>
    )}
    {/* TODO: finalize project figure preview */}
    {false && project.data.image && <figure class="project-figure">
      <ProgressiveImage src={project.data.image} alt={project.data.imageAlt ?? project.data.title} placeholder={imagePlaceholders[project.id]} sizes="(max-width: 916px) calc(100vw - 6rem), 820px" priority />
      {project.data.imageCaption && <figcaption>{project.data.imageCaption}</figcaption>}
    </figure>}
    <div class:list={['article-layout', { 'has-toc': tocHeadings.length > 0 }]}>
      {tocHeadings.length > 0 && (
        <div class="article-chrome">
          <div class="article-rail">
            <div id="overview" class="project-headline">
              <h1>{project.data.title}</h1>
              <p class="lead">{project.data.description}</p>
            </div>
            <div class="article-side-navigation">
              <a href="/projects" class="back back-rail"><span aria-hidden="true">&larr;</span> all projects</a>
              <div class="article-rail-aside">
                <ArticleToc headings={tocHeadings} />
              </div>
            </div>
          </div>
        </div>
      )}
      <div class="prose">
        {tocHeadings.length > 0 && <ProjectArticleMeta project={project} />}
        {project.body?.trim() ? <Content /> : (
          <div class="article-empty" role="status">
            <p>Project notes are not available yet.</p>
            <a href="/projects">Browse all projects</a>
          </div>
        )}
      </div>
    </div>
    <aside class="feedback-prompt" aria-label="Project feedback">
      <div>
        <h2>Have a thought on this project?</h2>
        <p>A question, suggestion, or detail I missed is welcome.</p>
      </div>
      <a href={`/feedback/${project.id}`}>Share feedback <span aria-hidden="true">&nearr;</span></a>
    </aside>
    {(previousProject || nextProject) && (
      <nav class="project-nav" aria-label="Project navigation">
        {previousProject ? (
          <a href={`/projects/${previousProject.id}`} class="prev-project">
            <span><span aria-hidden="true">&larr;</span> Previous project</span>
            <strong>{previousProject.data.title}</strong>
          </a>
        ) : <span></span>}
        {nextProject && (
          <a href={`/projects/${nextProject.id}`} class="next-project">
            <span>Next project <span aria-hidden="true">&rarr;</span></span>
            <strong>{nextProject.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .project-article { width: min(820px, calc(100vw - 2 * var(--gutter))); --project-muted: color-mix(in srgb, var(--dim) 65%, var(--fg)); }
  .project-article--with-toc { width: 100%; max-width: 980px; --article-scroll-offset: 30rem; }
  .project-article--with-toc .project-figure {
    width: min(820px, 100%);
    max-width: 820px;
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .back { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; color: var(--project-muted); font: .75rem/1.4 var(--font-mono); }
  .back span { display: inline-block; transition: transform .2s ease; }
  .back:hover { color: var(--accent); opacity: 1; }
  .back:hover span { transform: translateX(-3px); }
  .back-top { margin-bottom: 1.5rem; }
  header { margin-bottom: 2rem; }
  h1 { margin-bottom: .35em; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .lead { color: var(--project-muted); font: 400 1rem/1.7 var(--font-sans); max-width: 60ch; }
  .project-figure { margin: 0 0 2.5rem; }
  .project-figure :global(.progressive-image) { border: 1px solid var(--border); border-radius: 6px; }
  .project-figure figcaption { margin-top: .6rem; color: var(--project-muted); font-size: .75rem; line-height: 1.5; }
  .article-layout.has-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    grid-template-rows: auto 1fr;
    gap: 0 clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .project-headline {
    position: sticky;
    top: 3.5rem;
    padding-top: 1.25rem;
    z-index: 18;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .project-headline h1 {
    margin-bottom: .35em;
    font-size: clamp(1.45rem, 2.8vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .project-headline .lead {
    margin: 0;
    max-width: 60ch;
    color: var(--project-muted);
    font: 400 .92rem/1.65 var(--font-sans);
  }
  .back-rail {
    justify-self: end;
    align-self: start;
    position: sticky;
    top: 3.5rem;
    z-index: 21;
    margin-bottom: 0;
  }
  .article-rail-aside {
    position: sticky;
    top: 5rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 12rem;
    max-width: 100%;
    padding-top: 2.75rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: right;
  }
  .article-rail-aside :global(.article-toc) {
    width: 100%;
  }
  .article-rail-aside :global(.article-toc nav) {
    justify-items: end;
  }
  .article-layout.has-toc .prose { min-width: 0; }
  .prose { max-width: 68ch; min-width: 0; font: .95rem/1.8 var(--font-sans); color: var(--fg); }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(h2) {
    margin: 2em 0 .7em;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 1.2rem/1.3 var(--font-sans);
    letter-spacing: -.02em;
    text-transform: none;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin-bottom: 1.2em; }
  .prose :global(li) { margin-bottom: .35em; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { opacity: 1; text-decoration-thickness: 2px; }
  .feedback-prompt { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; width: 100%; margin-top: 3.25rem; padding: 1.25rem 0; }
  .feedback-prompt h2 { margin: 0 0 .25rem; padding: 0; border: 0; color: var(--fg); font: 600 .98rem/1.4 var(--font-sans); letter-spacing: -.01em; text-transform: none; }
  .feedback-prompt p { color: var(--project-muted); font-size: .8rem; line-height: 1.6; }
  .feedback-prompt a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; color: var(--accent); font: .77rem/1.4 var(--font-mono); white-space: nowrap; }
  .feedback-prompt a:hover { text-decoration: underline; text-underline-offset: .2em; opacity: 1; }
  .feedback-prompt + .project-nav { margin-top: 0; }
  .project-nav { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 1rem 2rem; width: 100%; margin-top: 3rem; padding: 1.25rem 0; border-top: 1px solid var(--border); }
  .prev-project,
  .next-project { display: flex; flex-direction: column; gap: .2rem; max-width: 20rem; color: inherit; }
  .prev-project { align-items: flex-start; text-align: left; }
  .next-project { align-items: flex-end; text-align: right; }
  .prev-project > span,
  .next-project > span { color: var(--project-muted); font: .7rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .prev-project strong,
  .next-project strong { color: var(--fg); font: 600 .95rem/1.35 var(--font-sans); transition: color .2s ease; }
  .prev-project:hover,
  .next-project:hover { opacity: 1; }
  .prev-project:hover strong,
  .next-project:hover strong { color: var(--accent); }
  @media (max-width: 800px) {
    .project-article--with-toc .project-figure {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
      padding-inline: var(--gutter);
      box-sizing: border-box;
    }
    .project-article--with-toc .project-figure :global(.progressive-image) { width: 100%; }
    .article-layout.has-toc { display: flex; flex-direction: column; gap: 0; }
    .article-rail {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .back-rail {
      order: 1;
      position: static;
      grid-column: auto;
      grid-row: auto;
      justify-self: auto;
      margin-bottom: .15rem;
    }
    .project-headline {
      order: 2;
      position: static;
      margin: 0;
      padding: 0 0 .35rem;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 0;
    }
    .project-headline h1 {
      margin: 0;
      font-size: clamp(1.05rem, 4.5vw, 1.25rem);
      line-height: 1.2;
    }
    .project-headline .lead { display: none; }
    .article-rail-aside {
      order: 3;
      position: static;
      width: 100%;
      padding-top: 0;
      max-height: none;
      overflow: visible;
      align-items: stretch;
      text-align: start;
    }
    .article-rail-aside :global(.article-toc nav) { justify-items: start; }
  }

  @media (max-width: 480px) {
    .project-nav { flex-direction: column; }
    .prev-project,
    .next-project { align-items: flex-start; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .back span { transition: none; } }
</style>

<script>
  import { decorateExternalProseLinks } from '../../lib/decorate-external-prose-links';
  import { enhanceArticleContent } from '../../lib/article-content';

  const run = () => {
    decorateExternalProseLinks();
    enhanceArticleContent();
  };
  document.addEventListener('astro:page-load', run);
  run();
</script>
