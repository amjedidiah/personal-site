---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { hashnodePosts } from '../../data/hashnode';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const archivePosts = [
    ...posts.map((post) => ({
      id: post.id,
      title: post.data.title,
      date: post.data.date,
      href: `/blog/${post.id}`,
      external: false,
    })),
    ...hashnodePosts.map((post) => ({
      id: post.slug,
      title: post.title,
      date: new Date(post.date),
      href: post.url,
      external: true,
    })),
  ].sort((a, b) => b.date.valueOf() - a.date.valueOf());

  return posts.map((post) => {
    const archiveIndex = archivePosts.findIndex((item) => item.id === post.id && !item.external);
    return {
      params: { id: post.id },
      props: {
        post,
        previous: archivePosts[archiveIndex + 1] ?? null,
        next: archivePosts[archiveIndex - 1] ?? null,
        related: posts
          .filter((candidate) => candidate.id !== post.id)
          .sort((a, b) => {
            const sharedA = (a.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag)).length;
            const sharedB = (b.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag)).length;
            return sharedB - sharedA || b.data.date.valueOf() - a.data.date.valueOf();
          })
          .slice(0, 2),
      },
    };
  });
}

const { post, previous, next, related } = Astro.props;
const { Content, headings } = await render(post);
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const articleDate = post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<Base title={`${post.data.title} — Jedidiah Amaraegbu`} description={post.data.description}>
  <article class="article-shell">
    <a href="/blog" class="back back-top"><span aria-hidden="true">&larr;</span> all writing</a>
    <header class="article-header sr">
      <div class="article-meta">
        <span>journal</span>
        <time datetime={post.data.date.toISOString()}>{articleDate}</time>
        <span>{readingMinutes} min read</span>
        {post.data.tags?.length > 0 && (
          <span class="article-tags">{post.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}</span>
        )}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lead">{post.data.description}</p>}
    </header>
    <div class="article-rule"></div>
    <div class:list={['article-layout', { 'has-toc': tocHeadings.length > 0 }]}>
      {tocHeadings.length > 0 && (
        <aside class="article-toc" aria-label="On this page">
          <p>On this page</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
    {(previous || next) && (
      <nav class="article-nav" aria-label="Post navigation">
        {previous ? (
          <a
            href={previous.href}
            class="article-nav-link article-nav-link--previous"
            target={previous.external ? '_blank' : undefined}
            rel={previous.external ? 'noopener noreferrer' : undefined}
          >
            <span>&larr; Older</span>
            <strong>{previous.title}{previous.external && <span class="visually-hidden"> (opens in a new tab)</span>}</strong>
          </a>
        ) : <span></span>}
        {next && (
          <a
            href={next.href}
            class="article-nav-link article-nav-link--next"
            target={next.external ? '_blank' : undefined}
            rel={next.external ? 'noopener noreferrer' : undefined}
          >
            <span>Newer &rarr;</span>
            <strong>{next.title}{next.external && <span class="visually-hidden"> (opens in a new tab)</span>}</strong>
          </a>
        )}
      </nav>
    )}
    {related.length > 0 && (
      <section class="related-posts" aria-labelledby="related-heading">
        <h2 id="related-heading">Keep reading</h2>
        <div class="related-list">
          {related.map((item) => (
            <a href={`/blog/${item.id}`} class="related-link">
              <span>{item.data.title}</span>
              <small>{item.data.description}</small>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .article-shell { max-width: 980px; --article-muted: color-mix(in srgb, var(--dim) 65%, var(--fg)); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    color: var(--article-muted);
    font: .75rem/1.4 var(--font-mono);
  }
  .back span { display: inline-block; transition: transform .2s ease; }
  .back:hover { color: var(--accent); opacity: 1; }
  .back:hover span { transform: translateX(-3px); }
  .back-top { margin-bottom: 1.8rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .article-header { max-width: 820px; }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .8rem;
    margin-bottom: 1rem;
    color: var(--article-muted);
    font: .7rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .article-tag {
    color: var(--accent);
    white-space: nowrap;
  }
  .article-tags { display: inline-flex; flex-wrap: wrap; gap: .35rem .8rem; }
  .article-tag::before { content: '#'; }
  .article-header h1 {
    margin-bottom: 1rem;
    color: var(--fg);
    font: 700 clamp(2.3rem, 5vw, 4.4rem)/1.02 var(--font-sans);
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .lead {
    max-width: 60ch;
    color: var(--article-muted);
    font: 1.05rem/1.7 var(--font-sans);
  }
  .article-rule {
    max-width: 820px;
    height: 1px;
    margin: 2rem 0 2.5rem;
    background: var(--accent);
    opacity: .7;
  }

  .article-layout.has-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .prose {
    max-width: 68ch;
    min-width: 0;
    color: var(--fg);
    font: .95rem/1.85 var(--font-sans);
  }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(h2) {
    margin: 2.4em 0 .7em;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 1.25rem/1.3 var(--font-sans);
    letter-spacing: -.02em;
    scroll-margin-top: 7rem;
  }
  .prose :global(h3) {
    margin: 1.7em 0 .45em;
    color: var(--fg);
    font: 600 1rem/1.3 var(--font-sans);
  }
  .prose :global(code) {
    padding: .15em .4em;
    border-radius: 3px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: .88em;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    position: relative;
    margin: 1.4rem 0;
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    font: .8rem/1.65 var(--font-mono);
  }
  .prose :global(pre code) { padding: 0; background: none; white-space: pre; overflow-wrap: normal; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  .prose :global(a:hover) { text-decoration-thickness: 2px; opacity: 1; }
  .prose :global(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin-bottom: 1.2em; }
  .prose :global(li) { margin-bottom: .35em; }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: .2rem 0 .2rem 1rem;
    border-inline-start: 1px solid var(--accent);
    color: var(--article-muted);
    font-style: italic;
  }
  .prose :global(img) { max-width: 100%; margin: 1.5rem 0; border-radius: 4px; }
  .prose :global(hr) { margin: 2.5rem 0; border: 0; border-top: 1px solid var(--border); }

  .article-toc {
    position: sticky;
    top: 5rem;
    grid-column: 2;
    grid-row: 1;
    padding-top: .2rem;
  }
  .article-toc > p {
    margin-bottom: .75rem;
    color: var(--article-muted);
    font: .68rem/1.4 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .article-toc nav { display: grid; gap: .5rem; }
  .article-toc a {
    display: inline-block;
    min-height: 32px;
    padding: .3rem 0;
    color: var(--article-muted);
    font: .72rem/1.4 var(--font-sans);
  }
  .article-toc a:hover { color: var(--accent); opacity: 1; }
  .article-layout.has-toc .prose { grid-column: 1; grid-row: 1; }

  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
  }
  .article-nav-link {
    display: grid;
    gap: .4rem;
    padding: 1rem 0;
    border-bottom: 1px solid transparent;
    color: var(--fg);
    transition: border-color .2s ease;
  }
  .article-nav-link:hover, .article-nav-link:focus-visible { border-color: var(--accent); opacity: 1; }
  .article-nav-link span {
    color: var(--article-muted);
    font: .68rem/1.3 var(--font-mono);
    text-transform: uppercase;
  }
  .article-nav-link strong { font: 600 .85rem/1.4 var(--font-sans); transition: color .2s ease; }
  .article-nav-link:hover strong, .article-nav-link:focus-visible strong { color: var(--accent); }
  .article-nav-link--next { text-align: right; }

  .related-posts {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .related-posts h2 {
    margin-bottom: 1rem;
    color: var(--article-muted);
    font: 500 .7rem/1.4 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .related-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .related-link {
    display: grid;
    gap: .35rem;
    padding-top: .75rem;
    border-top: 1px solid var(--border);
    color: var(--fg);
  }
  .related-link:hover, .related-link:focus-visible { border-color: var(--accent); color: var(--accent); opacity: 1; }
  .related-link span { font: 600 .85rem/1.4 var(--font-sans); }
  .related-link small { color: var(--article-muted); font: .72rem/1.5 var(--font-sans); }

  @media (max-width: 800px) {
    .article-layout.has-toc { display: flex; flex-direction: column; gap: 2rem; }
    .article-toc { position: static; width: 100%; padding: 1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .article-toc nav { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  }
  @media (max-width: 560px) {
    .article-header h1 { font-size: 2.3rem; }
    .article-meta { gap: .3rem .6rem; }
    .article-nav, .related-list { grid-template-columns: 1fr; }
    .article-nav-link--next { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .back span, .article-nav-link, .article-nav-link strong { transition: none; }
  }
</style>
