---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Jedidiah Amaraegbu`} description={post.data.description}>
  <article>
    <header>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
      </time>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lead">{post.data.description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    <a href="/blog" class="back">&larr; all posts</a>
  </article>
</Base>

<style>
  article { max-width: 600px; }
  header { margin-bottom: 2rem; }
  time { font-size: .7rem; color: var(--dim); opacity: .6; display: block; margin-bottom: .4em; }
  h1 { font-size: 1.4rem; margin-bottom: .3em; }
  .lead { color: var(--dim); font-size: .85rem; line-height: 1.6; }

  .prose { font-size: .85rem; line-height: 1.8; color: var(--fg); }
  .prose :global(p) { margin-bottom: 1em; }
  .prose :global(h2) {
    font-size: .95rem; font-weight: 600; text-transform: none;
    letter-spacing: normal; border: none; padding: 0;
    margin: 2em 0 .6em; color: var(--fg);
  }
  .prose :global(h3) { font-size: .85rem; font-weight: 600; margin: 1.5em 0 .4em; color: var(--fg); }
  .prose :global(code) {
    font-family: inherit; background: var(--surface); padding: .15em .4em;
    border-radius: 3px; font-size: .9em;
  }
  .prose :global(pre) {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 6px; padding: 1em 1.2em; overflow-x: auto;
    margin: 1em 0; font-size: .8rem; line-height: 1.6;
  }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin-bottom: 1em; }
  .prose :global(li) { margin-bottom: .3em; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--border); padding-left: 1em;
    color: var(--dim); margin: 1em 0; font-style: italic;
  }
  .prose :global(img) { max-width: 100%; border-radius: 6px; margin: 1em 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2em 0; }

  .back { display: inline-block; margin-top: 2rem; font-size: .8rem; color: var(--dim); }
  .back:hover { color: var(--accent); }

  @media (min-width: 640px) { h1 { font-size: 1.6rem; } }
</style>
