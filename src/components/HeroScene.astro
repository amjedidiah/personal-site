---
import { Image } from 'astro:assets';
import portrait from '../assets/me.webp';
import ProductionFlow from './ProductionFlow.astro';

const portraitTrace = 'M4 82V4H82M398 4H476V82M476 398V476H398M82 476H4V398';

const portraitImage = {
  src: portrait,
  widths: [320, 480, 640, 960, 1254],
  sizes: '(max-width: 760px) min(calc(100vw - 2rem), 22rem), min(42vw, 30rem)',
  format: 'webp' as const,
  quality: 88,
};
---

<div class="hero-artwork">
<div class="hero-visual">
  <Image
    {...portraitImage}
    class="hero-portrait hero-portrait--base"
    alt="Jedidiah Amaraegbu"
    priority
  />
  <Image
    {...portraitImage}
    class="hero-portrait hero-portrait--color"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
  />
  <svg class="portrait-trace" viewBox="0 0 480 480" fill="none" aria-hidden="true">
    <path class="portrait-trace-track" d={portraitTrace} />
    <path class="portrait-trace-ink" pathLength="100" d={portraitTrace} />
  </svg>
</div>
<ProductionFlow />
</div>

<style>
  .hero-artwork {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
    width: min(100%, clamp(17rem, 42vw, 30rem), 74svh);
    align-self: center;
    justify-self: end;
  }
  .hero-visual { position: relative; isolation: isolate; overflow: clip; border-radius: 2px; padding: .7rem; }
  .portrait-trace { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .portrait-trace-track { stroke: var(--border); stroke-width: 1; }
  .portrait-trace-ink { stroke: var(--accent); stroke-width: 1.5; }
  .hero-portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 2px;
  }
  .hero-portrait--base {
    filter: grayscale(1);
    transition: filter .45s cubic-bezier(.2, .7, .2, 1);
  }
  .hero-portrait--color {
    position: absolute;
    inset: .7rem;
    width: calc(100% - 1.4rem);
    height: calc(100% - 1.4rem);
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
  }

  @keyframes portrait-color-reveal {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0); }
  }
  @keyframes portrait-trace-reveal {
    from { stroke-dasharray: 0 100; }
    to { stroke-dasharray: 100 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll(root block)) and (animation-range: entry) and (animation-range: 0px 280px) {
      .hero-portrait--color {
        animation: var(--portrait-animation, portrait-color-reveal linear both);
        animation-timeline: scroll(root block);
        animation-range: 0px 280px;
      }
      .portrait-trace-ink {
        animation: var(--portrait-trace-animation, portrait-trace-reveal linear both);
        animation-timeline: scroll(root block);
        animation-range: 0px 280px;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-visual:hover .hero-portrait--base { filter: grayscale(0); }
  }

  @media (max-width: 760px) {
    .hero-artwork {
      grid-column: 1;
      grid-row: 2;
      width: min(100%, 22rem);
      margin-top: .25rem;
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait--base { transition: none; }
  }
</style>
