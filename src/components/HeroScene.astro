---
import { Image } from 'astro:assets';
import portrait from '../assets/me.webp';
---

<div class="hero-visual">
  <Image
    class="hero-portrait"
    src={portrait}
    alt="Jedidiah Amaraegbu"
    widths={[320, 480, 640, 960, 1254]}
    sizes="(max-width: 760px) min(calc(100vw - 2rem), 22rem), min(42vw, 30rem)"
    format="webp"
    quality={88}
    priority
  />
</div>

<style>
  .hero-visual {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
    width: min(100%, clamp(17rem, 42vw, 30rem), 74svh);
    align-self: center;
    justify-self: end;
  }
  .hero-portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 2px;
    filter: grayscale(1);
    transition: filter .45s cubic-bezier(.2, .7, .2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-portrait:hover { filter: grayscale(0); }
  }

  @media (max-width: 760px) {
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: min(100%, 22rem);
      margin-top: .25rem;
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait { transition: none; }
  }
</style>
