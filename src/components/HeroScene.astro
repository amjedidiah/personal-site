---
import PortraitScene from './PortraitScene.astro';
interface Props {
  modelSrc?: string;
  fallbackSrc?: string;
  /** Degrees around vertical axis; export front-facing toward glTF +Z for 0. */
  modelYaw?: number;
  initialMode?: 0 | 1 | 2;
}
const {
  modelSrc = `${import.meta.env.BASE_URL}models/jedidiah-bust.glb`,
  fallbackSrc = `${import.meta.env.BASE_URL}hero-portrait.webp`,
  modelYaw = 0,
  initialMode = 0,
} = Astro.props;
---
<div class="hero-visual" data-hero-scene data-volumetric-hero data-model-src={modelSrc}
  data-model-yaw={modelYaw} data-mode={initialMode} data-portrait-status="loading" aria-hidden="true">
  <PortraitScene fallbackSrc={fallbackSrc} />
  <div class="system-map-labels">
    <span class="system-map-label production">production</span>
    <span class="system-map-label payments">payments</span>
    <span class="system-map-label ai">AI</span>
    <span class="system-map-label security">security</span>
  </div>
</div>
<style>
  .hero-visual {
    position: absolute; inset-block: 0; inset-inline-start: 50%; inline-size: 100vw;
    transform: translateX(-50%);
    overflow: hidden;
    pointer-events: none;
    color: var(--accent);
    z-index: 0;
  }
  .system-map-labels {
    position: absolute;
    inset: 0;
    color: var(--dim, #8193a7);
    font: .65rem/1 var(--font-mono, monospace);
    letter-spacing: .08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .system-map-label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    white-space: nowrap;
  }
  .system-map-label::before {
    content: '';
    inline-size: .35rem;
    block-size: .35rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .production { inset-inline-start: 65%; inset-block-start: 37%; color: var(--fg, #dfebfa); }
  .payments { inset-inline-start: 61%; inset-block-start: 67%; color: var(--accent, #58a6ff); }
  .ai { inset-inline-start: 85%; inset-block-start: 29%; color: #61d6bb; }
  .security { inset-inline-start: 86%; inset-block-start: 67%; color: #b494e8; }
  :global(:root[data-theme="light"]) .ai { color: #237864; }
  :global(:root[data-theme="light"]) .security { color: #73509f; }
  @media (max-width: 960px) {
    .system-map-labels { display: none; }
  }
  @media (max-width: 760px) {
    .hero-visual { opacity: var(--portrait-mobile-opacity, .24); }
  }
</style>
<script>
  import '../lib/portrait/bootstrap';
</script>
