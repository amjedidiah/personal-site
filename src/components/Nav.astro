---
import { FileText, House, LayoutGrid, Mail, MessageCircle, Phone, PhoneCall, UserRound } from '@lucide/astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'portfolio' },
  { href: '/blog', label: 'blog' },
  { href: '/about', label: 'about' },
];
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
const brandLetters = ['a', 'm', 'j', 'e', 'd'];
---

<header class="mobile-topbar">
  <a href="/" class="mobile-brand" aria-label="amjed, home">
    <span class="brand-wordmark" aria-hidden="true">
      {brandLetters.map((letter, index) => (
        <span class:list={['brand-letter', { 'brand-letter--am': index < 2 }]}>{letter}</span>
      ))}
    </span>
  </a>
  <div class="mobile-social" role="group" aria-label="Social and contact links">
    <a href="https://github.com/amjedidiah" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
