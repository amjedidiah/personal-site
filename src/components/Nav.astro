---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'projects' },
  { href: '/blog', label: 'blog' },
  { href: '/about', label: 'about' },
];
---

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-name">jed</a>
    <div class="nav-links">
      {links.map(({ href, label }) => (
        <a href={href} class:list={[{ active: pathname === href || (href !== '/' && pathname.startsWith(href)) }]}>{label}</a>
      ))}
    </div>
    <div class="nav-social">
      <a href="https://github.com/amjedidiah" target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.73.084-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/amjedidiah" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V8.999h3.414v1.561h.046c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.266 2.37 4.266 5.455v6.287zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V8.999h3.564v11.453zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
        </svg>
      </a>
      <a href="https://twitter.com/amjedidiah" target="_blank" rel="noopener" aria-label="Twitter">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.967 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--bg); border-bottom: 1px solid var(--border);
    padding: 0 16px;
  }
  .nav-inner {
    max-width: 680px; margin: 0 auto;
    display: flex; align-items: center; gap: 1.5rem;
    height: 3rem;
  }
  .nav-name {
    font-weight: 700; font-size: .9rem; color: var(--fg);
    margin-right: auto; letter-spacing: -.02em;
  }
  .nav-name:hover { opacity: 1; color: var(--accent); }
  .nav-links { display: flex; gap: .1rem; }
  .nav-links a, .nav-social a {
    font-size: .75rem; color: var(--dim);
    padding: .3em .55em; border-radius: 4px;
    transition: color .15s, background .15s;
  }
  .nav-social a {
    display: grid; place-items: center;
    width: 28px; height: 28px;
    padding: 0;
  }
  .nav-social svg { width: 15px; height: 15px; fill: currentColor; }
  .nav-links a:hover, .nav-social a:hover {
    color: var(--fg); background: var(--surface); opacity: 1;
  }
  .nav-links a.active { color: var(--accent); background: var(--glow); }
  .nav-social { display: flex; gap: .1rem; border-left: 1px solid var(--border); padding-left: .8rem; margin-left: .4rem; }

  @media (min-width: 640px) { nav { padding: 0 24px; } }
  @media (min-width: 960px) { nav { padding: 0 48px; } }
  @media (max-width: 400px) {
    .nav-inner { gap: .8rem; }
    .nav-links a, .nav-social a { font-size: .7rem; padding: .25em .4em; }
    .nav-social { padding-left: .5rem; margin-left: .2rem; }
  }
</style>
