---
import '../styles/listing-filter-sheet.css';
import { useTranslations } from '../i18n/ui';

interface Props { resultLabel: string; }
const { resultLabel } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<dialog id="listing-filter-sheet" class="listing-filter-sheet" data-listing-filter-sheet aria-labelledby="listing-filter-sheet-title">
  <header class="listing-filter-sheet-header">
    <h2 id="listing-filter-sheet-title">{t.listing.filters}</h2>
    <button type="button" class="listing-filter-sheet-close" data-filter-sheet-close autofocus>{t.listing.close}</button>
  </header>
  <div class="listing-filter-sheet-body" data-filter-sheet-body>
    <div data-filter-sheet-filters></div>
    <div data-filter-sheet-sort></div>
  </div>
  <footer class="listing-filter-sheet-footer">
    <button type="button" class="listing-filter-sheet-clear" data-filter-sheet-clear>{t.listing.clearFilters}</button>
    <button type="button" class="listing-filter-sheet-show" data-filter-sheet-close data-filter-sheet-results>{t.listing.showResults(resultLabel)}</button>
  </footer>
</dialog>
