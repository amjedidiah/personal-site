---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  placeholder: string;
  sizes: string;
  priority?: boolean;
}

const { src, alt, placeholder, sizes, priority = false } = Astro.props;
---

<div
  class="progressive-image"
  data-progressive-image
  style={`--image-ratio: ${src.width} / ${src.height}; background-image: url('${placeholder}')`}
>
  <Image
    src={src}
    alt={alt}
    widths={[320, 640, 960, 1280, 1600]}
    sizes={sizes}
    format="webp"
    quality={88}
    priority={priority}
    fetchpriority={priority ? 'high' : 'low'}
  />
  <span class="image-error" aria-hidden="true">Image unavailable</span>
</div>

<style>
  .progressive-image {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--image-ratio);
    overflow: hidden;
    background-color: var(--surface);
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
  }
  .progressive-image :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity .28s ease;
  }
  .progressive-image.is-loading :global(img) { opacity: 0; }
  .progressive-image.has-error :global(img) { opacity: 0; }
  .image-error {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    font-size: .75rem;
  }
  .progressive-image.has-error .image-error { display: flex; }
  @media (prefers-reduced-motion: reduce) {
    .progressive-image :global(img) { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-progressive-image]').forEach((frame) => {
    if (frame.dataset.bound) return;
    frame.dataset.bound = 'true';
    const image = frame.querySelector('img');
    if (!image) return;

    frame.classList.add('is-loading');
    const reveal = async () => {
      if (image.naturalWidth && 'decode' in image) {
        try { await image.decode(); } catch { /* The loaded pixels are still usable. */ }
      }
      frame.classList.remove('is-loading');
    };

    const showError = () => {
      frame.classList.add('has-error');
      frame.classList.remove('is-loading');
    };

    image.addEventListener('load', reveal, { once: true });
    image.addEventListener('error', showError, { once: true });
    if (image.complete) {
      if (image.naturalWidth) reveal();
      else showError();
    }
  });
</script>
