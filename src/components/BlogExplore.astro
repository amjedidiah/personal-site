---
import ListingExplore, { type ListingExplorePaper } from './ListingExplore.astro';
import type { ListingExploreWire } from '../lib/listing-explore';
import { intlLocale, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Post {
  title: string;
  description: string;
  date: Date;
  href: string;
  external: boolean;
  lang?: string;
  categories: string[];
}

interface Props {
  groups: [number, Post[]][];
}

const { groups } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const copy = t.blog.explore;

const papers: ListingExplorePaper[] = groups.flatMap(([year, posts]) =>
  posts.map((post) => ({
    title: post.title,
    description: post.description,
    href: post.href,
    cardMetaA: String(year),
    cardMetaB: post.external ? 'HASHNODE' : t.blog.journal.toUpperCase(),
    detailMetaA: post.date.toLocaleDateString(intlLocale[locale], { day: '2-digit', month: 'short', year: 'numeric' }),
    detailMetaB: post.external ? t.blog.externalSource : t.blog.journal,
    metaLine: post.date.toLocaleDateString(intlLocale[locale], { day: '2-digit', month: 'short' }),
    exploreJump: String(year),
    external: post.external,
    lang: post.lang,
    filterAttrs: {
      'data-blog-post': '',
      'data-post-href': post.href,
      'data-categories': post.categories.join(' '),
      'data-year': String(year),
    },
  })),
);

const wire: ListingExploreWire = {
  listingRoot: '.blog-view',
  eventEnter: 'blogexploreenter',
  eventFilter: 'blogcategorychange',
  eventJump: 'blogexploreyear',
  eventSelectJump: 'blogexploreselectyear',
  itemNoun: 'paper',
  selectedLabel: copy.selected,
  previewLabel: copy.preview,
  readLabel: t.listing.readArticle,
  fallbackHref: '#blog-archive-timeline',
  emptyTitle: copy.emptyTitle,
  emptyDescription: copy.emptyDescription,
  previewNote: copy.previewNote,
};
---

<ListingExplore
  exploreId="blog-explore-globe"
  ariaLabel={copy.label}
  stageAriaLabel={copy.stage}
  hintDesktop={copy.hintDesktop}
  hintMobile={copy.hintMobile}
  keyboardHint={copy.keyboard}
  selectedAsideLabel="selected-paper"
  papers={papers}
  wire={wire}
/>
