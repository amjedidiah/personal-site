---
import ListingExplore, { type ListingExplorePaper } from './ListingExplore.astro';
import type { ListingExploreWire } from '../lib/listing-explore';

interface Post {
  title: string;
  description: string;
  date: Date;
  href: string;
  external: boolean;
  categories: string[];
}

interface Props {
  groups: [number, Post[]][];
}

const { groups } = Astro.props;

const papers: ListingExplorePaper[] = groups.flatMap(([year, posts]) =>
  posts.map((post) => ({
    title: post.title,
    description: post.description,
    href: post.href,
    cardMetaA: String(year),
    cardMetaB: post.external ? 'HASHNODE' : 'JOURNAL',
    detailMetaA: post.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
    detailMetaB: post.external ? 'Hashnode' : 'Journal',
    metaLine: post.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }),
    exploreJump: String(year),
    external: post.external,
    filterAttrs: {
      'data-blog-post': '',
      'data-post-href': post.href,
      'data-categories': post.categories.join(' '),
      'data-year': String(year),
    },
  })),
);

const wire: ListingExploreWire = {
  listingRoot: '.blog-view',
  eventEnter: 'blogexploreenter',
  eventFilter: 'blogcategorychange',
  eventJump: 'blogexploreyear',
  eventSelectJump: 'blogexploreselectyear',
  itemNoun: 'paper',
  readLabel: 'Read article',
  fallbackHref: '#blog-archive-timeline',
  emptyTitle: 'No papers in this category',
  emptyDescription: 'Choose another category to keep exploring.',
  previewNote: 'Click the paper to select it',
};
---

<ListingExplore
  exploreId="blog-explore-globe"
  ariaLabel="Explore blog posts"
  stageAriaLabel="Paper globe. Use left and right arrows to browse papers, up and down arrows to tilt. Tab reaches Reset globe, then Read article."
  hintDesktop="drag to turn · click to select"
  hintMobile="swipe to turn · tap a paper"
  keyboardHint="With the globe focused, use left and right arrows to browse papers. Tab reaches Reset globe, then Read article."
  selectedAsideLabel="selected-paper"
  papers={papers}
  wire={wire}
/>
