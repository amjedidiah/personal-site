---
import { SunMoon } from '@lucide/astro';
---

<details class="theme-control" data-theme-control>
  <summary aria-label="Color theme">
    <SunMoon size={17} stroke-width={2} aria-hidden="true" />
  </summary>
  <div class="theme-options" role="group" aria-label="Color theme options">
    <button type="button" data-theme-option="system" aria-pressed="false">System</button>
    <button type="button" data-theme-option="light" aria-pressed="false">Light</button>
    <button type="button" data-theme-option="dark" aria-pressed="false">Dark</button>
  </div>
</details>

<style>
  .theme-control {
    position: relative;
    display: block;
  }
  .theme-control summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--dim);
    border-radius: 4px;
    cursor: pointer;
    list-style: none;
    transition: color .15s;
    touch-action: manipulation;
  }
  .theme-control summary::-webkit-details-marker { display: none; }
  .theme-control summary::marker { content: ''; }
  .theme-control summary:hover,
  .theme-control[open] summary {
    color: var(--fg);
  }
  .theme-control summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .theme-options {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 2;
    display: grid;
    min-width: 8rem;
    padding: .3rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    box-shadow:
      -1px -1px 0 var(--imprint-highlight),
      1px 1px 0 var(--imprint-shadow),
      0 12px 28px rgb(0 0 0 / .14);
    transform-origin: top right;
  }
  .theme-control[open] .theme-options {
    animation: theme-menu-in .22s cubic-bezier(.16, 1, .3, 1) both;
  }
  .theme-control[open][data-closing] .theme-options {
    animation: theme-menu-out .18s cubic-bezier(.7, 0, .84, 0) both;
  }
  .theme-options button {
    min-height: 36px;
    padding: .35rem .6rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--dim);
    font: 500 .75rem/1.2 var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .theme-control[open]:not([data-closing]) .theme-options button {
    animation: theme-option-in .2s cubic-bezier(.16, 1, .3, 1) both;
  }
  .theme-control[open]:not([data-closing]) .theme-options button:nth-child(2) {
    animation-delay: 30ms;
  }
  .theme-control[open]:not([data-closing]) .theme-options button:nth-child(3) {
    animation-delay: 60ms;
  }
  .theme-options button:hover,
  .theme-options button[aria-pressed="true"] {
    background: transparent;
    color: var(--accent);
  }
  .theme-options button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-control summary { transition: none; }
    .theme-control[open] .theme-options,
    .theme-control[open][data-closing] .theme-options,
    .theme-control[open]:not([data-closing]) .theme-options button {
      animation: none;
    }
  }

  @media (max-width: 639px) {
    .theme-control summary {
      width: 44px;
      height: 44px;
    }
  }

  @keyframes theme-menu-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 24% 0 round 6px);
      transform: translateY(-4px) scaleY(.78);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 6px);
      transform: translateY(0) scaleY(1);
    }
  }
  @keyframes theme-menu-out {
    from {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 6px);
      transform: translateY(0) scaleY(1);
    }
    to {
      opacity: 0;
      clip-path: inset(0 0 24% 0 round 6px);
      transform: translateY(-4px) scaleY(.78);
    }
  }
  @keyframes theme-option-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
