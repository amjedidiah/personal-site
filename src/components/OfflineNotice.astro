---
import { RotateCw, X } from '@lucide/astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
---

<div
  class="cached-notice"
  id="cached-notice"
  data-cached-notice
  data-state="offline"
  role="region"
  aria-label={t.offline.region}
  hidden
>
  <div class="cached-notice-inner">
    <span class="cached-notice-dot" aria-hidden="true"></span>
    <p class="cached-notice-text" data-cached-notice-text>{t.offline.savedCopy}</p>
    <button class="cached-notice-action" type="button" data-cached-notice-reload hidden>
      <RotateCw size={13} aria-hidden="true" />
      <span>{t.offline.loadLatest}</span>
    </button>
    <button class="cached-notice-dismiss" type="button" data-cached-notice-dismiss aria-label={t.offline.dismiss}>
      <X size={14} aria-hidden="true" />
    </button>
  </div>
</div>
<p class="cached-notice-live" role="status" data-cached-notice-live></p>

<script>
  // The service worker adds data-cached-copy to <html> when it serves a page from
  // cache. This script drives the notice and the status dot beside the wordmark
  // (FreshnessDot in the nav), which stays visible for as long as the page is a saved copy.
  import { clientStrings } from '../i18n/client';

  type State = 'offline' | 'online';

  const DISMISSED_KEY = 'amjed-cached-notice-dismissed';
  const PROBE_INTERVAL_MS = 15000;
  const COPY: Record<State, { text: string; tip: string; announce: string }> = clientStrings().offline;

  const session = (() => {
    try {
      return window.sessionStorage;
    } catch {
      return null;
    }
  })();

  const setDismissed = (dismissed: boolean) => {
    try {
      if (dismissed) session?.setItem(DISMISSED_KEY, '1');
      else session?.removeItem(DISMISSED_KEY);
    } catch {
      // Storage can be unavailable; the notice just reappears on the next saved page.
    }
  };

  const isDismissed = () => {
    try {
      return session?.getItem(DISMISSED_KEY) === '1';
    } catch {
      return false;
    }
  };

  const notice = document.querySelector<HTMLElement>('[data-cached-notice]');

  if (!document.documentElement.hasAttribute('data-cached-copy')) {
    // Fresh page: the next offline episode should start with the notice again.
    setDismissed(false);
  } else if (notice) {
    const text = notice.querySelector('[data-cached-notice-text]')!;
    const reload = notice.querySelector<HTMLButtonElement>('[data-cached-notice-reload]')!;
    const live = document.querySelector('[data-cached-notice-live]')!;
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-freshness-dot]'));

    let state: State = 'offline';

    const setState = (next: State) => {
      state = next;
      const copy = COPY[next];
      notice.dataset.state = next;
      text.textContent = copy.text;
      reload.hidden = next !== 'online';
      dots.forEach((dot) => {
        dot.dataset.state = next;
        dot.querySelector('[data-freshness-dot-tip]')!.textContent = copy.tip;
      });
      live.textContent = copy.announce;
    };

    const dismissNotice = () => {
      if (notice.hidden) return;
      const hadFocus = notice.contains(document.activeElement);
      notice.hidden = true;
      setDismissed(true);
      if (hadFocus) {
        const nextLink = document.querySelector<HTMLAnchorElement>(window.matchMedia('(max-width: 639px)').matches ? '.mobile-brand' : '.nav-name');
        nextLink?.focus({ preventScroll: true });
      }
    };

    // `online` only fires when the device reconnects, not when a down server comes
    // back, so also probe the page itself. HEAD requests bypass the service worker.
    let probeTimer = 0;
    const scheduleProbe = () => {
      window.clearTimeout(probeTimer);
      if (document.visibilityState === 'visible') probeTimer = window.setTimeout(probe, PROBE_INTERVAL_MS);
    };
    const probe = async () => {
      window.clearTimeout(probeTimer);
      if (state === 'online') return;
      try {
        const response = await fetch(window.location.href, { method: 'HEAD', cache: 'no-store' });
        if (response.ok) {
          setState('online');
          // Bring the notice back even if dismissed: it now has an action to offer.
          notice.hidden = false;
          return;
        }
      } catch {
        // Still unreachable.
      }
      scheduleProbe();
    };

    setState('offline');
    dots.forEach((dot) => { dot.hidden = false; });
    notice.hidden = isDismissed();
    scheduleProbe();

    reload.addEventListener('click', () => window.location.reload());
    notice.querySelector('[data-cached-notice-dismiss]')!.addEventListener('click', dismissNotice);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dismissNotice();
    });
    window.addEventListener('online', probe);
    window.addEventListener('offline', () => {
      setState('offline');
      scheduleProbe();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') probe();
    });
  }
</script>

<style>
  .cached-notice {
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    font: 500 .9rem/1.4 var(--font-sans);
  }

  .cached-notice-inner {
    width: min(100%, var(--max-w));
    min-height: 46px;
    margin-inline: auto;
    padding: .25rem var(--gutter);
    display: flex;
    align-items: center;
    gap: .6rem;
  }

  .cached-notice[hidden] {
    display: none;
  }

  .cached-notice-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dim);
  }

  .cached-notice[data-state='online'] .cached-notice-dot {
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .cached-notice-text {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
  }

  .cached-notice button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-height: 32px;
    border-radius: 6px;
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }

  .cached-notice-action {
    gap: .4rem;
    padding: 0 .75rem;
    border: 1px solid color-mix(in srgb, var(--border) 65%, var(--fg));
    background: transparent;
    color: var(--fg);
  }

  .cached-notice-action:hover {
    border-color: var(--fg);
  }

  .cached-notice[data-state='online'] .cached-notice-action {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .cached-notice button[hidden] {
    display: none;
  }

  .cached-notice-dismiss {
    width: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--dim);
  }

  .cached-notice-dismiss:hover {
    color: var(--fg);
  }

  .cached-notice button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    .cached-notice-inner {
      gap: .5rem;
      min-height: 52px;
      padding-block: .3rem;
    }

    .cached-notice button {
      min-height: 40px;
    }

    .cached-notice-dismiss {
      width: 40px;
    }
  }

  .cached-notice-live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

</style>
