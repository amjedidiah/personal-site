---
import { localePath, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <span class="copyright">&copy; {year} Jedidiah Amaraegbu</span>
    <div class="footer-meta">
      <span>{t.footer.location}</span>
      <span>&middot;</span>
      <span>{t.footer.remote}</span>
      <span class="feedback-link"><span aria-hidden="true">&middot;</span><a href={localePath(locale, '/feedback')}>{t.footer.feedback}</a></span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    color: color-mix(in srgb, var(--dim) 80%, var(--fg)); font-size: .75rem;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: .75rem 1.5rem;
  }
  .footer-meta {
    order: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: .3em .8em;
  }
  .copyright {
    order: 2;
    margin-inline-start: auto;
  }
  .footer-meta a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  .footer-meta a:hover { color: var(--accent); opacity: 1; }
  .feedback-link { display: inline-flex; align-items: center; gap: .8em; white-space: nowrap; }

  @media (max-width: 639px) {
    .footer-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer-meta { justify-content: center; }
    .copyright { margin-inline-start: 0; }
  }
</style>
