{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --experimental-strip-types scripts/generate-profile-assets.mjs && node scripts/generate-lqip.mjs && node scripts/french-spacing.mjs",
    "build": "astro build",
    "images:lqip": "node scripts/generate-lqip.mjs",
    "i18n:spacing": "node scripts/french-spacing.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astro-community/astro-embed-link-preview": "^0.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.15",
    "@lucide/astro": "^1.52.0",
    "astro": "^7.3.6",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "satori": "0.62.0",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
